<!-- E7 教师样板：Vista Aero 标题栏与窗口按钮（Avalonia 12.1.3，自包含 ResourceDictionary）。
     这是可编译样板，不是生产文件；生产落点见 docs/design/skin-teacher-reference.md §6。
     内容：
       1) ThemeDictionaries（Light/Dark）里的 AeroCaption* 画刷——全部具体值，不用 StaticResource 别名，
          避免 S1-2 指出的“别名在运行时不刷新”问题；模板一律 DynamicResource 引用。
       2) ControlTheme AeroCaptionButtonTheme（TargetType=Button）：命中区固定 46×32（与生产 CaptionAssetButton 相同），
          视觉板 21px 吊在顶部；类 min / max / restore / close 决定图形与圆角。
     不包含：caption 背景与 inactive 规则——那是“作用域样式”，在 AeroCaption.Styles.axaml。 -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <!-- ============ 亮 ============ -->
    <ResourceDictionary x:Key="Light">
      <!-- 标题栏：50% 处硬切（两个 stop 同 offset）= Vista 玻璃反光；这是无模糊也能工作的实色版本 -->
      <LinearGradientBrush x:Key="AeroCaptionBackground" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#DDEBF9"/>
        <GradientStop Offset="0.46" Color="#BFD6F0"/>
        <GradientStop Offset="0.5" Color="#A3C3E8"/>
        <GradientStop Offset="1" Color="#B4CEEC"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AeroCaptionBackgroundInactive" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#F0F3F6"/>
        <GradientStop Offset="0.48" Color="#E3E8EE"/>
        <GradientStop Offset="0.5" Color="#D8DFE7"/>
        <GradientStop Offset="1" Color="#DFE5EC"/>
      </LinearGradientBrush>
      <!-- 仅在 ActualTransparencyLevel 为 Blur/AcrylicBlur/Mica 时替换 AeroCaptionBackground（同 MicaOverrides 机制） -->
      <LinearGradientBrush x:Key="AeroCaptionGlass" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#B8E8F2FC"/>
        <GradientStop Offset="0.46" Color="#99C8DEF4"/>
        <GradientStop Offset="0.5" Color="#8CAACAEC"/>
        <GradientStop Offset="1" Color="#9EBED6F0"/>
      </LinearGradientBrush>
      <SolidColorBrush x:Key="AeroCaptionTopHighlight" Color="#8CFFFFFF"/>
      <SolidColorBrush x:Key="AeroCaptionRule" Color="#8FA9C6"/>
      <SolidColorBrush x:Key="AeroCaptionText" Color="#10233A"/>
      <SolidColorBrush x:Key="AeroCaptionTextInactive" Color="#4F5B6A"/>
      <Color x:Key="AeroCaptionTextGlowColor">#F2FFFFFF</Color>

      <LinearGradientBrush x:Key="AeroCaptionPlate" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#D5E3F1"/>
        <GradientStop Offset="0.49" Color="#B5CAE0"/>
        <GradientStop Offset="0.5" Color="#9DB6D1"/>
        <GradientStop Offset="1" Color="#B4C9DF"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AeroCaptionPlateHover" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#B7E0FA"/>
        <GradientStop Offset="0.49" Color="#69B6EA"/>
        <GradientStop Offset="0.5" Color="#2E86C9"/>
        <GradientStop Offset="1" Color="#63BDF0"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AeroCaptionPlatePressed" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#5A9ACB"/>
        <GradientStop Offset="0.49" Color="#2D6EA6"/>
        <GradientStop Offset="0.5" Color="#154E80"/>
        <GradientStop Offset="1" Color="#2A6AA0"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AeroCaptionClose" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#ECA996"/>
        <GradientStop Offset="0.49" Color="#DA7A62"/>
        <GradientStop Offset="0.5" Color="#C4462D"/>
        <GradientStop Offset="1" Color="#D0694E"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AeroCaptionCloseHover" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FBC0AE"/>
        <GradientStop Offset="0.49" Color="#F06E4E"/>
        <GradientStop Offset="0.5" Color="#E0391B"/>
        <GradientStop Offset="1" Color="#F7845F"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AeroCaptionClosePressed" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#C2583E"/>
        <GradientStop Offset="0.49" Color="#A33A20"/>
        <GradientStop Offset="0.5" Color="#85220C"/>
        <GradientStop Offset="1" Color="#9B331A"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AeroCaptionPlateInactive" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#E9EDF1"/>
        <GradientStop Offset="0.49" Color="#DADFE5"/>
        <GradientStop Offset="0.5" Color="#CDD3DA"/>
        <GradientStop Offset="1" Color="#D7DCE2"/>
      </LinearGradientBrush>
      <SolidColorBrush x:Key="AeroCaptionPlateBorder" Color="#9E1C304C"/>
      <SolidColorBrush x:Key="AeroCaptionPlateHighlight" Color="#59FFFFFF"/>
      <SolidColorBrush x:Key="AeroCaptionGlyph" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="AeroCaptionGlyphHalo" Color="#B3000000"/>
      <SolidColorBrush x:Key="AeroCaptionGlyphInactive" Color="#7C8794"/>
      <SolidColorBrush x:Key="AeroCaptionFocusRing" Color="#39A0E6"/>
    </ResourceDictionary>

    <!-- ============ 暗（Aero Night：Vista 无官方暗色，本样板自定，须用户确认） ============ -->
    <ResourceDictionary x:Key="Dark">
      <LinearGradientBrush x:Key="AeroCaptionBackground" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#3A4B60"/>
        <GradientStop Offset="0.46" Color="#2A394B"/>
        <GradientStop Offset="0.5" Color="#1B2634"/>
        <GradientStop Offset="1" Color="#223042"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AeroCaptionBackgroundInactive" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#33383F"/>
        <GradientStop Offset="0.48" Color="#2A2E34"/>
        <GradientStop Offset="0.5" Color="#222529"/>
        <GradientStop Offset="1" Color="#272B30"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AeroCaptionGlass" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#B3465C78"/>
        <GradientStop Offset="0.46" Color="#9E28384C"/>
        <GradientStop Offset="0.5" Color="#99141E2C"/>
        <GradientStop Offset="1" Color="#A81E2C3E"/>
      </LinearGradientBrush>
      <SolidColorBrush x:Key="AeroCaptionTopHighlight" Color="#1FFFFFFF"/>
      <SolidColorBrush x:Key="AeroCaptionRule" Color="#0A1018"/>
      <SolidColorBrush x:Key="AeroCaptionText" Color="#EAF2FB"/>
      <SolidColorBrush x:Key="AeroCaptionTextInactive" Color="#9AA4B0"/>
      <Color x:Key="AeroCaptionTextGlowColor">#D9000000</Color>

      <LinearGradientBrush x:Key="AeroCaptionPlate" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#42FFFFFF"/>
        <GradientStop Offset="0.49" Color="#1FFFFFFF"/>
        <GradientStop Offset="0.5" Color="#05FFFFFF"/>
        <GradientStop Offset="1" Color="#1AFFFFFF"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AeroCaptionPlateHover" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#7FC2EE"/>
        <GradientStop Offset="0.49" Color="#3C8FCB"/>
        <GradientStop Offset="0.5" Color="#1C6AA8"/>
        <GradientStop Offset="1" Color="#3A9AD8"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AeroCaptionPlatePressed" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#2E5F88"/>
        <GradientStop Offset="0.49" Color="#1B4769"/>
        <GradientStop Offset="0.5" Color="#0E3150"/>
        <GradientStop Offset="1" Color="#194567"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AeroCaptionClose" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#D88E7C"/>
        <GradientStop Offset="0.49" Color="#C0614A"/>
        <GradientStop Offset="0.5" Color="#A63A23"/>
        <GradientStop Offset="1" Color="#B85840"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AeroCaptionCloseHover" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#F5B09D"/>
        <GradientStop Offset="0.49" Color="#E8644A"/>
        <GradientStop Offset="0.5" Color="#D1361A"/>
        <GradientStop Offset="1" Color="#EC7A59"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AeroCaptionClosePressed" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#A84C35"/>
        <GradientStop Offset="0.49" Color="#8A311B"/>
        <GradientStop Offset="0.5" Color="#6E1D09"/>
        <GradientStop Offset="1" Color="#842D17"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AeroCaptionPlateInactive" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#29FFFFFF"/>
        <GradientStop Offset="0.5" Color="#12FFFFFF"/>
        <GradientStop Offset="0.5" Color="#05FFFFFF"/>
        <GradientStop Offset="1" Color="#0FFFFFFF"/>
      </LinearGradientBrush>
      <SolidColorBrush x:Key="AeroCaptionPlateBorder" Color="#CC000000"/>
      <SolidColorBrush x:Key="AeroCaptionPlateHighlight" Color="#24FFFFFF"/>
      <SolidColorBrush x:Key="AeroCaptionGlyph" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="AeroCaptionGlyphHalo" Color="#F2000000"/>
      <SolidColorBrush x:Key="AeroCaptionGlyphInactive" Color="#8E97A2"/>
      <SolidColorBrush x:Key="AeroCaptionFocusRing" Color="#5FB6F2"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- ============ 窗口按钮 ControlTheme ============
       用法：<Button Theme="{StaticResource AeroCaptionButtonTheme}" Classes="close" AutomationProperties.Name="关闭" Click="…"/>
       语义不变：仍是 Button（Click/命令/自动化/键盘），模板不含 ContentPresenter，所以 CaptionAssetButton 的位图 Content 会被忽略。 -->
  <ControlTheme x:Key="AeroCaptionButtonTheme" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinWidth" Value="46"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <!-- 透明而非 null：整个 46×32 都可命中，视觉板下方 11px 也属于按钮 -->
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}">
          <Border Name="PART_Plate" Height="21" VerticalAlignment="Top"
                  Background="{DynamicResource AeroCaptionPlate}"
                  BorderBrush="{DynamicResource AeroCaptionPlateBorder}" BorderThickness="1,0,0,1">
            <Border Name="PART_Highlight" BorderBrush="{DynamicResource AeroCaptionPlateHighlight}" BorderThickness="1,0,1,1"/>
          </Border>
          <Border Name="PART_Focus" Height="21" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0"
                  BorderBrush="{DynamicResource AeroCaptionFocusRing}" BorderThickness="2"/>
          <Panel Name="PART_GlyphHost" Height="21" VerticalAlignment="Top" IsHitTestVisible="False">
            <!-- 两层 Path 代替 CSS drop-shadow：底层深色粗描边 = 光晕，上层白色细描边 = 图形 -->
            <Path Name="PART_GlyphHalo" Width="10" Height="10" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Stroke="{DynamicResource AeroCaptionGlyphHalo}" StrokeThickness="3.2" StrokeLineCap="Round" StrokeJoin="Round"/>
            <Path Name="PART_Glyph" Width="10" Height="10" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Stroke="{DynamicResource AeroCaptionGlyph}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"/>
          </Panel>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- 图形：同一 Data 给光晕与图形两层 -->
    <Style Selector="^.min /template/ Path">
      <Setter Property="Data" Value="M1,5 L9,5"/>
    </Style>
    <Style Selector="^.max /template/ Path">
      <Setter Property="Data" Value="M1.5,1.5 L8.5,1.5 L8.5,8.5 L1.5,8.5 Z"/>
    </Style>
    <Style Selector="^.restore /template/ Path">
      <Setter Property="Data" Value="M3.5,1 L9,1 L9,6.5 M1,3.5 L6.5,3.5 L6.5,9 L1,9 Z"/>
    </Style>
    <Style Selector="^.close /template/ Path">
      <Setter Property="Data" Value="M2,2 L8,8 M8,2 L2,8"/>
    </Style>

    <!-- 三键连成一组：最小化左下圆角，关闭右下圆角并补右边线 -->
    <Style Selector="^.min /template/ Border#PART_Plate">
      <Setter Property="CornerRadius" Value="0,0,0,4"/>
    </Style>
    <Style Selector="^.min /template/ Border#PART_Highlight">
      <Setter Property="CornerRadius" Value="0,0,0,3"/>
    </Style>
    <Style Selector="^.close /template/ Border#PART_Plate">
      <Setter Property="CornerRadius" Value="0,0,4,0"/>
      <Setter Property="BorderThickness" Value="1,0,1,1"/>
      <Setter Property="Background" Value="{DynamicResource AeroCaptionClose}"/>
    </Style>
    <Style Selector="^.close /template/ Border#PART_Highlight">
      <Setter Property="CornerRadius" Value="0,0,3,0"/>
    </Style>
    <!-- 对话框单键：两侧下圆角 -->
    <Style Selector="^.single /template/ Border#PART_Plate">
      <Setter Property="CornerRadius" Value="0,0,4,4"/>
      <Setter Property="BorderThickness" Value="1,0,1,1"/>
    </Style>

    <!-- 状态：Avalonia 按样式声明顺序覆盖，所以 hover → pressed → close 变体依次写 -->
    <Style Selector="^:pointerover /template/ Border#PART_Plate">
      <Setter Property="Background" Value="{DynamicResource AeroCaptionPlateHover}"/>
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Plate">
      <Setter Property="Background" Value="{DynamicResource AeroCaptionPlatePressed}"/>
    </Style>
    <Style Selector="^.close:pointerover /template/ Border#PART_Plate">
      <Setter Property="Background" Value="{DynamicResource AeroCaptionCloseHover}"/>
    </Style>
    <Style Selector="^.close:pressed /template/ Border#PART_Plate">
      <Setter Property="Background" Value="{DynamicResource AeroCaptionClosePressed}"/>
    </Style>
    <!-- 键盘焦点：只在 :focus-visible 显示 2px 光环，鼠标点击不出现；与 hover 渐变可区分 -->
    <Style Selector="^:focus-visible /template/ Border#PART_Focus">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="^:disabled /template/ Panel#PART_GlyphHost">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>
  </ControlTheme>
</ResourceDictionary>
