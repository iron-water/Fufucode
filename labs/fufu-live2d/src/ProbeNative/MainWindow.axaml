<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProbeNative"
        x:Class="ProbeNative.MainWindow"
        Width="420" Height="560"
        Title="FUFU-02 ProbeNative (Skia+Core)"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        Background="Transparent"
        Topmost="True"
        CanResize="False">
  <Panel>
    <local:Live2DSkiaView x:Name="View" />
    <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="4">
      <Border Background="#AA000000" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
        <TextBlock x:Name="Status" Foreground="White" FontSize="11" Text="loading..."/>
      </Border>
      <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="4">
        <Button x:Name="BtnMotion" FontSize="11" Padding="6,2" Content="动作"/>
        <Button x:Name="BtnReload" FontSize="11" Padding="6,2" Content="重载"/>
        <Button x:Name="BtnThrough" FontSize="11" Padding="6,2" Content="穿透"/>
        <Button x:Name="BtnMesh" FontSize="11" Padding="6,2" Content="网格"/>
      </StackPanel>
    </StackPanel>
  </Panel>
</Window>
