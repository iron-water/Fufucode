<Project>
  <!--
    本地开发开关模板（可提交到版本库）。

    默认行为（无需本文件）：
        本机用户级配置设了 LocalPreviewFeatures=true  -> 自动启用扩展特性
        否则                                          -> 自动走最小构建

    只有在需要「手动覆盖默认值」时才创建本文件：
        Copy-Item local.dev.props.example local.dev.props

    常见用途：
      * 本地想验证最小构建：设 EnableEnhancedPreview=false
      * 临时只要组件不要开发工具：设 EnableDevTooling=false

    注意：local.dev.props 已被 .gitignore 忽略，不会被推送到远端。
  -->
  <PropertyGroup>
    <!-- 取消注释并修改以覆盖默认值 -->
    <!-- <EnableEnhancedPreview>false</EnableEnhancedPreview> -->
    <!-- <EnableDevTooling>false</EnableDevTooling> -->
  </PropertyGroup>
</Project>
