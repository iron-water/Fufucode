<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Fufucode.App</AssemblyName>
    <RootNamespace>Fufucode.App</RootNamespace>
    <!-- 编译绑定纪律：UniGetUI 研究 §6.2.7，任务书强制采纳；所有 DataTemplate 必须带 x:DataType -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- G 品牌资产：exe 图标直接引用 assets/（只链接，不复制进 src） -->
    <ApplicationIcon>..\..\assets\icon\fufucode.ico</ApplicationIcon>
    <!-- E1 内置浏览器：WebView2 SDK 版本。许可证 BSD-3-Clause，解压体积 58 MB，三项详见 docs/progress-e.md。 -->
    <WebView2Version>1.0.4258.31</WebView2Version>
  </PropertyGroup>

  <!--
    本地/发布的可执行启动速度：非裁剪 Release 默认 ReadyToRun，把启动路径的 IL 预编译为原生代码。
    裁剪包在下面显式关闭（体积优先），需要时用 -p:PublishReadyToRun=true 覆盖。
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(PublishTrimmed)' != 'true'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!--
    发布瘦身（PKG-1）：仅 Release + 自包含 + 指定 RID 时启用裁剪。
    TrimMode=partial 只裁可裁剪的框架程序集，不裁 App/Core/插件自身的反射与 JSON 路径；
    Avalonia 平台后端按可达性自动分流（Windows 包不会保留 X11/macOS 后端）。
    开发用 Debug 发布与框架依赖发布不受影响。
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(SelfContained)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!--
      应用大量使用反射式 System.Text.Json。裁剪会把反射序列化默认关闭，
      这里显式恢复；未使用源生成上下文前，这是保持读写兼容的最小改动。
    -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <!--
    App 与 CLI 共用同一个自包含发布目录。CLI 需要 ConsoleCancelEventHandler，
    App 的裁剪图里没有它；若 App 覆盖 CLI 的 System.Console.dll，CLI 启动会 TypeLoadException。
    固定保留 System.Console，保证两个入口共用一份裁剪运行时。
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Release' and '$(SelfContained)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <TrimmerRootAssembly Include="System.Console" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\licenses\FLUENT-SYSTEM-ICONS-LICENSE.txt" Link="Licenses\FLUENT-SYSTEM-ICONS-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- 设备自带浏览器扩展：随应用输出，首次启动复制到应用数据目录供用户加载。 -->
    <Content Include="..\..\extensions\browser-extension-mv3\**\*"
             Link="extensions\browser-extension-mv3\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- G 品牌/空态资产（轨道 G 所有）：Link 引用，不复制不修改 -->
    <AvaloniaResource Include="..\..\assets\icon\fufucode.ico" Link="Assets\Brand\fufucode.ico" />
    <AvaloniaResource Include="..\..\assets\icon\icon-256.png" Link="Assets\Brand\icon-256.png" />
    <AvaloniaResource Include="..\..\assets\icon\icon-small-32.png" Link="Assets\Brand\icon-small-32.png" />
    <AvaloniaResource Include="..\..\assets\empty\conversation-light@2x.png" Link="Assets\Brand\empty\conversation-light@2x.png" />
    <AvaloniaResource Include="..\..\assets\empty\conversation-dark@2x.png" Link="Assets\Brand\empty\conversation-dark@2x.png" />
    <AvaloniaResource Include="..\..\assets\empty\extensions-light@2x.png" Link="Assets\Brand\empty\extensions-light@2x.png" />
    <AvaloniaResource Include="..\..\assets\empty\extensions-dark@2x.png" Link="Assets\Brand\empty\extensions-dark@2x.png" />
    <AvaloniaResource Include="..\..\assets\empty\interrupted-light@2x.png" Link="Assets\Brand\empty\interrupted-light@2x.png" />
    <AvaloniaResource Include="..\..\assets\empty\interrupted-dark@2x.png" Link="Assets\Brand\empty\interrupted-dark@2x.png" />
    <AvaloniaResource Include="..\..\assets\empty\error-light@2x.png" Link="Assets\Brand\empty\error-light@2x.png" />
    <AvaloniaResource Include="..\..\assets\empty\error-dark@2x.png" Link="Assets\Brand\empty\error-dark@2x.png" />
    <AvaloniaResource Include="Features\Skins\LiquidGlass\Assets\*.sksl" Link="Features\Skins\LiquidGlass\Assets\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\assets\titlebar\light\*@2x.png" Link="Assets\Brand\titlebar\light\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\assets\titlebar\dark\*@2x.png" Link="Assets\Brand\titlebar\dark\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <!-- 无头自测模式（selftest 参数）使用：不依赖交互式桌面会话即可验证界面与 mock 会话 -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <!-- LiquidGlass 皮肤：SKRuntimeEffect SKSL shader 渲染管线；显式引用 Avalonia.Skia/SkiaSharp
         （此前仅经 Avalonia.Desktop 传递）以编译 ISkiaSharpApiLeaseFeature 与 SK* 类型。 -->
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <!-- 富内容渲染：Markdown + LaTeX 数学 + Mermaid + SVG（WorkbenchStyles.axaml 已引用 md|MarkdownTableGrid） -->
    <PackageReference Include="LiveMarkdown.Avalonia" Version="2.4.3" />
    <PackageReference Include="LiveMarkdown.Avalonia.Math" Version="2.4.3" />
    <PackageReference Include="LiveMarkdown.Avalonia.Mermaid" Version="2.4.3" />
    <PackageReference Include="LiveMarkdown.Avalonia.Svg.Skia" Version="2.4.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- E1 内置浏览器：只用 Microsoft.Web.WebView2 的 Core（CoreWebView2Controller + 父窗口 HWND 宿主），
         不引用 WPF/WinForms 宿主控件，因此目标框架仍是 net10.0，无需切到 net10.0-windows。 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="$(WebView2Version)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 契约由独立类库 Abstractions/Fufucode.App.Abstractions.csproj 编译，本工程只引用不重复编译 -->
    <Compile Remove="Abstractions\**\*.cs" />
    <!-- 与自动开发插件共享的视图模型基类（插件链接同一份源码） -->
    <Compile Include="..\Shared\ViewModelBase.cs" Link="ViewModels\ViewModelBase.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Abstractions\Fufucode.App.Abstractions.csproj" />
    <!-- M2 集成：组合根经 PersistentSessionManager 构建真实会话（decisions.md：集成时由 App 引用 Core） -->
    <ProjectReference Include="..\Fufucode.Core\Fufucode.Core.csproj" />
  </ItemGroup>

  <!-- E1：Microsoft.Web.WebView2 的 targets 会把 Core/WPF/WinForms 三个托管程序集一并注入引用。
       本轨道只用 Core，未使用的 WPF 引用会与 WindowsBase 产生 MSB3277 版本冲突警告，
       因此在解析程序集引用前剥离，保持 build 0 警告。若将来需要 WPF/WinForms 宿主控件，删除此 Target。 -->
  <Target Name="StripUnusedWebView2ManagedRefs" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="$(NuGetPackageRoot)microsoft.web.webview2\$(WebView2Version)\buildTransitive\..\\lib_manual\net5.0-windows10.0.17763.0\Microsoft.Web.WebView2.Wpf.dll" />
      <Reference Remove="$(NuGetPackageRoot)microsoft.web.webview2\$(WebView2Version)\buildTransitive\..\\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll" />
    </ItemGroup>
  </Target>

</Project>
