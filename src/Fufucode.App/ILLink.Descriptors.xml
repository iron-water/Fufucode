<?xml version="1.0" encoding="utf-8"?>
<!--
  共享裁剪运行时：App 与 CLI 用同一份框架程序集，因此每个入口单独裁剪出的可达图
  都不足以支撑另一个入口。这里显式保留两个入口都会用到、但 App 自身不可达的框架成员。

  背景（实测）：CLI 在共享运行时的 `sessions list` 启动即
  `Method not found: DefaultInterpolatedStringHandler.AppendFormatted(!!0, Int32)`。
  反编译可见 App 的裁剪结果把该泛型重载移除了（App 自己不用带对齐的插值），
  只 root 程序集 System.Runtime 不够——实现体在 System.Private.CoreLib 里，仍被按成员裁掉。
-->
<linker>
  <assembly fullname="System.Private.CoreLib">
    <!-- 带对齐参数的插值字符串重载（$"{x,8}"）；CLI 的表格输出依赖它。 -->
    <type fullname="System.Runtime.CompilerServices.DefaultInterpolatedStringHandler" preserve="all" />
    <type fullname="System.Runtime.CompilerServices.TryWriteInterpolatedStringHandler" preserve="all" />
    <type fullname="System.Runtime.CompilerServices.StringInterpolatedStringHandler*" preserve="all" />
  </assembly>
</linker>
