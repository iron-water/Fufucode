<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Adapted from UniGetUI (MIT) Styles.Common.axaml — WinUI Fluent v2 design tokens.
         Avalonia's Fluent theme only ships UWP-era names; this polyfills the v2 token set.
         Accent follows SystemAccentColor (Dark1/Dark2 in Light, Light1/Light2/Light3 in Dark). -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Accent fills -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush"   Color="{DynamicResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{DynamicResource SystemAccentColorDark1}"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"  Color="{DynamicResource SystemAccentColorDark2}"/>
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush"  Color="#37000000"/>
            <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{DynamicResource SystemAccentColor}"/>
            <!-- Accent text (darker accents read better on light bg) -->
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush"   Color="{DynamicResource SystemAccentColorDark2}"/>
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{DynamicResource SystemAccentColorDark3}"/>
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush"  Color="{DynamicResource SystemAccentColorDark1}"/>
            <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush"  Color="#5C000000"/>
            <!-- Bridge Avalonia's legacy Fluent accent aliases to the same palette. -->
            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush"  Color="{DynamicResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush"  Color="{DynamicResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush"   Color="{DynamicResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="SystemControlHighlightAltAccentBrush" Color="{DynamicResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="SystemControlRevealFocusVisualBrush" Color="{DynamicResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused"       Color="{DynamicResource SystemAccentColor}"/>
            <!-- Hyperlinks: fixed blue, decoupled from the accent -->
            <SolidColorBrush x:Key="HyperlinkForegroundBrush"            Color="{DynamicResource SystemAccentColorDark2}"/>
            <!-- Text fill -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush"   Color="#E4000000"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9E000000"/>
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush"  Color="#8A000000"/>
            <SolidColorBrush x:Key="TextFillColorDisabledBrush"  Color="#5C000000"/>
            <SolidColorBrush x:Key="TextFillColorInverseBrush"   Color="#FFFFFFFF"/>
            <!-- Text on accent -->
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush"   Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3FFFFFF"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush"  Color="#FFFFFFFF"/>
            <!-- Control fills / strokes -->
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush"    Color="#B3FFFFFF"/>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"  Color="#80F9F9F9"/>
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"   Color="#4DF9F9F9"/>
            <SolidColorBrush x:Key="ControlFillColorDisabledBrush"   Color="#4DF9F9F9"/>
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"   Color="#0F000000"/>
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#29000000"/>
            <!-- 三档底色规范：输入框/滚动条/菜单等 Fluent 默认面统一归到语义底色，
                 避免出现规范外的近黑（如 #111111）。 -->
            <StaticResource x:Key="TextControlBackground"            ResourceKey="SolidBackgroundFillColorTertiaryBrush"/>
            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SolidBackgroundFillColorTertiaryBrush"/>
            <StaticResource x:Key="TextControlBackgroundFocused"     ResourceKey="SolidBackgroundFillColorQuaternaryBrush"/>
            <StaticResource x:Key="TextControlBackgroundDisabled"    ResourceKey="SolidBackgroundFillColorSecondaryBrush"/>
            <StaticResource x:Key="TextControlBorderBrush"           ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ControlStrokeColorSecondaryBrush"/>
            <StaticResource x:Key="ScrollBarThumbFill"               ResourceKey="ControlStrokeColorSecondaryBrush"/>
            <StaticResource x:Key="ScrollBarThumbFillPointerOver"    ResourceKey="ControlStrokeColorSecondaryBrush"/>
            <StaticResource x:Key="ScrollBarThumbFillPressed"        ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="MenuFlyoutPresenterBackground"    ResourceKey="CardBackgroundFillColorDefaultBrush"/>
            <StaticResource x:Key="MenuFlyoutPresenterBorderBrush"   ResourceKey="CardStrokeColorDefaultSolidBrush"/>
            <StaticResource x:Key="ComboBoxDropDownBackground"       ResourceKey="CardBackgroundFillColorDefaultBrush"/>
            <StaticResource x:Key="ComboBoxDropDownBorderBrush"      ResourceKey="CardStrokeColorDefaultSolidBrush"/>
            <SolidColorBrush x:Key="ControlStrokeColorForStrongFillWhenOnImageBrush" Color="#59000000"/>
            <LinearGradientBrush x:Key="ControlElevationBorderBrush"
                                 StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#0F000000"/>
                <GradientStop Offset="1" Color="#29000000"/>
            </LinearGradientBrush>
            <!-- Subtle fills (NavigationViewItem hover/selected) -->
            <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00FFFFFF"/>
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush"   Color="#09000000"/>
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush"    Color="#06000000"/>
            <SolidColorBrush x:Key="SubtleFillColorDisabledBrush"    Color="#00000000"/>
            <!-- Layer / card / background surfaces -->
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush"      Color="#F3F3F3"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#EEEEEE"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush"  Color="#F9F9F9"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorQuaternaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#80FFFFFF"/>
            <SolidColorBrush x:Key="LayerFillColorAltBrush"     Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"   Color="#B3FFFFFF"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#80F6F6F6"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"      Color="#0F000000"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#E1E1E1"/>
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush"   Color="#0F000000"/>
            <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush"   Color="#75757566"/>
            <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush"    Color="#0000000F"/>
            <!-- System status fills -->
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush"   Color="#0F7B0F"/>
            <SolidColorBrush x:Key="SystemFillColorCautionBrush"   Color="#9D5D00"/>
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush"  Color="#C42B1C"/>
            <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#0067C0"/>
            <SolidColorBrush x:Key="SystemFillColorNeutralBrush"   Color="#72000000"/>
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush"   Color="#DFF6DD"/>
            <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush"   Color="#FFF4CE"/>
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush"  Color="#FDE7E9"/>
            <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#E5F1FA"/>
            <SolidColorBrush x:Key="SystemFillColorNeutralBackgroundBrush"   Color="#09000000"/>
            <!-- Flyout / dialog / overlay -->
            <SolidColorBrush x:Key="MenuSurfaceBrush"       Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="MenuDividerBrush"       Color="#0F000000"/>
            <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#4D000000"/>
            <!-- Avalonia's Button theme reads these keys from inside its control template. -->
            <StaticResource x:Key="ButtonBackground"           ResourceKey="ControlFillColorDefaultBrush"/>
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ControlFillColorSecondaryBrush"/>
            <StaticResource x:Key="ButtonBackgroundPressed"    ResourceKey="ControlFillColorTertiaryBrush"/>
            <StaticResource x:Key="ButtonBackgroundDisabled"   ResourceKey="ControlFillColorDisabledBrush"/>
            <StaticResource x:Key="ButtonForeground"           ResourceKey="TextFillColorPrimaryBrush"/>
            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush"/>
            <StaticResource x:Key="ButtonForegroundPressed"    ResourceKey="TextFillColorSecondaryBrush"/>
            <StaticResource x:Key="ButtonForegroundDisabled"   ResourceKey="TextFillColorDisabledBrush"/>
            <StaticResource x:Key="ButtonBorderBrush"          ResourceKey="ControlElevationBorderBrush"/>
            <StaticResource x:Key="AccentButtonBackground"           ResourceKey="AccentFillColorDefaultBrush"/>
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush"/>
            <StaticResource x:Key="AccentButtonBackgroundPressed"    ResourceKey="AccentFillColorTertiaryBrush"/>
            <StaticResource x:Key="AccentButtonBackgroundDisabled"   ResourceKey="AccentFillColorDisabledBrush"/>
            <StaticResource x:Key="AccentButtonForeground"           ResourceKey="TextOnAccentFillColorPrimaryBrush"/>
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush"/>
            <StaticResource x:Key="AccentButtonForegroundPressed"    ResourceKey="TextOnAccentFillColorSecondaryBrush"/>
            <StaticResource x:Key="AccentButtonForegroundDisabled"   ResourceKey="TextOnAccentFillColorDisabledBrush"/>
            <BoxShadows x:Key="FluentFlyoutShadow">0 8 24 0 #29000000</BoxShadows>
            <BoxShadows x:Key="FluentToastShadow">0 4 16 0 #33000000</BoxShadows>
            <BoxShadows x:Key="FluentPillShadow">0 4 12 0 #26000000</BoxShadows>
            <!-- 设置卡/内容卡的极轻浮起阴影：对齐 Win11 设置页"卡比底色高一线"的层次。 -->
            <BoxShadows x:Key="FluentCardShadow">0 1 2 0 #12000000</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <!-- Accent fills (lighter accents on dark bg) -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush"   Color="{DynamicResource SystemAccentColorLight2}"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{DynamicResource SystemAccentColorLight1}"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"  Color="{DynamicResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush"  Color="#28FFFFFF"/>
            <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{DynamicResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush"   Color="{DynamicResource SystemAccentColorLight3}"/>
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{DynamicResource SystemAccentColorLight3}"/>
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush"  Color="{DynamicResource SystemAccentColorLight2}"/>
            <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush"  Color="#5CFFFFFF"/>
            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush"  Color="{DynamicResource SystemAccentColorLight2}"/>
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush"  Color="{DynamicResource SystemAccentColorLight2}"/>
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush"   Color="{DynamicResource SystemAccentColorLight2}"/>
            <SolidColorBrush x:Key="SystemControlHighlightAltAccentBrush" Color="{DynamicResource SystemAccentColorLight2}"/>
            <SolidColorBrush x:Key="SystemControlRevealFocusVisualBrush" Color="{DynamicResource SystemAccentColorLight2}"/>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused"       Color="{DynamicResource SystemAccentColorLight2}"/>
            <SolidColorBrush x:Key="HyperlinkForegroundBrush"            Color="{DynamicResource SystemAccentColorLight2}"/>
            <!-- Text fill -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush"   Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF"/>
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush"  Color="#A6FFFFFF"/>
            <SolidColorBrush x:Key="TextFillColorDisabledBrush"  Color="#5DFFFFFF"/>
            <SolidColorBrush x:Key="TextFillColorInverseBrush"   Color="#E4000000"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush"   Color="#000000"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#80000000"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush"  Color="#87FFFFFF"/>
            <!-- Control fills / strokes -->
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush"    Color="#2C2C2C"/>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"  Color="#333333"/>
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"   Color="#3A3A3A"/>
            <SolidColorBrush x:Key="ControlFillColorDisabledBrush"   Color="#2C2C2C"/>
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#2C2C2C"/>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"   Color="#12FFFFFF"/>
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#18FFFFFF"/>
            <!-- 三档底色规范：输入框用深层、滚动条用高亮层、菜单/下拉用栏层。 -->
            <StaticResource x:Key="TextControlBackground"            ResourceKey="ControlFillColorTertiaryBrush"/>
            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="ControlFillColorTertiaryBrush"/>
            <StaticResource x:Key="TextControlBackgroundFocused"     ResourceKey="ControlFillColorTertiaryBrush"/>
            <StaticResource x:Key="TextControlBackgroundDisabled"    ResourceKey="ControlFillColorSecondaryBrush"/>
            <StaticResource x:Key="TextControlBorderBrush"           ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ControlStrokeColorSecondaryBrush"/>
            <StaticResource x:Key="ScrollBarThumbFill"               ResourceKey="ControlStrokeColorSecondaryBrush"/>
            <StaticResource x:Key="ScrollBarThumbFillPointerOver"    ResourceKey="ControlStrokeColorSecondaryBrush"/>
            <StaticResource x:Key="ScrollBarThumbFillPressed"        ResourceKey="ControlStrokeColorDefaultBrush"/>
            <StaticResource x:Key="MenuFlyoutPresenterBackground"    ResourceKey="SolidBackgroundFillColorQuaternaryBrush"/>
            <StaticResource x:Key="MenuFlyoutPresenterBorderBrush"   ResourceKey="CardStrokeColorDefaultSolidBrush"/>
            <StaticResource x:Key="ComboBoxDropDownBackground"       ResourceKey="SolidBackgroundFillColorQuaternaryBrush"/>
            <StaticResource x:Key="ComboBoxDropDownBorderBrush"      ResourceKey="CardStrokeColorDefaultSolidBrush"/>
            <SolidColorBrush x:Key="ControlStrokeColorForStrongFillWhenOnImageBrush" Color="#42FFFFFF"/>
            <LinearGradientBrush x:Key="ControlElevationBorderBrush"
                                 StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#18FFFFFF"/>
                <GradientStop Offset="1" Color="#12FFFFFF"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00FFFFFF"/>
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush"   Color="#3A3A3A"/>
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush"    Color="#3A3A3A"/>
            <SolidColorBrush x:Key="SubtleFillColorDisabledBrush"    Color="#00000000"/>
            <!-- Layer / card / background surfaces: Fluent 暗色只使用三档底色。 -->
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush"      Color="#1C1C1C"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#1C1C1C"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush"  Color="#2C2C2C"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorQuaternaryBrush" Color="#2C2C2C"/>
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#2C2C2C"/>
            <SolidColorBrush x:Key="LayerFillColorAltBrush"     Color="#2C2C2C"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"   Color="#2C2C2C"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#3A3A3A"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"      Color="#19000000"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#1C1C1C"/>
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush"   Color="#15FFFFFF"/>
            <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush"   Color="#75757566"/>
            <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush"    Color="#00000033"/>
            <!-- System status fills -->
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush"   Color="#6CCB5F"/>
            <SolidColorBrush x:Key="SystemFillColorCautionBrush"   Color="#FCE100"/>
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush"  Color="#FF99A4"/>
            <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#60CDFF"/>
            <SolidColorBrush x:Key="SystemFillColorNeutralBrush"   Color="#8AFFFFFF"/>
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush"   Color="#393D1B"/>
            <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush"   Color="#433519"/>
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush"  Color="#442726"/>
            <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#1B2A35"/>
            <SolidColorBrush x:Key="SystemFillColorNeutralBackgroundBrush"   Color="#0FFFFFFF"/>
            <!-- Flyout / dialog / overlay -->
            <SolidColorBrush x:Key="MenuSurfaceBrush"       Color="#FF2C2C2C"/>
            <SolidColorBrush x:Key="MenuDividerBrush"       Color="#15FFFFFF"/>
            <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#4D000000"/>
            <StaticResource x:Key="ButtonBackground"           ResourceKey="ControlFillColorDefaultBrush"/>
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ControlFillColorSecondaryBrush"/>
            <StaticResource x:Key="ButtonBackgroundPressed"    ResourceKey="ControlFillColorTertiaryBrush"/>
            <StaticResource x:Key="ButtonBackgroundDisabled"   ResourceKey="ControlFillColorDisabledBrush"/>
            <StaticResource x:Key="ButtonForeground"           ResourceKey="TextFillColorPrimaryBrush"/>
            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush"/>
            <StaticResource x:Key="ButtonForegroundPressed"    ResourceKey="TextFillColorSecondaryBrush"/>
            <StaticResource x:Key="ButtonForegroundDisabled"   ResourceKey="TextFillColorDisabledBrush"/>
            <StaticResource x:Key="ButtonBorderBrush"          ResourceKey="ControlElevationBorderBrush"/>
            <StaticResource x:Key="AccentButtonBackground"           ResourceKey="AccentFillColorDefaultBrush"/>
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush"/>
            <StaticResource x:Key="AccentButtonBackgroundPressed"    ResourceKey="AccentFillColorTertiaryBrush"/>
            <StaticResource x:Key="AccentButtonBackgroundDisabled"   ResourceKey="AccentFillColorDisabledBrush"/>
            <StaticResource x:Key="AccentButtonForeground"           ResourceKey="TextOnAccentFillColorPrimaryBrush"/>
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush"/>
            <StaticResource x:Key="AccentButtonForegroundPressed"    ResourceKey="TextOnAccentFillColorSecondaryBrush"/>
            <StaticResource x:Key="AccentButtonForegroundDisabled"   ResourceKey="TextOnAccentFillColorDisabledBrush"/>
            <BoxShadows x:Key="FluentFlyoutShadow">0 8 24 0 #66000000</BoxShadows>
            <BoxShadows x:Key="FluentToastShadow">0 4 18 0 #80000000</BoxShadows>
            <BoxShadows x:Key="FluentPillShadow">0 4 12 0 #55000000</BoxShadows>
            <BoxShadows x:Key="FluentCardShadow">0 1 3 0 #4D000000</BoxShadows>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
