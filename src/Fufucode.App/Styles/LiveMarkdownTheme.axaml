<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 正文使用柔和前景；代码/引用底色与一级背景同层，不再叠纯黑色。 -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SecondaryCardBackgroundColor">#F3F3F3</Color>
            <Color x:Key="BorderColor">#1A000000</Color>
            <Color x:Key="ForegroundColor">#343434</Color>
            <Color x:Key="CodeInlineColor">#52654D</Color>
            <Color x:Key="QuoteBorderColor">#52654D</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SecondaryCardBackgroundColor">#1C1C1C</Color>
            <Color x:Key="BorderColor">#20FFFFFF</Color>
            <Color x:Key="ForegroundColor">#C9C9C9</Color>
            <Color x:Key="CodeInlineColor">#B4BFAF</Color>
            <Color x:Key="QuoteBorderColor">#B4BFAF</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
