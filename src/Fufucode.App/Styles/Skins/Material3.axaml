<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Material 3 皮肤令牌（E7 样板，依据已接受 S1 样稿 css/tokens.css 的值与 M3 规范扩展）。
         只在 SkinLease 应用时合并进目标 Window/Control 的 Resources，释放时按引用移除。
         强调色为本样板固定值（亮 #6750A4 / 暗 #D0BCFF）；字体回退系统 Segoe 族，
         不采购/捆绑 Roboto（S1-5、frontend-design-guideline U02）。 -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#FF6750A4</Color>
            <Color x:Key="SystemAccentColorDark1">#FF544490</Color>
            <Color x:Key="SystemAccentColorDark2">#FF3F2E77</Color>
            <Color x:Key="SystemAccentColorDark3">#FF2B1B5E</Color>
            <Color x:Key="SystemAccentColorLight1">#FF7F67BE</Color>
            <Color x:Key="SystemAccentColorLight2">#FF9A83D8</Color>
            <Color x:Key="SystemAccentColorLight3">#FFB69DF8</Color>

