            <SolidColorBrush x:Key="AppCautionBackground" Color="#FF3A2E14"/>

            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">28</CornerRadius>
            <CornerRadius x:Key="AppCornerCard">16</CornerRadius>
