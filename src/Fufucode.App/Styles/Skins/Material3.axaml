            <x:Double x:Key="AppFontSizeSection">22</x:Double>
            <x:Double x:Key="AppFontSizePage">32</x:Double>
            <FontWeight x:Key="AppFontWeightStrong">Medium</FontWeight>
            <BoxShadows x:Key="FluentFlyoutShadow">0 4 16 0 #66000000</BoxShadows>
            <BoxShadows x:Key="FluentToastShadow">0 6 20 0 #73000000</BoxShadows>
            <BoxShadows x:Key="FluentPillShadow">0 4 12 0 #66000000</BoxShadows>
