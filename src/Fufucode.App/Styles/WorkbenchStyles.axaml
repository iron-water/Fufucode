<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Fufucode.App.Views"
        xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia">
  <!-- 工作台共享组件：停靠容器、页签、分隔条、窗口外框、工具条与空状态。
       只引用 App* 语义键，主题/强调色/风格预设统一经由令牌生效。 -->
  <Style Selector="Button.subtle">
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>

  <!-- 外框：标题栏与状态栏同属 chrome 层，与停靠区同底；分隔降为发丝细线，
       Win11 深色里 6% 白线比 6% 黑线更隐形，整体观感是无框、层叠式。 -->
  <Style Selector="Border.chromeBar">
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Background" Value="{DynamicResource AppChromeBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerSubtle}"/>
  </Style>
  <Style Selector="Border.chromeBar TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
  </Style>
  <!-- chrome 内动作图标默认退一级（不抢拖动区留白），悬停回主色 -->
  <Style Selector="Border.chromeBar Button.captionSlot PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
  </Style>
  <Style Selector="Border.chromeBar Button.captionSlot:pointerover PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>
  <Style Selector="Border.chromeBar.statusStrip">
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
  </Style>

  <!-- ===== Windows 设置风格（WinUI 3 Settings 度量）=====
       Windows 11 设置里每个设置项是独立的一张圆角卡，同组内卡与卡之间留 4px 缝；
       分组标题在卡片之外。行高：带说明 64，仅标题 52。 -->
  <Style Selector="Border.settingsRow">
    <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="Padding" Value="18,12"/>
    <Setter Property="MinHeight" Value="64"/>
    <Setter Property="Margin" Value="0"/>
    <!-- 卡片的极轻浮起阴影：让同色系的卡与页底之间有"高一线"的层次。 -->
    <Setter Property="BoxShadow" Value="{DynamicResource FluentCardShadow}"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.083"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.settingsRow.compact">
    <Setter Property="MinHeight" Value="52"/>
    <Setter Property="Padding" Value="18,8"/>
  </Style>
  <Style Selector="Border.settingsRow.clickable">
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Border.settingsRow.clickable:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppListSelected}"/>
  </Style>
  <!-- 所有设置行（不只可点击行）在悬停时统一升高亮层，先保证"横条有反馈"，再逐项细化。 -->
  <Style Selector="Border.settingsRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppListSelected}"/>
  </Style>
  <Style Selector="Border.settingsRow.clickable:pressed">
    <Setter Property="Background" Value="{DynamicResource AppPressed}"/>
  </Style>
  <!-- 「其他」入口卡：Button 版 settingsRow（同款卡片外观，Button 自带点击语义）。 -->
  <Style Selector="Button.settingsRow">
    <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="Padding" Value="18,12"/>
    <Setter Property="MinHeight" Value="64"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.083"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.083"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.settingsRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppListSelected}"/>
  </Style>
  <Style Selector="Button.settingsRow:pressed">
    <Setter Property="Background" Value="{DynamicResource AppPressed}"/>
    <Setter Property="RenderTransform" Value="scale(0.995)"/>
  </Style>
  <Style Selector="Border.settingsRow.last">
    <Setter Property="Margin" Value="0,0,0,0"/>
  </Style>
  <!-- 会话管理只保留三层：页底 → 项目组面板（项目栏与会话同色）→ 悬停高亮。
       不再给单行套卡片/描边，避免多层 box 叠在一起。 -->
  <Style Selector="Border.overviewGroup">
    <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource FluentCardShadow}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="Margin" Value="0,2,0,4"/>
  </Style>
  <Style Selector="Button.overviewProject">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.overviewProject:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHover}"/>
  </Style>
  <Style Selector="Border.overviewSession">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="Margin" Value="0,1,0,0"/>
  </Style>
  <!-- 悬停高亮由代码在整行 Border 上加 hover 类，保证覆盖标题与右侧快捷图标同一块底，
       不再依赖子按钮的 :pointerover（那只画标题列）。 -->
  <Style Selector="Border.overviewSession.hover">
    <Setter Property="Background" Value="{DynamicResource AppHover}"/>
  </Style>
  <!-- 伪类兜底：覆盖子树，行内任意位置悬停都亮（不依赖手动 PointerEntered）。 -->
  <Style Selector="Border.overviewSession:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHover}"/>
  </Style>
  <!-- 输入区上下文条：项目/后端 chip，与设置行同一层轻质填充，不使用独立卡片。 -->
  <Style Selector="Button.contextChip">
    <Setter Property="Background" Value="{DynamicResource AppInnerWell}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.contextChip:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHover}"/>
  </Style>

  <!-- 会话行内的标题按钮只负责点击与文本，不能再画自己的悬停底色：
       否则高亮只覆盖标题列，宽度与右侧快捷图标对不齐。 -->
  <Style Selector="Border.overviewSession Button:pointerover">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Border.overviewSession Button:pressed">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Border.overviewSession Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <!-- 对话框卡片内的输入框：与设置行同口径的轻质填充，
       不再使用深色主题下默认的纯黑输入底。 -->
  <Style Selector="TextBox.dialogInput">
    <Setter Property="Background" Value="{DynamicResource AppInnerWell}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBox.dialogInput /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource AppInnerWell}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="TextBox.dialogInput:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource AppInnerWell}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="TextBox.dialogInput:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource AppInnerWell}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <!-- UI-1 单闭合边框原则：设置行已闭合，行内输入框/选择器降级为无框轻质填充，
       行内结构划分只用单向 1px 发丝细线。 -->
  <Style Selector="Border.settingsRow TextBox">
    <Setter Property="Background" Value="{DynamicResource AppInnerWell}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Border.settingsRow TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource AppInnerWell}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Border.settingsRow TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource AppInnerWell}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <!-- Win11 设置行内下拉：默认 subtle 填充（#0DFFFFFF 深色 / #80F6F6F6 浅色）、
       无可见边框，悬停时升到 ControlFillColorSecondary；左侧留 10px、右侧留给箭头。 -->
  <Style Selector="Border.settingsRow ComboBox">
    <Setter Property="Background" Value="{DynamicResource AppInnerWell}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="Padding" Value="10,4,28,4"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.083"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.settingsRow ComboBox:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHover}"/>
  </Style>
  <!-- 行内开关：Fluent 默认 40×20 偏大，Win11 设置里为 36×18。 -->
  <Style Selector="Border.settingsRow ToggleSwitch">
    <Setter Property="MinHeight" Value="20"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <!-- 分组容器：只负责间距，不再是唯一的卡片 -->
  <Style Selector="StackPanel.settingsGroupList">
    <Setter Property="Spacing" Value="8"/>
  </Style>
  <!-- 行内响应式重排钩子：窄窗口下行内控件换行（code-behind 依类名重排）。 -->
  <Style Selector="Grid.settingsControlRow">
    <Setter Property="RowSpacing" Value="8"/>
  </Style>
  <!-- 设置内容区里的列表统一走 8px 节奏；限定在 settingsContentHost 内，
       避免污染页面外的 ItemsControl。 -->
  <Style Selector="Border.settingsContentHost ItemsControl">
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate><StackPanel Classes="settingsGroupList"/></ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 左侧导航宿主（Windows 设置度量）：浮为侧栏面，比内容区亮一档形成明度差。
       深色下走 AppSettingsNavBackground（FufucodeTheme 里定义为实色 #2C2C2C，
       因为 Fluent 的 Quaternary 是透明叠加、不是实色）。 -->
  <!-- 设置页左导航：整列透页面底（原色），每条导航项自己用中间灰卡片。 -->
  <Style Selector="Border.settingsNavHost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0,0,8,0"/>
  </Style>
  <Style Selector="ListBox.settingsNav">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="ListBox.settingsNav.compactBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <!-- 设置页内容宿主：透页面底（Win11 设置左右两侧都是窗口底色，
       卡片感由行内 settingsRow 提供）。 -->
  <Style Selector="Border.settingsContentHost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="Padding" Value="24,20,20,24"/>
    <Setter Property="RenderTransform" Value="translate(0,0)"/>
    <!-- 分类切换淡入+上滑（Win11 设置同款 ~150ms），由 AnimateContentIn 复位触发。
         TransformOperationsTransition 要求 RenderTransform 为 TransformOperations。 -->
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <!-- Win11 设置导航项：40px 高给文字上下真实呼吸位（之前 36px 偏紧），
       无缝 Margin 0，选中/hover 块即整行。 -->
  <Style Selector="ListBox.settingsNav ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,0,2"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <!-- 单一 navFill 整行背景层：常态透明，pointerover 染浅（AppListHover）、
       selected 染深（AppListSelected），BrushTransition 渐变。 -->
  <Style Selector="Border.navFill">
    <Setter Property="Background" Value="{DynamicResource AppBaseBar}"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.settingsNav ListBoxItem:pointerover Border.navFill">
    <Setter Property="Background" Value="{DynamicResource AppListHover}"/>
  </Style>
  <Style Selector="ListBox.settingsNav ListBoxItem:selected Border.navFill">
    <Setter Property="Background" Value="{DynamicResource AppListSelected}"/>
  </Style>
  <Style Selector="ListBox.settingsNav ListBoxItem:selected:pointerover Border.navFill">
    <Setter Property="Background" Value="{DynamicResource AppListSelected}"/>
  </Style>
  <!-- ListBoxItem 本身保持透明，避免与 navCardBg 的双重填充 -->
  <Style Selector="ListBox.settingsNav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.settingsNav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.settingsNav ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <!-- 选中项左侧强调竖条：3×18 圆角，贴 navCardBg 内缘（深色 #4CC2FF 亮青，浅色跟随 accent）。
       内容层已左移 8px，竖条 Margin 归 0，自然落在 navCardBg 内部左缘。 -->
  <Style Selector="Border.navAccent">
    <Setter Property="Width" Value="3"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Background" Value="{DynamicResource AppNavAccentBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <!-- 叠加在 navCardBg 内部左缘（内容层左缘 12px，accent 4px 缩进）。
         Opacity 驱动淡入，IsVisible 硬切不走过渡。 -->
    <Setter Property="Margin" Value="4,0,0,0"/>
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ListBox.settingsNav ListBoxItem:selected Border.navAccent">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="ListBox.settingsNav ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>
  <Style Selector="ListBox.settingsNav ListBoxItem TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>
  <!-- Win11 设置导航图标：彩色实心块由 SemanticIcon 自身处理 CategoryColor，
       PathIcon（紧凑栏等）回退主色。 -->
  <Style Selector="ListBox.settingsNav ListBoxItem PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>
  <Style Selector="ListBox.settingsNav ListBoxItem:selected PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>

  <!-- 文字层级（Windows 设置：行标题 14 常规、说明 12 次级、分组标题 14 半粗） -->
  <Style Selector="TextBlock.settingsRowTitle">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.settingsRowDesc">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <!-- 分组容器：Win11 组内行已经是独立圆角卡，组本身不再包一层大卡，
       否则双重边框+双重圆角。这里只负责与下一组的间隔。 -->
  <Style Selector="Border.settingsGroup">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <!-- 收进 8px 网格：与其它容器尾部一致，不再单独 16。 -->
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <!-- 内容卡：非行式的说明/信息/列表容器（市场说明卡、插件项、可用模型、
       远程配对、关于版本、更新包说明等）。与 settingsRow 同底色同描边，
       但内边距更松，因为它装的是段落/网格而非"标题+控件"行。 -->
  <Style Selector="Border.settingsPanel">
    <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="Padding" Value="18,14"/>
    <!-- 收进 8px 网格：行距/组头间距都以 8 为基准，内容卡尾部也回到 8。 -->
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style Selector="Border.settingsPanel.subtle">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackground}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Border.settingsGroup > StackPanel">
    <Setter Property="Margin" Value="0"/>
    <!-- settingsGroup 包一层无间距 StackPanel：里面的 settingsRow 需要
         行间 8px，否则卡片贴死（与 settingsGroupList 同一节奏）。 -->
    <Setter Property="Spacing" Value="8"/>
  </Style>
  <Style Selector="TextBlock.settingsGroupHeader">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <!-- 组头间距统一成 8px 网格的整数倍：行距 8 + 组头上方 32 = 40px 的固定分组间隔，
         避免此前 28/12/16 各处叠加造成的忽宽忽窄。 -->
    <Setter Property="Margin" Value="0,32,0,10"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>
  <Style Selector="TextBlock.settingsGroupHeader.first">
    <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>
  <!-- 组级说明：出现在组头与行卡之间，与行说明同字号但保留独立的上文间距。 -->
  <Style Selector="TextBlock.settingsGroupDesc">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="2,0,0,10"/>
  </Style>
  <!-- 可折叠组头按钮：透明底、悬停弱填充，行式卡内嵌套时无自身描边。 -->
  <Style Selector="Button.settingsGroupToggle">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.083"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.settingsGroupToggle:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppListHover}"/>
  </Style>
  <!-- 页面标题：Windows 设置的面包屑用 20px，父级次级色、当前页主色 -->
  <!-- 模型选择器关键字胶囊：标签按钮 + 右侧关闭键，二者共用同一底色。 -->
  <Style Selector="Border.keywordChip">
    <Setter Property="Background" Value="{DynamicResource AppBaseBar}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Button.keywordChipLabel">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="9,0,4,0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.keywordChipLabel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.keywordChipClose">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="2,0,6,0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.keywordChipClose:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>
  <Style Selector="Button.keywordChipClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="TextBlock.settingsPageTitle">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
    <!-- 与 breadcrumb/crumbLink 同基线：字号差靠底部对齐吸收，不再用底部外边距顶开。 -->
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style Selector="TextBlock.breadcrumb">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
  </Style>
  <!-- 面包屑父级按钮：20px 次级文字，悬停转主色，无按钮底。
       与 settingsPageTitle(22) 保持次级差。 -->
  <Style Selector="Button.crumbLink">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <!-- 与 settingsPageTitle 完全同字号同字重：层级只靠颜色区分，
         避免父级文字变小变轻、和当前页标题不在同一视觉基线上。 -->
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
    <Setter Property="VerticalContentAlignment" Value="Bottom"/>
  </Style>
  <Style Selector="Button.crumbLink /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="VerticalContentAlignment" Value="Bottom"/>
  </Style>
  <Style Selector="Button.crumbLink:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>
  <Style Selector="Button.crumbLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.crumbLink:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!-- 停靠容器：三区共用同一表面，中央会话区为内容层 -->
  <Style Selector="Border.dockHost">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource AppDockBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
  </Style>
  <Style Selector="Border.dockHost.dockLeft">
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerSubtle}"/>
  </Style>
  <Style Selector="Border.dockHost.dockRight">
    <Setter Property="BorderThickness" Value="1,0,0,0"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerSubtle}"/>
  </Style>
  <Style Selector="Border.dockHost.dockBottom">
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerSubtle}"/>
  </Style>
  <Style Selector="DockPanel.dockHeader">
    <Setter Property="Background" Value="{DynamicResource AppDockHeaderBackground}"/>
  </Style>
  <Style Selector="Border.dockHeaderRule">
    <Setter Property="Height" Value="1"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
    <Setter Property="Background" Value="{DynamicResource AppDividerSubtle}"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>

  <!-- 页签：未选中退为次级文字；选中＝主文字 + 底部 accent 指示条，无额外填充块 -->
  <Style Selector="Button.dockTab">
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.dockTab:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>
  <Style Selector="Button.dockTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>
  <Style Selector="Button.dockTab.selected">
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Grid.dockTabRow Button.dockTabClose">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <!-- 停靠区页签条也是"横条"：悬停整条升高亮层。 -->
  <Style Selector="Grid.dockTabRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppListSelected}"/>
  </Style>
  <Style Selector="Grid.dockTabRow:pointerover Button.dockTabClose, Grid.dockTabRow:focus-within Button.dockTabClose, Grid.dockTabRow.selected Button.dockTabClose">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="IsHitTestVisible" Value="True"/>
  </Style>
  <Style Selector="Border.dockIndicator">
    <Setter Property="Background" Value="{DynamicResource AppAccent}"/>
    <Setter Property="Height" Value="2"/>
    <Setter Property="Margin" Value="8,0"/>
    <Setter Property="CornerRadius" Value="1"/>
  </Style>
  <Style Selector="Border.dockDropTarget">
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
    <Setter Property="Background" Value="{DynamicResource AppAccentSubtle}"/>
  </Style>
  <Style Selector="TextBlock.dockEmpty">
    <Setter Property="Foreground" Value="{DynamicResource AppTextDim}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- 区间分隔：静止为 1px 分隔线，悬停/聚焦提示 accent；命中区保持 5px -->
  <Style Selector="GridSplitter.dockSplitter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Border Name="SplitGrip" Background="{TemplateBinding Background}"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter.dockSplitter[ResizeDirection=Columns] /template/ Border#SplitGrip">
    <Setter Property="Width" Value="2"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>
  <Style Selector="GridSplitter.dockSplitter[ResizeDirection=Rows] /template/ Border#SplitGrip">
    <Setter Property="Height" Value="2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="GridSplitter.dockSplitter:pointerover, GridSplitter.dockSplitter:focus-visible">
    <Setter Property="Background" Value="{DynamicResource AppAccent}"/>
  </Style>

  <!-- 区域工具条按钮（页签行尾、面板头）：统一 28px 命中区 -->
  <Style Selector="Button.toolButton">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinWidth" Value="28"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="6"/>
  </Style>
  <Style Selector="Button.toolButton.active">
    <Setter Property="Background" Value="{DynamicResource AppAccentSubtle}"/>
  </Style>
  <Style Selector="Button.toolButton.active PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentText}"/>
  </Style>

  <!-- 范围选择：WinUI segmented 观感——无外框，选中为卡片级填充，
       未选中透明底，悬停弱填充。与 settingsRow 内联控件同语言。 -->
  <Style Selector="Button.scopeChoice">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
  </Style>
  <Style Selector="Button.scopeChoice:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>
  <Style Selector="Button.scopeChoice.selected">
    <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Expander 精修：贴 WinUI 的紧凑 disclosure，头部去闭合边框、
       改为一行悬停填充 + 右侧小箭头，内容区与父级齐平无边。 -->
  <Style Selector="Expander">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHover}"/>
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pressed">
    <Setter Property="Background" Value="{DynamicResource AppPressed}"/>
  </Style>
  <Style Selector="Expander /template/ Border#ExpanderHeaderBorder">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
  </Style>
  <Style Selector="Expander /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Padding" Value="8,4,8,8"/>
  </Style>
  <Style Selector="ListBox.workspaceList ListBoxItem">
    <Setter Property="Padding" Value="8"/>
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
    <!-- 变更面板：分段式范围开关（两个并排胶囊，选中态用底色而不是描边）。 -->
    <Style Selector="Border.scopeSwitch">
      <Setter Property="Background" Value="{DynamicResource AppInnerWell}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.scopeChip">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
    </Style>
    <Style Selector="Button.scopeChip:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
    </Style>
    <Style Selector="Button.scopeChip.selected">
      <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- 目录组标题：弱于文件行，只在悬停时给底。 -->
    <Style Selector="Button.groupRow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="Button.groupRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHover}"/>
    </Style>
    <!-- 文件行：整行可点，选中用底色 + 左侧强调条。 -->
    <Style Selector="Button.fileRow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="2,0,0,0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="Button.fileRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHover}"/>
    </Style>
    <Style Selector="Button.fileRow.selected">
      <Setter Property="Background" Value="{DynamicResource AppListSelected}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
    </Style>
    <Style Selector="TextBlock.statusMark">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextDim}"/>
      <Setter Property="Width" Value="11"/>
    </Style>
    <Style Selector="TextBlock.fileName">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
    </Style>
    <Style Selector="TextBlock.diffStatAdded">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource AppDiffAddedForeground}"/>
    </Style>
    <Style Selector="TextBlock.diffStatRemoved">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource AppDiffRemovedForeground}"/>
    </Style>
    <!-- 逐行 diff：底色表达增删，行号列固定宽度避免滚动时跳动。 -->
    <Style Selector="Border.diffRow">
      <Setter Property="Padding" Value="0,0,4,0"/>
      <Setter Property="MinHeight" Value="19"/>
    </Style>
    <Style Selector="Border.diffRow.added">
      <Setter Property="Background" Value="{DynamicResource AppDiffAddedBackground}"/>
    </Style>
    <Style Selector="Border.diffRow.removed">
      <Setter Property="Background" Value="{DynamicResource AppDiffRemovedBackground}"/>
    </Style>
    <Style Selector="TextBlock.diffGutter">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="0,0,6,0"/>
      <Setter Property="Foreground" Value="{DynamicResource AppDiffLineNumber}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.diffMarker">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Width" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextDim}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.diffMarker.added">
    <Setter Property="Foreground" Value="{DynamicResource AppDiffAddedForeground}"/>
  </Style>
  <Style Selector="TextBlock.diffMarker.removed">
    <Setter Property="Foreground" Value="{DynamicResource AppDiffRemovedForeground}"/>
  </Style>
  <!-- 变更列表的选中态自己画：默认 ListBoxItem 的强调色块在侧栏里太重。 -->
  <Style Selector="ListBox.changesList ListBoxItem">
    <Setter Property="Padding" Value="4,0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.changesList ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHover}"/>
  </Style>
  <Style Selector="ListBox.changesList ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource AppListSelected}"/>
  </Style>
  <Style Selector="ListBox.changesList ListBoxItem:selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppListSelected}"/>
  </Style>
  <!-- Fluent 的 ListBoxItem 模板自带选中底色，必须打到模板内的 ContentPresenter 才覆盖得掉。 -->
  <Style Selector="ListBox.changesList ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="ListBox.changesList ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.changesList ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppListSelected}"/>
  </Style>
  <Style Selector="ListBox.changesList ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppListSelected}"/>
  </Style>
  <Style Selector="TextBlock.diffText">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style Selector="Border.diffHunkHeader">
      <Setter Property="Background" Value="{DynamicResource AppSubtleBackground}"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style Selector="Button.diffGap">
      <Setter Property="Background" Value="{DynamicResource AppSubtleBackground}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.diffGap:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppHover}"/>
    </Style>

  <Style Selector="TextBlock.addedFlag">
    <Setter Property="Foreground" Value="{DynamicResource AppSuccessForeground}"/>
  </Style>
  <Style Selector="TextBlock.deletedFlag">
    <Setter Property="Foreground" Value="{DynamicResource AppCriticalForeground}"/>
  </Style>
  <Style Selector="TextBox.composerInput:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <!-- 悬停时 Fluent 模板会把输入框内部刷成深色，在输入卡片里像突然挖了个黑洞；
       输入区自己已有下划线反馈，这里保持透明。 -->
  <Style Selector="TextBox.composerInput:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="TextBox.composerInput:pointerover:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="TextBox.flatInput:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- 浮层通知：与菜单/弹窗同一表面、描边与阴影 -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource MenuSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource FluentToastShadow}"/>
  </Style>
  <Style Selector="Border.overlayPanel">
    <Setter Property="Background" Value="{DynamicResource AppDialogBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource FluentFlyoutShadow}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <!-- ===== 会话灵动岛（Fluent，顶栏中央活态显示）=====
       紧凑胶囊 = AppSubtleBackground 云母感 + AppCardStroke 细描边 + 16 圆角 + FluentPillShadow；
       几何/颜色变化即信号：运行呼吸点、空闲灰点、失败 critical。 -->
  <Style Selector="Border.sessionIsland">
    <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BoxShadow" Value="{DynamicResource FluentPillShadow}"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.sessionIsland:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHover}"/>
  </Style>
  <Style Selector="Border.sessionIsland TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>
  <!-- 胶囊内次级信息（模型短名/用时/用量）压暗一档：是背景信号不是主标题。 -->
  <Style Selector="Border.sessionIsland TextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
  </Style>
  <Style Selector="Border.sessionIsland PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppTextDim}"/>
  </Style>
  <!-- 状态圆点：语义色（accent 运行 / 灰空闲 / critical 失败），运行带呼吸缩放。 -->
  <Style Selector="Border.sessionIsland Border.running">
    <Setter Property="Background" Value="{DynamicResource AppAccent}"/>
    <Style.Animations>
      <Animation Duration="0:0:1.5" IterationCount="Infinite" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.45"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.sessionIsland Border.idle">
    <Setter Property="Background" Value="{DynamicResource AppTextDim}"/>
    <Setter Property="Opacity" Value="0.6"/>
  </Style>
  <Style Selector="Border.sessionIsland Border.failed">
    <Setter Property="Background" Value="{DynamicResource AppCriticalForeground}"/>
  </Style>
  <Style Selector="Border.sessionIsland Border:not(.running):not(.idle):not(.failed)">
    <Setter Property="Background" Value="{DynamicResource AppCardStroke}"/>
  </Style>
  <!-- 卫星点：次级活动（排队数）的微缩圆，仅在有排队时出现。 -->
  <Style Selector="Border.islandSatellite">
    <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BoxShadow" Value="{DynamicResource FluentPillShadow}"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.islandSatellite:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHover}"/>
    <Setter Property="RenderTransform" Value="scale(1.08)"/>
  </Style>
  <Style Selector="Border.islandSatellite TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentText}"/>
  </Style>
  <!-- 展开面板：MenuSurfaceBrush + AppCardStroke + OverlayCornerRadius + FluentFlyoutShadow。 -->
  <Style Selector="Border.islandPanel">
    <Setter Property="Background" Value="{DynamicResource MenuSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource FluentFlyoutShadow}"/>
  </Style>
  <!-- 尾指：与 panel 同底色同描边的小菱形，视觉上把 panel 锚到 pill。 -->
  <Style Selector="Border.islandPanelTail">
    <Setter Property="Background" Value="{DynamicResource MenuSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.islandPanel TextBlock.meta">
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
  </Style>
  <!-- 后端标识块：subtle 底 + accent 描边，不再实心 accent（与标题争视觉权重）。
       PathIcon 用 accent 文本色点题，不做反白。 -->
  <Style Selector="Border.islandBackendTile">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.islandBackendTile PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentText}"/>
  </Style>
  <!-- 磁贴：岛面本身已是"第 2 层"（卡片色），磁贴再用 subtle 会糊成一片；
       底降到透明 + 悬停才给填充，图标升到"第 3 层"并直接用强调色（对齐 Win11
       设置里"卡内图标用主题色"的做法），按下有短延迟 + 微形变。 -->
  <Style Selector="Button.islandTile">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09"/>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.islandTile:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHover}"/>
  </Style>
  <!-- 磁贴不用描边表达任何状态：鼠标移出窗口/无命中区时 :pointerover 可能残留，
       留下一条"白边"。模板描边恒为 0，hover/pressed 只改底色。 -->
  <Style Selector="Button.islandTile /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="Button.islandTile:pressed">
    <Setter Property="Background" Value="{DynamicResource AppPressed}"/>
    <Setter Property="RenderTransform" Value="scale(0.94)"/>
  </Style>
  <!-- 禁用态：Fluent 模板会给禁用按钮刷灰底，在岛面里像一块块补丁；
       压回透明，只用低透明度图标表达不可用。 -->
  <Style Selector="Button.islandTile:disabled">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="Button.islandTile:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="Button.islandTile:disabled PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppTextDim}"/>
    <Setter Property="Opacity" Value="0.45"/>
  </Style>
  <!-- 图标=第 3 层：强调色常驻、满不透明；悬停再提亮一档。 -->
  <Style Selector="Button.islandTile PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentText}"/>
    <Setter Property="Opacity" Value="0.92"/>
  </Style>
  <Style Selector="Button.islandTile:pointerover PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentText}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <!-- 焦点描边只给键盘导航（focus-visible）；鼠标点完移开不留白边。 -->
  <Style Selector="Button.islandTile:focus:not(:focus-visible) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <!-- 实时活动条：Subtle 浅底，失败时转 critical 边框/文字。 -->
  <Style Selector="Border.islandLiveBar">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="Padding" Value="10,8"/>
  </Style>
  <Style Selector="Border.islandLiveBar.failed">
    <Setter Property="BorderBrush" Value="{DynamicResource AppCriticalForeground}"/>
  </Style>
  <Style Selector="Border.islandLiveBar.failed TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppCriticalForeground}"/>
  </Style>
  <Style Selector="Border.islandLiveBar Border.running">
    <Setter Property="Background" Value="{DynamicResource AppAccent}"/>
  </Style>
  <Style Selector="Border.islandLiveBar Border.idle">
    <Setter Property="Background" Value="{DynamicResource AppTextDim}"/>
  </Style>
  <Style Selector="Border.islandLiveBar Border.failed">
    <Setter Property="Background" Value="{DynamicResource AppCriticalForeground}"/>
  </Style>
  <!-- Flyout 自带一层表面（底/描边/阴影）。内容里再套 .card 就会画成"两层框"，
       这里把 flyout 内的卡片降级为透明容器，只保留内边距与内容。 -->
  <Style Selector="FlyoutPresenter Border.card">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
  </Style>
  <Style Selector="MenuFlyoutPresenter Border.card">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
  </Style>
  <!-- 行悬停兜底：窗口级 PointerMoved 添加 pointerHover，覆盖所有横条类型。 -->
  <Style Selector="Border.pointerHover">
    <Setter Property="Background" Value="{DynamicResource AppListSelected}"/>
  </Style>
  <Style Selector="Grid.pointerHover">
    <Setter Property="Background" Value="{DynamicResource AppListSelected}"/>
  </Style>
  <Style Selector="Button.iconButton.pointerHover">
    <Setter Property="Background" Value="{DynamicResource AppListSelected}"/>
  </Style>
  <Style Selector="Button.subtle.pointerHover">
    <Setter Property="Background" Value="{DynamicResource AppListSelected}"/>
  </Style>
  <!-- 输入区聚焦光带：淡入淡出。 -->
  <Style Selector="Border#ComposerGlowBand">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <!-- 图标浮层提示：固定在上方，离开 0.3s 后消失（HoverTip）。 -->
  <Style Selector="Border.hoverTip">
    <Setter Property="Background" Value="{DynamicResource AppBaseBar}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardStroke}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
  </Style>
  <Style Selector="Button.pointerHover">
    <Setter Property="Background" Value="{DynamicResource AppListSelected}"/>
  </Style>
  <!-- 模型选择行：中间灰横条，悬停升高亮；与其它列表行同一套层级。 -->
  <Style Selector="Button.modelChoiceRow">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="Padding" Value="8,5"/>
  </Style>
  <Style Selector="Button.modelChoiceRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppListSelected}"/>
  </Style>
  <!-- 启动卡：深色背景上的一张中间灰卡，图标 + 品牌名 + 主操作。 -->
  <Style Selector="Border.startupCard">
    <Setter Property="Background" Value="{DynamicResource AppBaseBar}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="28,26"/>
    <Setter Property="BoxShadow" Value="{DynamicResource FluentCardShadow}"/>
  </Style>
  <Style Selector="Border.startupBadge">
    <Setter Property="Width" Value="48"/>
    <Setter Property="Height" Value="48"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Background" Value="{DynamicResource AppSubtleBackground}"/>
    <Setter Property="Padding" Value="10"/>
  </Style>
  <Style Selector="TextBlock.startupWordmark">
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>
  <!-- 危险确认按钮：透明底 + critical 描边/文字，悬停用 critical 浅底（权限升级确认）。 -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppCriticalForeground}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource AppCriticalForeground}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="Padding" Value="16,5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.083"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.083"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.danger:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppErrorBackground}"/>
  </Style>
  <Style Selector="Button.danger:pressed">
    <Setter Property="Background" Value="{DynamicResource AppErrorBackground}"/>
    <Setter Property="RenderTransform" Value="scale(0.98)"/>
  </Style>
  <Style Selector="Button.islandBarButton">
    <Setter Property="Background" Value="{DynamicResource AppHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.islandBarButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppListSelected}"/>
  </Style>

  <!-- 中央会话：元信息退为三级文字；助手正文不加卡片 -->
  <Style Selector="TextBlock.meta">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextDim}"/>
    <!-- UI-1 排版微调：会话元信息常含时间戳/计数，锁定等宽数字。 -->
    <Setter Property="FontFeatures" Value="{StaticResource AppTabularNumericFeatures}"/>
  </Style>
  <Style Selector="TextBlock.metaName">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
  </Style>
  <Style Selector="Border.turnSummary">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
    <Setter Property="BorderThickness" Value="2,0,0,0"/>
    <Setter Property="Padding" Value="12,4,0,4"/>
    <Setter Property="Margin" Value="0,10,0,0"/>
  </Style>
  <!-- 工具组：与工具卡同一视觉族，但更轻；整组折叠成一行状态。 -->
  <!-- 回合结束后被最终总结弱化的中间文字：内容保留，降低存在感。 -->
  <Style Selector="ItemsControl.absorbed">
    <Setter Property="Opacity" Value="0.62"/>
  </Style>
  <Style Selector="Border.toolGroupCard">
    <Setter Property="Background" Value="{DynamicResource AppInnerWell}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
  </Style>
  <Style Selector="Button.toolGroupHeader">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.toolGroupHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <!-- 工具状态点：小圆点 + 鲜艳语义色。 -->
  <Style Selector="Border.statusDot">
    <Setter Property="Background" Value="{DynamicResource AppTextDim}"/>
  </Style>
  <Style Selector="Border.statusDot.success">
    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
  </Style>
  <Style Selector="Border.statusDot.critical">
    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
  </Style>
  <Style Selector="Border.statusDot.attention">
    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}"/>
  </Style>
  <Style Selector="Border.statusDot.neutral">
    <Setter Property="Background" Value="{DynamicResource AppTextDim}"/>
  </Style>
  <!-- 工具卡本身也是横条：悬停升高亮。 -->
  <Style Selector="Border.toolCard.pointerHover">
    <Setter Property="Background" Value="{DynamicResource AppListSelected}"/>
  </Style>
  <Style Selector="Border.toolCard">
    <Setter Property="Background" Value="{DynamicResource AppInnerWell}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppBaseHighlight}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
  </Style>

  <!-- 左侧轮次刻度：常态低存在感，悬停或固定时高亮。 -->
  <Style Selector="Button.rulerTick">
    <Setter Property="Opacity" Value="0.5"/>
  </Style>
  <Style Selector="Button.rulerTick:pointerover">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Button.rulerTick.pinned">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Button.rulerTick.pinned TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentText}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- 沉浸式：输入区收起后的浮起按钮，压在时间线内容之上。 -->
  <Style Selector="Button.composerReveal">
    <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="15"/>
    <Setter Property="Opacity" Value="0.92"/>
  </Style>

  <!-- 消息引用 chip：链接与文件路径，低存在感但可点。 -->
  <Style Selector="Button.referenceChip">
    <Setter Property="Background" Value="{DynamicResource AppInnerWell}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="MinHeight" Value="0"/>
  </Style>
  <Style Selector="Button.referenceChip:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
  </Style>

  <!-- 变更卡：整行可点开内联 diff。 -->
  <Style Selector="Button.changeFileRow">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="Button.changeFileRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppInnerWell}"/>
  </Style>
  <Style Selector="Border.diffWell">
    <Setter Property="Background" Value="{DynamicResource AppInnerWell}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="TextBlock.diffLine">
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
  </Style>
  <Style Selector="TextBlock.diffLine.added">
    <Setter Property="Foreground" Value="{DynamicResource AppSuccessForeground}"/>
  </Style>
  <Style Selector="TextBlock.diffLine.removed">
    <Setter Property="Foreground" Value="{DynamicResource AppCriticalForeground}"/>
  </Style>
  <Style Selector="TextBlock.diffLine.note">
    <Setter Property="Foreground" Value="{DynamicResource AppTextDim}"/>
    <Setter Property="FontStyle" Value="Italic"/>
  </Style>

  <!-- 表格：去掉全网格竖线，只保留行分隔与表头强调，贴近正文排版而不是电子表格。 -->
  <Style Selector="md|MarkdownTableGrid">
    <Setter Property="ColumnSpacing" Value="0"/>
    <Setter Property="RowSpacing" Value="0"/>
  </Style>
  <Style Selector="md|MarkdownTableGrid > Border">
    <Setter Property="BorderBrush" Value="{DynamicResource AppDividerSubtle}"/>
    <Setter Property="Padding" Value="12,8"/>
  </Style>
  <Style Selector="md|MarkdownTableGrid > Border > StackPanel > md|MarkdownTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>

  <!-- 回合变更总结卡：与工具卡同一层级，但更强调"这一轮改了什么"。 -->
  <Style Selector="Border.changeCard">
    <Setter Property="Background" Value="{DynamicResource AppInnerWell}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
  </Style>
  <Style Selector="Border.changeIcon">
    <Setter Property="Background" Value="{DynamicResource AppInnerWell}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.changePath">
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.additions">
    <Setter Property="Foreground" Value="{DynamicResource AppSuccessForeground}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.deletions">
    <Setter Property="Foreground" Value="{DynamicResource AppCriticalForeground}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- 会话标尺：轮次刻度按钮，次级文字、无描边 -->
  <Style Selector="StackPanel#MessageRuler > Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextDim}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="StackPanel#MessageRuler > Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
  </Style>

  <!-- 终端：固定深色表面（ANSI 默认色与之对齐），与主题无关 -->
  <Style Selector="ScrollViewer.terminalSurface">
    <Setter Property="Background" Value="{DynamicResource AppTerminalBackground}"/>
  </Style>
  <Style Selector="Grid.terminalSurface">
    <Setter Property="Background" Value="{DynamicResource AppTerminalBackground}"/>
  </Style>

  <!-- Win11 强调色圆点：无边框、选中态靠外侧 accent 描边环。 -->
  <Style Selector="Button.accentSwatch">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.accentSwatch:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.12)"/>
  </Style>
  <Style Selector="Button.accentSwatch.selected">
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
  </Style>
</Styles>
