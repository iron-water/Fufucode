<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fufucode.App.ViewModels"
             xmlns:bx="using:Fufucode.App.Features.BrowserExperience"
             xmlns:ib="using:Fufucode.App.Infrastructure.Browser"
             x:Class="Fufucode.App.Views.BrowserView" x:DataType="vm:BrowserViewModel"
             AutomationProperties.Name="内置浏览器">
  <Grid Classes="browserShell" RowDefinitions="Auto,Auto,Auto,2,*">
    <Grid Classes="browserTabsStrip" ColumnDefinitions="*,Auto">
      <ScrollViewer x:Name="BrowserTabScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="BrowserTabs" ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="bx:BrowserTab">
              <Border Classes="browserTabRow" Classes.selected="{Binding IsSelected}">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <Button Classes="browserTab" Classes.selected="{Binding IsSelected}"
                          Command="{Binding $parent[ItemsControl].((vm:BrowserViewModel)DataContext).SelectTabByIdCommand}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding TabHeader}" AutomationProperties.HelpText="{Binding LifecycleText}"
                          PointerPressed="Tab_PointerPressed" PointerMoved="Tab_PointerMoved" PointerReleased="Tab_PointerReleased">
                    <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                      <Panel VerticalAlignment="Center">
                        <PathIcon Data="{DynamicResource Icon.Globe}" Width="{StaticResource BrowserSmallIconSize}" Height="{StaticResource BrowserSmallIconSize}" IsVisible="{Binding !HasFavicon}"/>
                        <Image Source="{Binding FaviconSource}" Width="{StaticResource BrowserIconSize}" Height="{StaticResource BrowserIconSize}" IsVisible="{Binding HasFavicon}"/>
                      </Panel>
                      <TextBlock Grid.Column="1" Classes="browserTabTitle" Text="{Binding TabHeader}"/>
                    </Grid>
                  </Button>
                  <Button Grid.Column="1" Classes="browserAudio" Classes.active="{Binding IsMuted}" IsVisible="{Binding ShowsAudio}"
                          Command="{Binding ToggleMuteCommand}" AutomationProperties.Name="浏览器页签静音">
                    <PathIcon Data="{DynamicResource Icon.Speaker}" Width="{StaticResource BrowserSmallIconSize}" Height="{StaticResource BrowserSmallIconSize}"/>
                  </Button>
                  <Button Grid.Column="2" Classes="browserTabClose"
                          Command="{Binding $parent[ItemsControl].((vm:BrowserViewModel)DataContext).CloseTabByIdCommand}" CommandParameter="{Binding}"
                          AutomationProperties.Name="关闭浏览器页签">
                    <PathIcon Data="{DynamicResource Icon.Dismiss}" Width="{StaticResource BrowserSmallIconSize}" Height="{StaticResource BrowserSmallIconSize}"/>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Button Grid.Column="1" Classes="browserTool" Command="{Binding NewTabCommand}" AutomationProperties.Name="浏览器新建页签">
        <PathIcon Data="{DynamicResource Icon.Add}" Width="{StaticResource BrowserIconSize}" Height="{StaticResource BrowserIconSize}"/>
      </Button>
    </Grid>
    <Grid Grid.Row="1" x:Name="BrowserToolbar" Classes="browserToolbar" ColumnDefinitions="Auto,*,Auto">
      <StackPanel Orientation="Horizontal">
        <Button Classes="browserTool" Command="{Binding BackCommand}" AutomationProperties.Name="浏览器后退"><PathIcon Data="{DynamicResource Icon.ArrowLeft}" Width="{StaticResource BrowserIconSize}" Height="{StaticResource BrowserIconSize}"/></Button>
        <Button Classes="browserTool" Command="{Binding ForwardCommand}" AutomationProperties.Name="浏览器前进"><PathIcon Data="{DynamicResource Icon.ArrowRight}" Width="{StaticResource BrowserIconSize}" Height="{StaticResource BrowserIconSize}"/></Button>
        <Panel>
          <Button Classes="browserTool" Command="{Binding ReloadCommand}" IsVisible="{Binding !IsLoading}" AutomationProperties.Name="浏览器刷新"><PathIcon Data="{DynamicResource Icon.ArrowClockwise}" Width="{StaticResource BrowserIconSize}" Height="{StaticResource BrowserIconSize}"/></Button>
          <Button Classes="browserTool" Command="{Binding StopCommand}" IsVisible="{Binding IsLoading}" AutomationProperties.Name="浏览器停止"><PathIcon Data="{DynamicResource Icon.Dismiss}" Width="{StaticResource BrowserIconSize}" Height="{StaticResource BrowserIconSize}"/></Button>
        </Panel>
      </StackPanel>
      <TextBox Grid.Column="1" x:Name="AddressBox" Classes="searchInput browserAddress" Text="{Binding AddressInput}"
               PlaceholderText="搜索或输入网址" KeyDown="Address_KeyDown" GotFocus="Address_GotFocus" LostFocus="Address_LostFocus"
               AutomationProperties.Name="浏览器地址栏">
        <TextBox.InnerLeftContent>
          <Panel Width="20" IsVisible="{Binding ShowSecurity}" AutomationProperties.Name="{Binding SecurityToolTip}">
            <PathIcon Data="{DynamicResource Icon.ShieldCheckmark}" Width="{StaticResource BrowserSmallIconSize}" Height="{StaticResource BrowserSmallIconSize}" IsVisible="{Binding IsSecure}" Foreground="{DynamicResource AppTextSecondary}"/>
            <PathIcon Data="{DynamicResource Icon.ShieldError}" Width="{StaticResource BrowserSmallIconSize}" Height="{StaticResource BrowserSmallIconSize}" IsVisible="{Binding IsInsecure}" Foreground="{DynamicResource AppCautionForeground}"/>
          </Panel>
        </TextBox.InnerLeftContent>
      </TextBox>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Classes="browserTool" Classes.active="{Binding IsCurrentBookmarked}" IsVisible="{Binding ShowWideTools}" Command="{Binding ToggleBookmarkCommand}" AutomationProperties.Name="浏览器收藏当前页面"><PathIcon Data="{DynamicResource Icon.Pin}" Width="{StaticResource BrowserIconSize}" Height="{StaticResource BrowserIconSize}"/></Button>
        <Button Classes="browserTool" IsVisible="{Binding ShowWideTools}" Command="{Binding ToggleHistoryCommand}" AutomationProperties.Name="浏览器历史"><PathIcon Data="{DynamicResource Icon.History}" Width="{StaticResource BrowserIconSize}" Height="{StaticResource BrowserIconSize}"/></Button>
        <Button Classes="browserTool" IsVisible="{Binding ShowWideTools}" Click="Download_Click" AutomationProperties.Name="浏览器下载"><PathIcon Data="{DynamicResource Icon.ArrowDownload}" Width="{StaticResource BrowserIconSize}" Height="{StaticResource BrowserIconSize}"/></Button>
        <Button Classes="browserTool" IsVisible="{Binding ShowWideTools}" Command="{Binding ToggleFullViewCommand}" AutomationProperties.Name="浏览器全宽查看"><PathIcon Data="{DynamicResource Icon.FullScreenMaximize}" Width="{StaticResource BrowserIconSize}" Height="{StaticResource BrowserIconSize}"/></Button>
        <Button Classes="browserTool" Click="Annotate_Click" IsEnabled="{Binding CanAnnotate}" AutomationProperties.Name="浏览器标注"><PathIcon Data="{DynamicResource Icon.Edit}" Width="{StaticResource BrowserIconSize}" Height="{StaticResource BrowserIconSize}"/></Button>
        <Button x:Name="MoreButton" Classes="browserTool" Click="More_Click" AutomationProperties.Name="浏览器更多操作"><PathIcon Data="{DynamicResource Icon.More}" Width="{StaticResource BrowserIconSize}" Height="{StaticResource BrowserIconSize}"/></Button>
      </StackPanel>
      <!-- 强制原生 PopupRoot，避免 WebView2 子 HWND 遮住 Avalonia overlay。 -->
      <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding #AddressBox}" Placement="BottomEdgeAlignedLeft" ShouldUseOverlayLayer="False"
             IsOpen="{Binding IsSuggestionsOpen, Mode=TwoWay}" IsLightDismissEnabled="True">
        <Border Classes="browserPopup suggestions" Width="{Binding PanelWidth}">
          <ListBox x:Name="SuggestionList" Classes="browserSuggestions" ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="bx:BrowserSuggestion">
                <Button Classes="browserListRow" Command="{Binding $parent[ListBox].((vm:BrowserViewModel)DataContext).AcceptSuggestionCommand}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Header}">
                  <Grid ColumnDefinitions="16,*" ColumnSpacing="12">
                    <PathIcon Data="{DynamicResource Icon.History}" Width="{StaticResource BrowserIconSize}" Height="{StaticResource BrowserIconSize}"/>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis"/><TextBlock Classes="browserMeta" Text="{Binding Address}"/></StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Popup>
      <Popup x:Name="HistoryPopup" PlacementTarget="{Binding #BrowserToolbar}" Placement="BottomEdgeAlignedRight" ShouldUseOverlayLayer="False"
             IsOpen="{Binding IsHistoryOpen, Mode=TwoWay}" IsLightDismissEnabled="True">
        <Border x:Name="HistorySurface" Classes="browserPopup" Width="{Binding PanelWidth}">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="browserHeading" Text="浏览历史" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="browserTool" Command="{Binding CloseHistoryCommand}" AutomationProperties.Name="关闭浏览历史"><PathIcon Data="{DynamicResource Icon.Dismiss}" Width="{StaticResource BrowserIconSize}" Height="{StaticResource BrowserIconSize}"/></Button></Grid>
            <TextBox Grid.Row="1" x:Name="HistorySearch" Classes="searchInput" Text="{Binding HistoryQuery}" PlaceholderText="搜索历史" AutomationProperties.Name="搜索浏览历史"/>
            <Grid Grid.Row="2">
              <TextBlock Classes="browserMeta" Text="{Binding HistoryEmptyText}" IsVisible="{Binding !HasHistoryEntries}" Margin="8,16"/>
              <ListBox ItemsSource="{Binding HistoryEntries}" Background="Transparent" BorderThickness="0" IsVisible="{Binding HasHistoryEntries}" MaxHeight="320">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="ib:BrowserHistoryEntry">
                    <Grid ColumnDefinitions="*,Auto">
                      <Button Classes="browserListRow" Command="{Binding $parent[ListBox].((vm:BrowserViewModel)DataContext).OpenHistoryEntryCommand}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                        <StackPanel Spacing="4"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Classes="browserMeta" Text="{Binding Address}"/></StackPanel>
                      </Button>
                      <Button Grid.Column="1" Classes="browserTool" Command="{Binding $parent[ListBox].((vm:BrowserViewModel)DataContext).RemoveHistoryEntryCommand}" CommandParameter="{Binding}" AutomationProperties.Name="删除历史记录"><PathIcon Data="{DynamicResource Icon.Dismiss}" Width="{StaticResource BrowserSmallIconSize}" Height="{StaticResource BrowserSmallIconSize}"/></Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Grid>
        </Border>
      </Popup>
      <Popup x:Name="DownloadsPopup" PlacementTarget="{Binding #BrowserToolbar}" Placement="BottomEdgeAlignedRight" ShouldUseOverlayLayer="False"
             IsOpen="{Binding IsDownloadsOpen, Mode=TwoWay}" IsLightDismissEnabled="True">
        <Border x:Name="DownloadsSurface" Classes="browserPopup" Width="{Binding PanelWidth}">
          <Grid RowDefinitions="Auto,*" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="browserHeading" Text="下载" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="browserTool" Command="{Binding CloseDownloadsCommand}" AutomationProperties.Name="关闭下载列表"><PathIcon Data="{DynamicResource Icon.Dismiss}" Width="{StaticResource BrowserIconSize}" Height="{StaticResource BrowserIconSize}"/></Button></Grid>
            <Grid Grid.Row="1">
              <TextBlock Classes="browserMeta" Text="暂无下载" Margin="8,16" IsVisible="{Binding !HasDownloads}"/>
              <ListBox ItemsSource="{Binding Downloads}" Background="Transparent" BorderThickness="0" IsVisible="{Binding HasDownloads}" MaxHeight="320">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="bx:BrowserDownloadItem">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,8">
                      <StackPanel Spacing="4"><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/><TextBlock Classes="browserMeta" Text="{Binding ProgressText}"/><ProgressBar Classes="browserLoading" Value="{Binding ProgressPercent}" IsIndeterminate="{Binding IsIndeterminate}" IsVisible="{Binding IsActive}"/></StackPanel>
                      <Button Grid.Column="1" Classes="browserTool" IsVisible="{Binding IsCompleted}" Click="OpenDownloadFolder_Click" Tag="{Binding ResultFilePath}" AutomationProperties.Name="打开下载文件夹"><PathIcon Data="{DynamicResource Icon.Folder}" Width="{StaticResource BrowserIconSize}" Height="{StaticResource BrowserIconSize}"/></Button>
                      <Button Grid.Column="2" Classes="browserTool" IsVisible="{Binding CanCancel}" Click="CancelDownload_Click" Tag="{Binding Id}" AutomationProperties.Name="取消下载"><PathIcon Data="{DynamicResource Icon.Dismiss}" Width="{StaticResource BrowserSmallIconSize}" Height="{StaticResource BrowserSmallIconSize}"/></Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Grid>
        </Border>
      </Popup>
      <Popup PlacementTarget="{Binding #BrowserToolbar}" Placement="BottomEdgeAlignedRight" ShouldUseOverlayLayer="False" IsOpen="{Binding IsFeedbackOpen, Mode=TwoWay}" IsLightDismissEnabled="True">
        <Border Classes="browserPopup" Width="{Binding PanelWidth}"><TextBlock Text="{Binding FeedbackText}" TextWrapping="Wrap"/></Border>
      </Popup>
    </Grid>
    <Border Grid.Row="2" Classes="browserFindBar" IsVisible="{Binding IsFindOpen}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="4">
        <TextBox x:Name="FindBox" Classes="searchInput" Text="{Binding FindQuery}" PlaceholderText="页内查找" KeyDown="Find_KeyDown" AutomationProperties.Name="浏览器查找输入"/>
        <TextBlock Grid.Column="1" Classes="browserMeta" Text="{Binding FindStatus}" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Classes="browserTool" Command="{Binding FindPreviousCommand}" AutomationProperties.Name="浏览器查找上一个"><PathIcon Data="{DynamicResource Icon.ChevronUp}" Width="{StaticResource BrowserSmallIconSize}" Height="{StaticResource BrowserSmallIconSize}"/></Button>
        <Button Grid.Column="3" Classes="browserTool" Command="{Binding FindNextCommand}" AutomationProperties.Name="浏览器查找下一个"><PathIcon Data="{DynamicResource Icon.ChevronDown}" Width="{StaticResource BrowserSmallIconSize}" Height="{StaticResource BrowserSmallIconSize}"/></Button>
        <Button Grid.Column="4" Classes="browserTool" Command="{Binding CloseFindCommand}" AutomationProperties.Name="浏览器关闭查找"><PathIcon Data="{DynamicResource Icon.Dismiss}" Width="{StaticResource BrowserSmallIconSize}" Height="{StaticResource BrowserSmallIconSize}"/></Button>
      </Grid>
    </Border>
    <ProgressBar Grid.Row="3" Classes="browserLoading" IsIndeterminate="{Binding AnimateLoading}" Value="50" IsVisible="{Binding IsLoading}"/>
    <Grid Grid.Row="4">
      <Border Classes="browserState" IsVisible="{Binding IsPageEmpty}">
        <StackPanel Classes="browserStateBody">
          <PathIcon Classes="browserStateIcon" Data="{DynamicResource Icon.Globe}"/>
          <TextBlock Classes="browserStateTitle" Text="新标签页"/>
          <Button Content="打开文件" Click="OpenFile_Click" HorizontalAlignment="Center" AutomationProperties.Name="浏览器打开文件"/>
        </StackPanel>
      </Border>
      <Grid x:Name="HostLayer"/>
      <Border Classes="browserState" IsVisible="{Binding IsRestoring}">
        <StackPanel Classes="browserStateBody"><TextBlock Classes="browserStateTitle" Text="正在恢复页面"/><Button Content="停止" Command="{Binding StopCommand}" HorizontalAlignment="Center"/></StackPanel>
      </Border>
      <Border Classes="browserState" IsVisible="{Binding HasPageError}">
        <StackPanel Classes="browserStateBody"><PathIcon Classes="browserStateIcon" Data="{DynamicResource Icon.ShieldError}"/><TextBlock Classes="browserStateTitle" Text="无法打开页面"/><TextBlock Classes="browserMeta" Text="{Binding PageError}" TextWrapping="Wrap" TextAlignment="Center"/><Button Content="重试" Click="Retry_Click" HorizontalAlignment="Center"/></StackPanel>
      </Border>
      <Border Classes="browserState" IsVisible="{Binding HasRuntimeNotice}">
        <StackPanel Classes="browserStateBody"><PathIcon Classes="browserStateIcon" Data="{DynamicResource Icon.Globe}"/><TextBlock Classes="browserStateTitle" Text="浏览器运行时不可用"/><TextBlock Classes="browserMeta" Text="{Binding RuntimeMessage}" TextWrapping="Wrap"/><Button Content="下载 WebView2" Click="OpenRuntimeDownload_Click" HorizontalAlignment="Center"/><Button Content="复制下载链接" Click="CopyRuntimeLink_Click" HorizontalAlignment="Center"/></StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
