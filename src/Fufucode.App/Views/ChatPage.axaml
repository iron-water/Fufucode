<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:imaging="using:Avalonia.Media.Imaging"
             xmlns:vm="using:Fufucode.App.ViewModels"
             xmlns:anim="using:Fufucode.App.Infrastructure"
             xmlns:views="using:Fufucode.App.Views"
             x:Class="Fufucode.App.Views.ChatPage"
             x:DataType="{x:Type vm:MainViewModel}"
             Background="{DynamicResource AppMicaPageBackground}">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- 空态插画按主题取对应位图（G 资产，透明底） -->
        <ResourceDictionary x:Key="Light">
          <imaging:Bitmap x:Key="EmptyArt">avares://Fufucode.App/Assets/Brand/empty/conversation-light@2x.png</imaging:Bitmap>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <imaging:Bitmap x:Key="EmptyArt">avares://Fufucode.App/Assets/Brand/empty/conversation-dark@2x.png</imaging:Bitmap>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*">

    <!-- 会话头：标题/项目/单一活动摘要，连接与模型详情进入局部浮层。 -->
    <Border x:Name="ConversationHeader" Grid.Row="0" MinHeight="64" Padding="20,8,16,8"
            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="ConversationTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{Binding Sidebar.SelectedSession.Title, FallbackValue='会话'}"
                       ToolTip.Tip="{Binding Sidebar.SelectedSession.Title}" IsVisible="{Binding !Sidebar.IsRenaming}"/>
            <Button Grid.Column="1" Classes="iconButton" Command="{Binding Sidebar.BeginRenameCommand}"
                    IsVisible="{Binding Sidebar.IsReal}" ToolTip.Tip="重命名会话">
              <PathIcon Data="{DynamicResource Icon.Edit}" Width="14" Height="14"/>
            </Button>
            <TextBox x:Name="RenameBox" Grid.ColumnSpan="2" MaxWidth="360" HorizontalAlignment="Stretch"
                     Text="{Binding Sidebar.RenameDraft}" IsVisible="{Binding Sidebar.IsRenaming}" KeyDown="RenameBox_KeyDown"/>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Classes="caption" Text="{Binding Sidebar.ProjectName}" IsVisible="{Binding Sidebar.HasProject}"
                       ToolTip.Tip="{Binding Sidebar.ProjectText}"/>
            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding StatusBar.ActivityText}"/>
          </Grid>
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <!-- 会话后端由顶栏会话岛展示（图标 + 名称），这里不再重复徽标。 -->
          <Button Classes="iconButton" Width="30" Height="30" Command="{Binding ToggleRemoteControlCommand}" ToolTip.Tip="手机远程控制 (WorkBuddy 对标)"><PathIcon Data="{DynamicResource Icon.Phone}" Width="15" Height="15"/></Button>
          <Button x:Name="HeaderActionsButton" Classes="iconButton" Width="30" Height="30" ToolTip.Tip="会话操作"><PathIcon Data="{DynamicResource Icon.More}" Width="16" Height="16"/></Button>
          <Button Classes="iconButton" Width="30" Height="30" Click="FindConversation_Click" ToolTip.Tip="查找本会话"><PathIcon Data="{DynamicResource Icon.Search}" Width="15" Height="15"/></Button>
          <Button x:Name="SessionDetailsButton" Classes="iconButton" Width="32" Height="32"
                  ToolTip.Tip="会话详情" AutomationProperties.Name="会话详情">
            <PathIcon Data="{DynamicResource Icon.Info}" Width="16" Height="16"/>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel MinWidth="240" MaxWidth="360" Spacing="12" Margin="8">
                  <TextBlock Classes="bodyStrong" Text="会话详情"/>
                  <TextBlock Classes="caption" Text="{Binding StatusBar.ConnectionText}" TextWrapping="Wrap"/>
                  <TextBlock Classes="body" Text="{Binding StatusBar.ModelText}" TextWrapping="Wrap"/>
                  <TextBlock Classes="caption" Text="{Binding StatusBar.ApprovalText}" TextWrapping="Wrap"
                             IsVisible="{Binding StatusBar.IsApprovalVisible}"/>
                  <TextBlock Classes="caption" Text="{Binding StatusBar.ApprovalTooltip}" TextWrapping="Wrap"
                             IsVisible="{Binding StatusBar.IsApprovalVisible}"/>
                  <TextBlock Classes="caption" Text="{Binding StatusBar.QueueText}" IsVisible="{Binding StatusBar.HasQueue}"/>
                  <TextBlock Classes="caption" Text="{Binding StatusBar.ExtensionStatusText}" IsVisible="{Binding StatusBar.HasExtensionStatus}" TextWrapping="Wrap"/>
                  <TextBlock Classes="caption" Text="{Binding StatusBar.OutcomeText}" IsVisible="{Binding StatusBar.HasOutcome}"/>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 时间线 + 输入区（x:Name 供抽屉避让带度量：输入区上沿相对本页顶端） -->
    <Grid x:Name="ConversationBody" Grid.Row="1" RowDefinitions="*,Auto">

      <Grid x:Name="TimelineArea" Grid.Row="0" ColumnDefinitions="Auto,*">
        <StackPanel x:Name="MessageRuler" Width="34" Spacing="2" IsVisible="False"
                    VerticalAlignment="Center" Margin="4,0,4,0"/>
        <!-- 空态插画：时间线为空时居中显示（G 资产，按主题切换） -->
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="6" IsVisible="{Binding Timeline.IsEmpty}">
          <Image Source="{DynamicResource EmptyArt}" Width="160" Height="100"
                 HorizontalAlignment="Center"/>
          <TextBlock Classes="bodyStrong" Text="开始新的对话" HorizontalAlignment="Center"/>
          <TextBlock Classes="caption" Foreground="{DynamicResource AppTextSecondary}"
                     Text="{Binding ModeText}"
                     HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                     TextAlignment="Center"/>
        </StackPanel>
        <ScrollViewer x:Name="TimelineScroller"
                      Grid.Column="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      ScrollChanged="TimelineScroller_ScrollChanged">
          <ItemsControl x:Name="TimelineItems" ItemsSource="{Binding Timeline.Entries}"
                        MaxWidth="768" Margin="0" Padding="24,20,24,32"
                        HorizontalAlignment="Stretch">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <!-- 不使用虚拟化：消息容器被回收重建会让代码块重新做语法高亮，
                     滚动经过时表现为闪烁与位置跳动。会话长度可接受，稳定优先。 -->
                <StackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.DataTemplates>

              <!-- 用户消息：右对齐 accent 低透明气泡 + person 图标 -->
              <DataTemplate DataType="vm:UserMessageViewModel" x:DataType="vm:UserMessageViewModel">
                <StackPanel Margin="0,6" Loaded="OnMessageEntryLoaded">
                  <Grid ColumnDefinitions="*,24" ColumnSpacing="8">
                    <Border Classes="userBubble" Classes.pending="{Binding IsPending}" Classes.failed="{Binding IsFailed}"
                            HorizontalAlignment="Right" AutomationProperties.AutomationId="MSG-USER-BUBBLE">
                      <views:RichMarkdownView Classes="body" FontSize="14"
                                              Markdown="{Binding Text}"
                                              ImageBasePath="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ProjectRootPath}" />
                    </Border>
                    <Border Grid.Column="1" Classes="avatar" AutomationProperties.AutomationId="MSG-USER-AVATAR" Width="24" Height="24" CornerRadius="{DynamicResource AppCornerAvatarUser}" VerticalAlignment="Top" IsVisible="{DynamicResource UiShowAvatars}"
                            Background="{DynamicResource AppAccentSubtle}">
                      <PathIcon Data="{DynamicResource Icon.Person}" Width="14" Height="14"
                                Foreground="{DynamicResource AppAccentText}"/>
                    </Border>
                  </Grid>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,32,0">
                    <TextBlock Text="{DynamicResource UiUserName}" Classes="metaName" IsVisible="{DynamicResource UiShowUserNames}"/>
                    <Panel IsVisible="{DynamicResource UiShowMessageTimes}">
                      <TextBlock Text="{Binding TimeText}" Classes="meta" VerticalAlignment="Center" IsVisible="{Binding HasTime}"/>
                    </Panel>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,2,32,0">
                    <TextBlock Classes="meta" Text="发送中…" IsVisible="{Binding ShowAckHint}"/>
                    <TextBlock Classes="meta" Text="发送失败" IsVisible="{Binding IsFailed}"
                               Foreground="{DynamicResource AppCriticalForeground}"/>
                  </StackPanel>
                  <views:MessageActionsView HorizontalAlignment="Right"/>
                </StackPanel>
              </DataTemplate>

              <!-- 助手消息：28px 圆形 sparkle 头像 + 块列表 -->
              <DataTemplate DataType="vm:AssistantMessageViewModel" x:DataType="vm:AssistantMessageViewModel">
                <Grid Margin="0,6" ColumnDefinitions="Auto,*" Loaded="OnMessageEntryLoaded">
                  <Border Grid.Column="0" Classes="avatar" AutomationProperties.AutomationId="MSG-ASSISTANT-AVATAR" Width="28" Height="28" CornerRadius="{DynamicResource AppCornerAvatarAssistant}" IsVisible="{DynamicResource UiShowAvatars}"
                          VerticalAlignment="Top" Margin="0,2,0,0"
                          Background="{DynamicResource AppAccentSubtle}">
                    <PathIcon Data="{DynamicResource Icon.Sparkle}" Width="16" Height="16"
                              Foreground="{DynamicResource AppAccentText}"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" AutomationProperties.AutomationId="MSG-ASSISTANT-BUBBLE">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,4">
                      <TextBlock Classes="metaName" Text="{DynamicResource UiAssistantName}" IsVisible="{DynamicResource UiShowAssistantNames}"/>
                      <TextBlock Classes="meta" Text="{Binding HeaderStatusText}" VerticalAlignment="Center"
                                 IsVisible="{Binding IsStreaming}"/>
                      <views:ActivityDots Width="18" VerticalAlignment="Center"
                                          IsVisible="{Binding ShowAwaitingIndicator}"/>
                      <TextBlock Classes="meta" Text="{Binding AwaitingText}" VerticalAlignment="Center"
                                 IsVisible="{Binding ShowAwaitingIndicator}"/>
                      <Panel IsVisible="{DynamicResource UiShowMessageTimes}">
                        <TextBlock Classes="meta" VerticalAlignment="Center" Text="{Binding TimeText}" IsVisible="{Binding HasTime}"/>
                      </Panel>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding DisplayBlocks}">
                      <ItemsControl.DataTemplates>

                        <!-- 文本块（含代码块分段） -->
                        <DataTemplate DataType="vm:TextBlockViewModel" x:DataType="vm:TextBlockViewModel">
                          <ItemsControl ItemsSource="{Binding Segments}"
                                        Classes.absorbed="{Binding IsAbsorbed}">
                            <ItemsControl.DataTemplates>
                              <!-- 富文本：Markdown 表格、LaTeX、Mermaid、图片与 SVG 由同一个渲染器处理。 -->
                              <DataTemplate DataType="vm:PlainSegmentViewModel" x:DataType="vm:PlainSegmentViewModel">
                                <views:RichMarkdownView Classes="body" FontSize="14" Margin="0,2"
                                                        Markdown="{Binding Text}"
                                                        ImageBasePath="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ProjectRootPath}" />
                              </DataTemplate>
                              <!-- 插件富内容：```ui 等围栏由插件渲染；插件缺失时显示原文。 -->
                              <DataTemplate DataType="vm:PluginContentSegmentViewModel" x:DataType="vm:PluginContentSegmentViewModel">
                                <views:PluginContentView Language="{Binding Language}"
                                                         Payload="{Binding Payload}" Margin="0,4"/>
                              </DataTemplate>
                              <DataTemplate DataType="vm:CodeSegmentViewModel" x:DataType="vm:CodeSegmentViewModel">
                                <Border Classes="codeCard" Margin="0,4" Loaded="OnTransientBlockLoaded">
                                  <StackPanel>
                                    <!-- 头部条：语言名 + 复制 -->
                                    <!-- UI-1：容器内结构划分用单向 1px 发丝细线（6% 白/黑），不用闭合框。 -->
                                    <Border Padding="10,6" BorderBrush="{DynamicResource AppDividerSubtle}"
                                            BorderThickness="0,0,0,1">
                                      <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Classes="iconButton" Width="26" Height="22"
                                                Command="{Binding CopyCommand}" ToolTip.Tip="复制代码">
                                          <PathIcon Data="{DynamicResource Icon.Copy}" Width="13" Height="13"
                                                    Foreground="{DynamicResource AppTextDim}"/>
                                        </Button>
                                        <TextBlock Classes="caption" VerticalAlignment="Center"
                                                   Text="{Binding Language, FallbackValue='代码'}"/>
                                      </DockPanel>
                                    </Border>
                                    <views:HighlightedCodeView Code="{Binding Code}" Language="{Binding Language}"
                                                               IsExpanded="{Binding IsExpanded}" Margin="12,8" />
                                    <Button Classes="subtle" Content="{Binding ExpandLabel}"
                                            Command="{Binding ToggleExpandCommand}"
                                            Click="OnBlockLayoutToggled"
                                            IsVisible="{Binding CanCollapse}" Margin="6,0,6,6"
                                            HorizontalAlignment="Left"/>
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.DataTemplates>
                          </ItemsControl>
                        </DataTemplate>

                        <!-- 轻量可折叠思考块 -->
                        <DataTemplate DataType="vm:ThinkingBlockViewModel" x:DataType="vm:ThinkingBlockViewModel">
                          <Border Classes="thinkingBlock" Margin="0,4">
                            <StackPanel>
                              <Button Classes="subtle" Command="{Binding ToggleExpandedCommand}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                      Padding="10,7">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <PathIcon Data="{DynamicResource Icon.Brain}" Width="15" Height="15"
                                            Foreground="{DynamicResource AppTextSecondary}"/>
                                  <TextBlock Classes="caption" Text="思考过程" VerticalAlignment="Center"/>
                                  <PathIcon Data="{DynamicResource Icon.ChevronUp}" Width="12" Height="12"
                                            VerticalAlignment="Center" Foreground="{DynamicResource AppTextDim}"
                                            IsVisible="{Binding IsExpanded}"/>
                                  <PathIcon Data="{DynamicResource Icon.ChevronDown}" Width="12" Height="12"
                                            VerticalAlignment="Center" Foreground="{DynamicResource AppTextDim}"
                                            IsVisible="{Binding IsCollapsed}"/>
                                </StackPanel>
                              </Button>
                              <views:CollapsiblePanel IsExpanded="{Binding IsExpanded}">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="10,0,10,10"
                                           Classes="caption"
                                           Foreground="{DynamicResource AppTextSecondary}"/>
                              </views:CollapsiblePanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>

                        <!-- 工具组：连续工具调用折叠成一行；运行中显示动态状态 -->
                        <DataTemplate DataType="vm:ToolGroupViewModel" x:DataType="vm:ToolGroupViewModel">
                          <Border Classes="toolGroupCard" Margin="0,4">
                            <StackPanel>
                              <Button Classes="toolGroupHeader" Click="OnToolGroupClicked"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      Padding="10,7">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                  <PathIcon Grid.Column="0" Data="{DynamicResource Icon.Wrench}" Width="14" Height="14"
                                            VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}"/>
                                  <views:ActivityDots Grid.Column="1" Width="18" VerticalAlignment="Center"
                                                      IsVisible="{Binding IsActive}"/>
                                  <TextBlock Grid.Column="2" Classes="caption" Text="{Binding SummaryText}"
                                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                  <TextBlock Grid.Column="3" Classes="meta" Text="{Binding ExpandGlyph}"
                                             VerticalAlignment="Center"/>
                                </Grid>
                              </Button>
                              <TextBlock Classes="meta mono" Text="{Binding LatestHint, StringFormat='  └ {0}'}"
                                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                         Margin="30,0,12,6" IsVisible="{Binding HasHint}"/>
                              <views:CollapsiblePanel IsExpanded="{Binding IsExpanded}" Margin="0,0,0,6">
                              <ItemsControl ItemsSource="{Binding Tools}">
                                <ItemsControl.DataTemplates>
                                  <DataTemplate DataType="vm:ToolCallBlockViewModel" x:DataType="vm:ToolCallBlockViewModel">
                                    <Border Classes="toolCard" Margin="10,3" Loaded="OnTransientBlockLoaded">
                                      <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,7,12,3">
                                          <TextBlock Classes="mono" FontSize="12" FontWeight="SemiBold"
                                                     Text="{Binding ToolName}" VerticalAlignment="Center"/>
                                          <Border Classes="badge"
                                                  Classes.attention="{Binding BadgeIsAttention}"
                                                  Classes.success="{Binding BadgeIsSuccess}"
                                                  Classes.critical="{Binding BadgeIsCritical}"
                                                  Classes.neutral="{Binding BadgeIsNeutral}">
                                            <TextBlock Text="{Binding StatusText, FallbackValue='运行中'}"/>
                                          </Border>
                                          <TextBlock Classes="meta tabularNumeric" Text="{Binding DurationText}"
                                                     IsVisible="{Binding HasDuration}" VerticalAlignment="Center"/>
                                          <Button Classes="iconButton" Width="22" Height="18" Padding="0"
                                                  Click="OnCopyToolOutput" IsVisible="{Binding HasOutput}"
                                                  ToolTip.Tip="复制工具输出">
                                            <PathIcon Data="{DynamicResource Icon.Copy}" Width="11" Height="11"
                                                      Foreground="{DynamicResource AppTextDim}"/>
                                          </Button>
                                        </StackPanel>
                                        <TextBlock Classes="caption mono" Text="{Binding InputJson}"
                                                   TextWrapping="Wrap" MaxLines="3" Margin="12,0,12,4"
                                                   Foreground="{DynamicResource AppTextDim}"/>
                                        <views:ToolImageView SourceText="{Binding ImageOutputSource}"
                                                           IsVisible="{Binding HasImageOutput}" Margin="12,0,12,8"/>
                                        <Border Classes="nestedFill" Margin="12,0,12,8" IsVisible="{Binding ShowTextOutput}">
                                          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                        VerticalScrollBarVisibility="Auto"
                                                        MaxHeight="{Binding OutputMaxHeight}" Padding="10,6">
                                            <views:ToolOutputView FontSize="12"
                                                                  Foreground="{DynamicResource AppTextSecondary}"
                                                                  Output="{Binding Output}"/>
                                          </ScrollViewer>
                                        </Border>
                                      </StackPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.DataTemplates>
                              </ItemsControl>
                              </views:CollapsiblePanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>

                        <!-- 工具卡片（未分组的单次调用） -->
                        <DataTemplate DataType="vm:ToolCallBlockViewModel" x:DataType="vm:ToolCallBlockViewModel">
                          <Border Classes="toolCard" Margin="0,4" Loaded="OnTransientBlockLoaded">
                            <StackPanel>
                              <!-- 头部行：wrench + 工具名 + 状态徽章 -->
                              <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,8,12,4">
                                <PathIcon Data="{DynamicResource Icon.Wrench}" Width="14" Height="14"
                                          VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}"/>
                                <TextBlock Classes="mono" FontSize="12.5" FontWeight="SemiBold" Text="{Binding ToolName}" VerticalAlignment="Center"/>
                                <Border Classes="badge"
                                        Classes.attention="{Binding BadgeIsAttention}"
                                        Classes.success="{Binding BadgeIsSuccess}"
                                        Classes.critical="{Binding BadgeIsCritical}"
                                        Classes.neutral="{Binding BadgeIsNeutral}">
                                  <TextBlock Text="{Binding StatusText, FallbackValue='运行中'}"/>
                                </Border>
                                <TextBlock Classes="meta tabularNumeric" Text="{Binding DurationText}"
                                           IsVisible="{Binding HasDuration}" VerticalAlignment="Center"/>
                                <Button Classes="iconButton" Width="22" Height="18" Padding="0"
                                        Click="OnCopyToolOutput" IsVisible="{Binding HasOutput}"
                                        ToolTip.Tip="复制工具输出">
                                  <PathIcon Data="{DynamicResource Icon.Copy}" Width="11" Height="11"
                                            Foreground="{DynamicResource AppTextDim}"/>
                                </Button>
                              </StackPanel>
                              <TextBlock Classes="caption mono" Text="{Binding InputJson}"
                                         TextWrapping="Wrap" MaxLines="3" Margin="12,0,12,6"
                                         Foreground="{DynamicResource AppTextDim}"/>
                              <!-- UI-1 单闭合边框原则：toolCard 已闭合，内部输出区降级为无框轻质填充。 -->
                              <views:ToolImageView SourceText="{Binding ImageOutputSource}"
                                                           IsVisible="{Binding HasImageOutput}" Margin="12,0,12,8"/>
                                        <Border Classes="nestedFill" Margin="12,0,12,8" IsVisible="{Binding ShowTextOutput}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              MaxHeight="{Binding OutputMaxHeight}" Padding="10,6">
                                  <views:ToolOutputView FontSize="12" Foreground="{DynamicResource AppTextSecondary}" Output="{Binding Output}"/>
                                </ScrollViewer>
                              </Border>
                              <Button Classes="subtle" Content="{Binding OutputToggleLabel}"
                                      Command="{Binding ToggleOutputCommand}"
                                      IsVisible="{Binding CanCollapseOutput}"
                                      Margin="6,0,6,6" HorizontalAlignment="Left"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>

                      </ItemsControl.DataTemplates>
                    </ItemsControl>
                  <!-- 引用 chip：链接点击打开浏览器，文件点击在侧栏预览。 -->
                  <ItemsControl ItemsSource="{Binding Links}" IsVisible="{Binding HasLinks}" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:MessageLinkViewModel" x:DataType="vm:MessageLinkViewModel">
                        <Button Classes="referenceChip" Click="OnOpenMessageLink" Margin="0,0,6,6"
                                ToolTip.Tip="{Binding Url}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{DynamicResource Icon.Globe}" Width="12" Height="12"
                                      VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Classes="caption" Text="{Binding Title}" MaxWidth="240"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Classes="meta" Text="{Binding Domain}" VerticalAlignment="Center"
                                       IsVisible="{Binding ShowDomain}"/>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Files}" IsVisible="{Binding HasFiles}" Margin="0,2,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:MessageFileViewModel" x:DataType="vm:MessageFileViewModel">
                        <Button Classes="referenceChip" Click="OnOpenMessageFile" Margin="0,0,6,6"
                                ToolTip.Tip="{Binding Path}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{DynamicResource Icon.Document}" Width="12" Height="12"
                                      VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Classes="mono" FontSize="12" Text="{Binding DisplayName}"/>
                            <TextBlock Classes="meta" Text="{Binding Folder}" VerticalAlignment="Center"
                                       MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- 变更卡已逐文件列出产物时不再重复；没有产物时整块不出现。 -->
                  <Border IsVisible="{Binding ShowArtifactBlock}" Classes="turnSummary">
                    <StackPanel IsVisible="{DynamicResource UiShowArtifactSummary}" Spacing="4">
                      <TextBlock Text="生成产物" Classes="metaName"/>
                      <views:ArtifactLinksView/>
                    </StackPanel>
                  </Border>
                  <!-- 回合结束的变更总结卡（对齐 Codex）：文件数、增删行、查看与撤销。 -->
                  <Panel IsVisible="{DynamicResource UiShowChangeSummary}">
                    <views:CollapsiblePanel IsExpanded="{Binding ChangeCard.HasChanges}" Margin="0,8,0,0">
                    <Border Classes="changeCard"
                            AutomationProperties.AutomationId="MSG-TURN-CHANGE-CARD">
                      <StackPanel>
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,10,12,8" ColumnSpacing="10">
                          <Border Grid.Column="0" Classes="changeIcon" Width="28" Height="28" CornerRadius="8">
                            <PathIcon Data="{DynamicResource Icon.Edit}" Width="14" Height="14"
                                      Foreground="{DynamicResource AppTextSecondary}"/>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Classes="metaName" Text="{Binding ChangeCard.HeaderText}"/>
                            <Button Classes="subtle" Padding="0,1" HorizontalAlignment="Left"
                                    Click="OnViewChanges" ToolTip.Tip="在工作区打开变更面板">
                              <TextBlock Classes="meta" Text="查看变更 ↗"/>
                            </Button>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                      VerticalAlignment="Center">
                            <Button Classes="subtle" Content="撤销 ↶" Click="OnUndoChanges"
                                    IsVisible="{Binding ChangeCard.CanUndo}" ToolTip.Tip="恢复本轮改动前的文件内容"/>
                            <Button Classes="subtle" Content="查看变更" Click="OnViewChanges"/>
                          </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource AppDividerSubtle}"/>
                        <ItemsControl ItemsSource="{Binding ChangeCard.VisibleFiles}" Margin="0,2,0,0">
                          <ItemsControl.DataTemplates>
                            <DataTemplate DataType="vm:TurnFileChangeViewModel" x:DataType="vm:TurnFileChangeViewModel">
                              <StackPanel>
                                <!-- 点整行展开内联 diff，不跳侧栏也能看清改了什么。 -->
                                <Button Classes="changeFileRow" Click="OnToggleFileDiff"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Padding="12,5">
                                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                    <PathIcon Grid.Column="0" Data="{DynamicResource Icon.ChevronDown}" Width="10" Height="10"
                                              VerticalAlignment="Center" Foreground="{DynamicResource AppTextDim}"
                                              IsVisible="{Binding IsExpanded}"/>
                                    <PathIcon Grid.Column="0" Data="{DynamicResource Icon.ChevronRight}" Width="10" Height="10"
                                              VerticalAlignment="Center" Foreground="{DynamicResource AppTextDim}"
                                              IsVisible="{Binding IsCollapsed}"/>
                                    <TextBlock Grid.Column="1" Classes="mono changePath" FontSize="12.5"
                                               Text="{Binding Path}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Classes="mono additions" FontSize="12.5"
                                               Text="{Binding AdditionsText}" IsVisible="{Binding HasAdditions}"/>
                                    <TextBlock Grid.Column="3" Classes="mono deletions" FontSize="12.5"
                                               Text="{Binding DeletionsText}" IsVisible="{Binding HasDeletions}"/>
                                  </Grid>
                                </Button>
                                <Border Classes="diffWell" Margin="12,0,12,8" IsVisible="{Binding IsExpanded}">
                                  <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Auto"
                                                VerticalScrollBarVisibility="Auto" Padding="10,6">
                                    <ItemsControl ItemsSource="{Binding DiffLines}">
                                      <ItemsControl.DataTemplates>
                                        <DataTemplate DataType="vm:DiffLineViewModel" x:DataType="vm:DiffLineViewModel">
                                          <TextBlock Classes="mono diffLine" FontSize="12" TextWrapping="NoWrap"
                                                     Classes.added="{Binding IsAdded}"
                                                     Classes.removed="{Binding IsRemoved}"
                                                     Classes.note="{Binding IsNote}"
                                                     Text="{Binding Text}"/>
                                        </DataTemplate>
                                      </ItemsControl.DataTemplates>
                                    </ItemsControl>
                                  </ScrollViewer>
                                </Border>
                                <TextBlock Classes="meta" Text="{Binding DiffNote}" IsVisible="{Binding HasNote}"
                                           Margin="24,0,12,8"/>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.DataTemplates>
                        </ItemsControl>
                        <Button Classes="subtle" Content="{Binding ChangeCard.MoreLabel}"
                                Click="OnToggleChangeList" HorizontalAlignment="Left"
                                Margin="8,0,8,6" IsVisible="{Binding ChangeCard.HasHiddenFiles}"/>
                        <TextBlock Classes="meta" Text="{Binding ChangeCard.UndoFeedback}"
                                   IsVisible="{Binding ChangeCard.HasUndoFeedback}" Margin="12,0,12,8"/>
                      </StackPanel>
                    </Border>
                    </views:CollapsiblePanel>
                  </Panel>
                  <views:CollapsiblePanel IsExpanded="{Binding ShowMetaCard}">
                    <views:MessageActionsView/>
                  </views:CollapsiblePanel>
                  </StackPanel>
                </Grid>
              </DataTemplate>

              <!-- 错误 / 提示条目（InfoBar 风格；H1 严重性类保留） -->
              <DataTemplate DataType="vm:ErrorEntryViewModel" x:DataType="vm:ErrorEntryViewModel">
                <Border Classes="errorCard" Classes.neutral="{Binding IsNeutral}"
                        Classes.info="{Binding IsInfo}" Margin="0,6">
                  <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Grid.Column="0" Width="18" Height="18" Margin="0,1,0,0"
                              Data="{DynamicResource Icon.ErrorCircle}"
                              IsVisible="{Binding IsError}"/>
                    <PathIcon Grid.Column="0" Width="18" Height="18" Margin="0,1,0,0"
                              Data="{DynamicResource Icon.Info}"
                              IsVisible="{Binding IsInfo}"/>
                    <PathIcon Grid.Column="0" Width="18" Height="18" Margin="0,1,0,0"
                              Data="{DynamicResource Icon.RecordStop}"
                              IsVisible="{Binding IsNeutral}"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="bodyStrong" Text="{Binding KindText}"/>
                        <TextBlock Classes="meta" Text="{Binding TimeText}" VerticalAlignment="Center"/>
                      </StackPanel>
                      <SelectableTextBlock Classes="body" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>

            </ItemsControl.DataTemplates>
          </ItemsControl>
        </ScrollViewer>

        <!-- 回到最新：浮动 pill + 阴影（阴影挂在包裹层，Button 无 BoxShadow）。
             靠右放置，避免压住居中排版的正文。 -->
        <Border Grid.Column="1" CornerRadius="{DynamicResource AppCornerPill}"
                Opacity="{Binding Timeline.ShowBackToLatest, Converter={StaticResource BoolToOpacity}}"
                IsHitTestVisible="{Binding Timeline.ShowBackToLatest}"
                BoxShadow="{DynamicResource FluentPillShadow}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,10">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
          </Border.Transitions>
        <Button x:Name="BackToLatestButton" Classes="backToLatest"
                Command="{Binding Timeline.ScrollToLatestSmoothCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{DynamicResource Icon.ArrowDown}" Width="14" Height="14"/>
            <TextBlock Classes="caption" Text="{Binding Timeline.BackToLatestLabel}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        </Border>
      </Grid>

      <!-- 沉浸式：输入区收起后只留一个小的向上按钮，点击恢复输入区。 -->
      <Button x:Name="ComposerRevealButton" Grid.Row="0" Classes="iconButton composerReveal"
              Width="30" Height="30" VerticalAlignment="Bottom" HorizontalAlignment="Center"
              Margin="0,0,0,10" IsVisible="False" Click="OnExpandComposer"
              ToolTip.Tip="展开输入框" AutomationProperties.Name="展开输入框">
        <PathIcon Data="{DynamicResource Icon.ChevronUp}" Width="14" Height="14"
                  Foreground="{DynamicResource AppTextSecondary}"/>
      </Button>

      <!-- 输入区：浮动卡片（与时间线同列宽）。x:Name 供窗口层计算抽屉避让带（D-R4-1）。 -->
      <Border x:Name="ComposerCard" Grid.Row="1" Classes="composerCard" MaxWidth="880"
              CornerRadius="0" BorderThickness="0,1,0,0" Margin="0" HorizontalAlignment="Stretch">
        <StackPanel>
          <!-- 会话上下文（项目切换）在底部工具行，与模型/思考/权限同排；
               后端只在顶栏会话岛显示，输入卡内不再有后端徽标。 -->

          <!-- 排队条：subtle chip 列表 -->
          <Border Classes="queueStrip" IsVisible="{Binding Input.HasQueue}" Margin="0,0,0,8">
            <StackPanel Spacing="3">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{DynamicResource Icon.History}" Width="13" Height="13"
                          VerticalAlignment="Center" Foreground="{DynamicResource AppTextDim}"/>
                <TextBlock Classes="caption" Text="{Binding Input.QueueSummary}" VerticalAlignment="Center"/>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Input.QueuedPreview}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="{x:Type vm:QueuedItemViewModel}">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="19,0,0,0">
                      <Border Classes="badge" VerticalAlignment="Center"
                              Classes.attention="{Binding IsSteer}">
                        <TextBlock Classes="caption" Text="{Binding BadgeText}"/>
                      </Border>
                      <TextBlock Text="{Binding Text}" Classes="caption" VerticalAlignment="Center"/>
                      <Button Classes="subtle" Padding="6,0" MinHeight="18" FontSize="11"
                              Content="编辑" VerticalAlignment="Center"
                              IsEnabled="{Binding CanEdit}"
                              ToolTip.Tip="{Binding BlockedReason}"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Input.EditQueuedCommand}"
                              CommandParameter="{Binding}"/>
                      <Button Classes="subtle" Padding="6,0" MinHeight="18" FontSize="11"
                              Content="删除" VerticalAlignment="Center"
                              IsEnabled="{Binding CanDelete}"
                              ToolTip.Tip="{Binding BlockedReason}"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Input.DeleteQueuedCommand}"
                              CommandParameter="{Binding}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="caption" Text="{Binding Input.QueuedOverflowText}"
                         IsVisible="{Binding Input.HasQueuedOverflow}" Margin="19,0,0,0"/>
            </StackPanel>
          </Border>

          <!-- 待恢复草稿提示 -->
          <Border Classes="restoreInfo" IsVisible="{Binding Input.HasPendingRestore}" Margin="0,0,0,8">
            <DockPanel LastChildFill="True">
              <Button DockPanel.Dock="Right" Classes="subtle" Content="恢复"
                      Command="{Binding Input.ApplyPendingRestoreCommand}"/>
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <PathIcon Data="{DynamicResource Icon.History}" Width="13" Height="13"
                          VerticalAlignment="Center" Foreground="{DynamicResource AppInfoForeground}"/>
                <TextBlock Classes="caption" Text="{Binding Input.PendingRestoreSummary}" VerticalAlignment="Center"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Input.HasReferenceContext}" Margin="0,0,0,5">
            <Border Classes="turnSummary" Margin="0" Padding="10,2,0,2" BorderBrush="{DynamicResource AppAccent}">
              <TextBlock Text="{Binding Input.ReferenceContext}" Classes="caption" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" ToolTip.Tip="{Binding Input.ReferenceContext}"/>
            </Border>
            <Button Grid.Column="1" Classes="iconButton toolButton" VerticalAlignment="Top" Command="{Binding Input.ClearReferenceCommand}" ToolTip.Tip="移除引用" AutomationProperties.Name="移除引用"><PathIcon Data="{DynamicResource Icon.Dismiss}" Width="12" Height="12"/></Button>
          </Grid>
          <WrapPanel x:Name="AttachedFiles"/>
          <ScrollViewer x:Name="DraftPreview" IsVisible="False" MaxHeight="180" Margin="0,4,0,8"><SelectableTextBlock x:Name="DraftPreviewText" TextWrapping="Wrap" Classes="body"/></ScrollViewer>
          <TextBox x:Name="InputBox" Classes="composerInput"
                   Text="{Binding Input.DraftText}"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   PlaceholderText="输入任务…"
                   MinHeight="44" MaxHeight="200" />

          <!-- 下划线（WinUI TextBox 观感）：常驻但透明，悬停显中性线、聚焦显 accent，
               120ms 淡入淡出，对齐 UniGetUI MegaQueryUnderline -->
          <Border x:Name="ComposerUnderline" Classes="composerUnderline" Margin="0,0,0,2"/>

          <!-- 底部行：命令入口 + 提示 + 停止/发送 -->
          <Grid x:Name="ComposerToolbar" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <Button x:Name="ComposerMoreButton" Classes="iconButton" ToolTip.Tip="附加功能"><PathIcon Data="{DynamicResource Icon.Add}" Width="14" Height="14"/></Button>
            <Button x:Name="CommandFlyoutButton" Grid.Column="1" Classes="iconButton" VerticalAlignment="Center" IsVisible="False"
                    IsEnabled="{Binding Extensions.CanUseCommands}"
                    ToolTip.Tip="{Binding Extensions.CommandButtonToolTip}">
              <PathIcon Data="{DynamicResource Icon.AppsList}" Width="14" Height="14"/>
              <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedLeft">
                  <Border Width="400" Classes="card" Padding="10">
                    <StackPanel Spacing="8">
                      <TextBox Text="{Binding Extensions.FlyoutFilter}"
                               PlaceholderText="搜索命令或技能…"/>
                      <ScrollViewer MaxHeight="320">
                        <ItemsControl ItemsSource="{Binding Extensions.FlyoutCommands}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type vm:CommandItemViewModel}">
                              <Button Classes="commandFlyoutItem" Padding="8,6"
                                      HorizontalContentAlignment="Stretch"
                                      HorizontalAlignment="Stretch"
                                      Command="{Binding FillCommand}"
                                      Click="CommandFlyoutItem_Click">
                                <StackPanel Spacing="1">
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="bodyStrong mono" Text="{Binding Invocation}"
                                               Foreground="{DynamicResource AppTextPrimary}"/>
                                    <Border Classes="badge" VerticalAlignment="Center">
                                      <TextBlock Classes="caption" Text="{Binding SourceBadgeText}"/>
                                    </Border>
                                  </StackPanel>
                                  <TextBlock Classes="caption" Text="{Binding Description}"
                                             Foreground="{DynamicResource AppTextDim}"
                                             TextWrapping="Wrap"/>
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </StackPanel>
                  </Border>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button x:Name="AttachContextButton" Grid.Column="2" Classes="iconButton" ToolTip.Tip="添加文件、图片、PDF 或链接"><PathIcon Data="{DynamicResource Icon.Attach}" Width="14" Height="14"/></Button>
            <!-- 会话所属项目：底部工具行靠左（+、命令、附件之后）；新会话发送第一条前可改。 -->
            <StackPanel x:Name="SessionContextBar" Grid.Column="3" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center" Margin="6,0,8,0" IsVisible="False">
              <Button x:Name="SessionProjectChip" Classes="contextChip"
                      ToolTip.Tip="更改此会话的项目"
                      AutomationProperties.Name="更改此会话的项目">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{DynamicResource Icon.Folder}" Width="13" Height="13"
                            VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}"/>
                  <TextBlock x:Name="SessionProjectChipText" Classes="caption" VerticalAlignment="Center"/>
                  <PathIcon Data="{DynamicResource Icon.ChevronDown}" Width="10" Height="10"
                            VerticalAlignment="Center" Foreground="{DynamicResource AppTextDim}"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <WrapPanel x:Name="ComposerModes" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
              <!-- 模型选择器：宽度固定，不随模型名长度变化；点开后可搜索、可按供应商跳转。 -->
              <Button Classes="subtle" Width="165" Height="28" Padding="8,0" FontSize="11"
                      IsEnabled="{Binding Settings.CanChangeModel}" ToolTip.Tip="选择模型">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBlock Text="{Binding Settings.SelectedModel.Label, FallbackValue='选择模型'}"
                             FontSize="11" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                  <PathIcon Grid.Column="1" Data="{DynamicResource Icon.ChevronDown}" Width="10" Height="10"
                            VerticalAlignment="Center" Classes="meta"/>
                </Grid>
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedRight" Opened="ModelPicker_Opened">
                    <Border Width="380" Classes="card" Padding="10">
                      <StackPanel Spacing="8">
                        <TextBox x:Name="ModelPickerSearchBox"
                                 Text="{Binding Settings.ModelPickerFilter, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="ModelPickerSearchBox_TextChanged"
                                 PlaceholderText="搜索模型…"/>
                        <!-- 关键字快捷：最多三行 -->
                        <ItemsControl ItemsSource="{Binding Settings.ModelSearchKeywords}" MaxHeight="84">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModelKeywordItem">
                              <Border Classes="keywordChip">
                                <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                  <Button Classes="keywordChipLabel" Content="{Binding Keyword}" FontSize="11"
                                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Settings.ApplySearchKeywordCommand}"
                                          CommandParameter="{Binding Keyword}"/>
                                  <Button Classes="keywordChipClose" Content="✕" FontSize="9"
                                          ToolTip.Tip="关闭该关键字"
                                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Settings.DismissSearchKeywordCommand}"
                                          CommandParameter="{Binding}"/>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="subtle" Content="恢复已关闭的关键字" FontSize="11" Padding="8,2" MinHeight="24"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding Settings.HasDismissedKeywords}"
                                Command="{Binding Settings.RestoreSearchKeywordsCommand}"/>
                        <TextBlock Classes="meta" Text="{Binding Settings.ModelPickerSummary}"/>
                        <TextBlock Classes="meta" Text="正在加载模型…"
                                   IsVisible="{Binding Settings.IsModelsLoading}"/>
                        <TextBlock Classes="meta" Text="{Binding Settings.ModelsError}"
                                   IsVisible="{Binding Settings.HasModelsError}" TextWrapping="Wrap"/>
                        <Button Classes="subtle" Content="刷新模型" FontSize="11" Padding="8,2" MinHeight="24"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding Settings.HasModelsError}"
                                Command="{Binding Settings.RefreshModelsCommand}"/>
                        <!-- 右侧预留滚轮宽度：否则 Pin 按钮会被滚动条压住。 -->
                        <ScrollViewer MaxHeight="320" Padding="0,0,12,0">
                          <ItemsControl ItemsSource="{Binding Settings.FilteredModelChoices}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ModelPickerItem">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                  <Button Grid.Column="0" Classes="commandFlyoutItem" Padding="8,5"
                                          HorizontalContentAlignment="Stretch"
                                          HorizontalAlignment="Stretch"
                                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Settings.ChooseModelCommand}"
                                          CommandParameter="{Binding}"
                                          Click="ModelPickerItem_Click">
                                    <TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                  </Button>
                                  <Button Grid.Column="1" Classes="iconButton" Width="26" Height="26"
                                          Content="{Binding PinGlyph}" FontSize="13"
                                          ToolTip.Tip="{Binding PinToolTip}"
                                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Settings.ToggleModelPinCommand}"
                                          CommandParameter="{Binding}"/>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Classes="meta" IsVisible="{Binding !Settings.HasFilteredModelChoices}"
                                   Text="没有匹配的模型"/>
                      </StackPanel>
                    </Border>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <ComboBox ItemsSource="{Binding Settings.ThinkingChoices}" SelectedItem="{Binding Settings.SelectedThinking}" IsEnabled="{Binding Settings.CanChangeModel}" Width="95" Height="28" FontSize="11" ToolTip.Tip="思考等级">
                <ComboBox.Styles><Style Selector="ComboBoxItem" x:DataType="vm:SettingsPageViewModel+ThinkingChoice"><Setter Property="IsEnabled" Value="{Binding IsSupported}"/></Style></ComboBox.Styles>
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SettingsPageViewModel+ThinkingChoice"><TextBlock Text="{Binding Label}" FontSize="11"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </WrapPanel>
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6">
              <Button Classes="iconButton" Command="{Binding Input.StopCommand}"
                      ToolTip.Tip="停止当前回合" AutomationProperties.Name="停止">
                <PathIcon Data="{DynamicResource Icon.RecordStop}" Width="14" Height="14"/>
              </Button>
              <!-- P2-17：运行中插入（steer）；空闲时隐藏 -->
              <Button Classes="subtle" Command="{Binding Input.SteerCommand}"
                      IsVisible="{Binding Input.IsTurnActive}"
                      ToolTip.Tip="插入：当前步骤的工具调用结束后、下一次模型调用前送达（/ 扩展命令不可插入）">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{DynamicResource Icon.ArrowEnterLeft}" Width="13" Height="13"
                            VerticalAlignment="Center"/>
                  <TextBlock Text="插入" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Classes="accent" Command="{Binding Input.SendCommand}"
                      ToolTip.Tip="{Binding Input.SendButtonToolTip}"
                      Padding="12,6" CornerRadius="{DynamicResource ControlCornerRadius}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{DynamicResource Icon.Send}" Width="13" Height="13"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !Input.IsTurnActive}"/>
                  <PathIcon Data="{DynamicResource Icon.History}" Width="13" Height="13"
                            VerticalAlignment="Center"
                            IsVisible="{Binding Input.IsTurnActive}"/>
                  <TextBlock Text="{Binding Input.SendButtonText}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

    </Grid>
  </Grid>
</UserControl>
