<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fufucode.App.ViewModels" xmlns:views="using:Fufucode.App.Views"
        xmlns:infra="using:Fufucode.App.Infrastructure"
        xmlns:imaging="using:Avalonia.Media.Imaging"
        x:Class="Fufucode.App.MainWindow" x:DataType="vm:MainViewModel"
        Title="Fufucode" Icon="avares://Fufucode.App/Assets/Brand/fufucode.ico"
        Width="1440" Height="900" MinWidth="800" MinHeight="640" WindowDecorations="BorderOnly"
        Background="{DynamicResource AppMicaPageBackground}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary x:Key="Light"><imaging:Bitmap x:Key="StartupArtBitmap">avares://Fufucode.App/Assets/Brand/empty/interrupted-light@2x.png</imaging:Bitmap></ResourceDictionary>
      <ResourceDictionary x:Key="Dark"><imaging:Bitmap x:Key="StartupArtBitmap">avares://Fufucode.App/Assets/Brand/empty/interrupted-dark@2x.png</imaging:Bitmap></ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries></ResourceDictionary>
  </Window.Resources>
  <!-- 通知三处（时间线提示卡 / 右上提醒 / 通知中心卡片）共用同一套状态字形与配色。 -->
  <Window.Styles>
    <Style Selector="Border.toastGlyph">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="{DynamicResource AppSubtleBackground}"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="Border.toastGlyph TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextDim}"/>
    </Style>
    <Style Selector="Border.toastGlyph.success TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppSuccessForeground}"/>
    </Style>
    <Style Selector="Border.toastGlyph.critical TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppCriticalForeground}"/>
    </Style>
    <Style Selector="Border.toastGlyph.attention TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}"/>
    </Style>
  </Window.Styles>
  <Grid x:Name="ChromeRoot" RowDefinitions="48,*,26">
    <Border x:Name="CustomCaption" Classes="chromeBar" Background="Transparent" PointerPressed="CaptionDrag_PointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <ScrollViewer MaxWidth="540" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="CustomTopLeft" Orientation="Horizontal" Spacing="3" Margin="8,0" VerticalAlignment="Center"/></ScrollViewer>
        <!-- 中间列必须裁剪：窄窗时胶囊超宽，不裁会压到左右两侧按钮上。 -->
        <Grid Grid.Column="1" ClipToBounds="True">
          <!-- 品牌与当前会话：拖拽区，居中弱化为三级文字，不再与左右按钮竞争视觉。
               Fluent 皮肤下由会话岛（IslandHost）取代它的位置，此块隐藏。 -->
          <Border x:Name="CaptionBrandFallback" Background="Transparent" ClipToBounds="True">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,0" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
              <Image Source="avares://Fufucode.App/Assets/Brand/icon-small-32.png" Width="14" Height="14" Opacity="0.8"/>
              <TextBlock Text="{Binding Sidebar.SelectedSession.Title}" MaxWidth="200" TextTrimming="CharacterEllipsis"
                         FontSize="12" Foreground="{DynamicResource AppTextDim}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <!-- 顶栏中间：用户自选功能的常驻区，窗口水平居中 -->
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
            <StackPanel x:Name="CustomTopCenter" Orientation="Horizontal" Spacing="3"/>
          </ScrollViewer>
        </Grid>
        <!-- 会话灵动岛：跨全部列叠放，以整个窗口为基准居中（左/右按钮宽度不对称，
             放在中间列会偏）。面板本身透明，只有胶囊命中输入。 -->
        <Panel x:Name="IslandHost" Grid.ColumnSpan="4" ZIndex="5"
               HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
        <StackPanel x:Name="LegacyCaptionActions" Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="False">
          <Button x:Name="CaptionCommands" Classes="subtle" Height="30" Padding="10,4" ToolTip.Tip="搜索会话与功能 · Ctrl+K"><StackPanel Orientation="Horizontal" Spacing="7"><PathIcon Data="{DynamicResource Icon.Search}" Width="14" Height="14"/><TextBlock Text="会话与功能" FontSize="12"/></StackPanel></Button>
          <Button Classes="iconButton captionSlot" Width="46" Height="32" Click="ToggleSidebar_Click" ToolTip.Tip="左区"><PathIcon Data="{DynamicResource Icon.PanelLeft}" Width="16" Height="16"/></Button>
          <Button Classes="iconButton captionSlot" Width="46" Height="32" Click="ToggleTerminal_Click" ToolTip.Tip="底区 · Ctrl+J"><PathIcon Data="{DynamicResource Icon.PanelBottom}" Width="16" Height="16"/></Button>
          <Button Classes="iconButton captionSlot" Width="46" Height="32" Click="ToggleRightDock_Click" ToolTip.Tip="右区"><PathIcon Data="{DynamicResource Icon.PanelRight}" Width="16" Height="16"/></Button>
          <Button x:Name="NavChatButton" Classes="iconButton captionSlot" Width="46" Height="32" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Chat}" ToolTip.Tip="返回对话"><PathIcon Data="{DynamicResource Icon.Chat}" Width="16" Height="16"/></Button>
          <Button x:Name="NavExtensionsButton" Classes="iconButton captionSlot" Width="46" Height="32" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Extensions}" ToolTip.Tip="扩展"><PathIcon Data="{DynamicResource Icon.PuzzlePiece}" Width="16" Height="16"/></Button>
          <Button Classes="iconButton captionSlot" Width="46" Height="32" Click="ToggleTheme_Click" ToolTip.Tip="明暗主题"><PathIcon Data="{DynamicResource Icon.Color}" Width="16" Height="16"/></Button>
          <Button x:Name="CaptionNotifications" Classes="iconButton captionSlot" Width="46" Height="32" ToolTip.Tip="通知"><PathIcon Data="{DynamicResource Icon.CheckmarkCircle}" Width="16" Height="16"/></Button>
          <Button x:Name="NavSettingsButton" Classes="iconButton captionSlot" Width="46" Height="32" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Settings}" ToolTip.Tip="设置"><PathIcon Data="{DynamicResource Icon.Settings}" Width="16" Height="16"/></Button>
        </StackPanel>
        <ScrollViewer Grid.Column="2" MaxWidth="420" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="CustomTopRight" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="0,0,8,0"/></ScrollViewer>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <views:CaptionAssetButton x:Name="CaptionMinimize" Kind="minimize" Click="CaptionMinimize_Click" ToolTip.Tip="最小化"/>
          <views:CaptionAssetButton x:Name="CaptionMaximize" Kind="maximize" Click="CaptionMaximize_Click" ToolTip.Tip="最大化"/>
          <views:CaptionAssetButton x:Name="CaptionClose" Kind="close" Click="CaptionClose_Click" ToolTip.Tip="关闭"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="ShellGrid" Grid.Row="1" ColumnDefinitions="224,5,*">
      <Border x:Name="SidebarBorder" Classes="dockHost dockLeft"><views:DockRegionView x:Name="LeftDock"/></Border>
      <infra:DeadZoneGridSplitter x:Name="LeftPanelSplitter" Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWestEast" Classes="dockSplitter"/>
      <Grid x:Name="WorkspaceShell" Grid.Column="2" ColumnDefinitions="*,5,345" RowDefinitions="*,5,190">
        <Grid RowDefinitions="Auto,*">
          <Border x:Name="WorkspaceReturnBar" IsVisible="{Binding IsExtensionsPage}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
            <Button x:Name="WorkspaceReturnButton" Classes="subtle" HorizontalAlignment="Left" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Chat}" ToolTip.Tip="返回工作区">
              <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{DynamicResource Icon.ArrowLeft}"/><TextBlock Text="返回工作区"/></StackPanel>
            </Button>
          </Border>
          <TransitioningContentControl x:Name="PageHost" Grid.Row="1"/>
        </Grid>
        <infra:DeadZoneGridSplitter x:Name="RightPanelSplitter" Grid.Column="1" Grid.RowSpan="3" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" KeyboardIncrement="10" Cursor="SizeWestEast" Classes="dockSplitter"/>
        <Border x:Name="RightPanelBorder" Grid.Column="2" Grid.RowSpan="3" ClipToBounds="True" Classes="dockHost dockRight"><views:DockRegionView x:Name="RightDock"/></Border>
        <infra:DeadZoneGridSplitter x:Name="TerminalSplitter" Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" KeyboardIncrement="10" Cursor="SizeNorthSouth" Classes="dockSplitter"/>
        <Border x:Name="TerminalBorder" Grid.Row="2" Classes="dockHost dockBottom"><views:DockRegionView x:Name="BottomDock"/></Border>
        <Button x:Name="RightDrawerScrim" Grid.ColumnSpan="3" ZIndex="11" IsVisible="False" Background="{DynamicResource AppScrimBackground}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="CloseRightDrawer_Click">
          <Button.Template><ControlTemplate><Border Background="{TemplateBinding Background}"/></ControlTemplate></Button.Template>
        </Button>
      </Grid>
      <!-- 启动遮罩使用不透明底色：Mica 皮肤会把 AppMicaPageBackground 变透明，导致半成品侧栏透出来。 -->
      <Border x:Name="StartupOverlay" Grid.ColumnSpan="3" IsVisible="False" ZIndex="20">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#FF1F1F1F"/>
            <GradientStop Offset="1" Color="#FF141414"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
        <Border Classes="startupCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
        <StackPanel x:Name="StartupSummary" HorizontalAlignment="Stretch" Spacing="14">
          <Image x:Name="StartupArt" Source="{DynamicResource StartupArtBitmap}" Width="200" Height="125" IsVisible="False"/>
          <Border Classes="startupBadge" HorizontalAlignment="Center">
            <Image Source="avares://Fufucode.App/Assets/Brand/icon-small-32.png" Width="28" Height="28"/>
          </Border>
          <TextBlock x:Name="StartupWordmark" Text="Fufucode" Classes="startupWordmark" HorizontalAlignment="Center"/>
          <ProgressBar x:Name="StartupProgress" IsIndeterminate="True" Width="180" HorizontalAlignment="Center"/>
          <TextBlock x:Name="StartupText" Classes="secondary" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,4"/>
          <StackPanel x:Name="StartupPickProject" IsVisible="False" Spacing="8">
            <Button x:Name="StartupOpenProjectButton" Classes="accent" Content="打开项目文件夹"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="38" FontSize="13"
                    Click="StartupOpenProject_Click"/>
            <ItemsControl x:Name="StartupRecentProjects">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Click="StartupRecentProject_Click" Content="{Binding}" Classes="subtle"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,1"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="8">
            <Button x:Name="StartupRetryButton" Content="重试" IsVisible="False" HorizontalAlignment="Stretch" Click="StartupRetryButton_Click"/>
            <Button x:Name="StartupDisableExtensionButton" Content="停用该扩展并重启" IsVisible="False" HorizontalAlignment="Stretch" Click="StartupDisableExtensionButton_Click"/>
            <Button x:Name="StartupOpenOtherButton" Content="打开其他项目" IsVisible="False" HorizontalAlignment="Stretch" Click="StartupOpenOther_Click"/>
          </StackPanel>
        </StackPanel>
        </Border>
        </Grid>
      </Border>
    </Grid>
    <Border x:Name="CustomStatusBar" Grid.Row="2" Classes="chromeBar statusStrip">
      <Grid ColumnDefinitions="*,*" Margin="10,0" ColumnSpacing="12">
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="CustomStatusLeft" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"/></ScrollViewer>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="CustomStatusRight" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center"/></ScrollViewer>
        <TextBlock x:Name="LayoutStateText" Text="布局已保存" IsVisible="False"/>
      </Grid>
    </Border>
    <Border x:Name="NotificationPrompt" Grid.Row="1" ZIndex="20" IsVisible="False" x:DataType="vm:NotificationItemViewModel" Classes="toast" HorizontalAlignment="Right" VerticalAlignment="Top" Width="360" Margin="16" Padding="16,12">
      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
        <Border Grid.RowSpan="2" Classes="toastGlyph"
                Classes.success="{Binding IsCompleted}" Classes.critical="{Binding IsFailed}"
                Classes.attention="{Binding IsApproval}">
          <TextBlock Classes="bodyStrong" Text="{Binding Glyph}"/>
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="bodyStrong" VerticalAlignment="Center"
                   TextWrapping="Wrap"/>
        <Button Grid.Column="2" Classes="iconButton toolButton" VerticalAlignment="Top" Margin="0,-4,-8,0" Click="NotificationPromptDismiss_Click" ToolTip.Tip="关闭通知" AutomationProperties.Name="关闭通知"><PathIcon Data="{DynamicResource Icon.Dismiss}" Width="12" Height="12"/></Button>
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Message}" TextWrapping="Wrap" Classes="caption"/>
        <Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="subtle" Padding="0,2" HorizontalAlignment="Left"
                Content="{Binding RouteLabel}" Click="NotificationPromptOpen_Click"/>
      </Grid>
    </Border>
    <Grid x:Name="GlobalOverlay" Grid.Row="1" ZIndex="30" IsVisible="False">
      <Border Background="{DynamicResource AppSmokeBackground}"/>
      <Button Background="Transparent" BorderThickness="0" CornerRadius="0" Click="GlobalScrim_Click"/>
      <ContentControl x:Name="GlobalOverlayHost" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24" MinWidth="440" MaxWidth="680" Focusable="True" KeyboardNavigation.TabNavigation="Cycle"/>
    </Grid>
    <!-- 会话岛展开面板：主窗内的 overlay 层（不是 Popup）——
         Popup 是独立 top-level 视觉树，窗口 Styles/Resources 全部失效，样式与图标渲染不了。
         放在主窗树里，类选择器、DynamicResource、悬停状态全部照常工作。 -->
    <Panel x:Name="IslandOverlay" Grid.RowSpan="3" ZIndex="40" IsVisible="False">
      <Button x:Name="IslandScrim" Background="Transparent" BorderThickness="0" CornerRadius="0" Click="IslandScrim_Click">
        <Button.Template><ControlTemplate><Border Background="{TemplateBinding Background}"/></ControlTemplate></Button.Template>
      </Button>
      <ContentControl x:Name="IslandOverlayHost" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,52,0,0"/>
    </Panel>
    <!-- 图标提示层：窗口内浮层，不用 Popup。位置按目标控件计算，显示在图标上方。 -->
    <Panel x:Name="TipLayer" Grid.RowSpan="3" ZIndex="60" IsVisible="False" IsHitTestVisible="False">
      <Border x:Name="TipBox" HorizontalAlignment="Left" VerticalAlignment="Top">
        <TextBlock x:Name="TipText" FontSize="11"/>
      </Border>
    </Panel>
  </Grid>
</Window>
