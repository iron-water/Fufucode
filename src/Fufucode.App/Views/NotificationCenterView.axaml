<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fufucode.App.ViewModels"
             x:Class="Fufucode.App.Views.NotificationCenterView"
             x:DataType="vm:NotificationCenterViewModel"
             AutomationProperties.Name="通知功能页">
  <UserControl.Styles>
    <!-- 卡片化的通知列表：每一条通知自成一张消息卡，与 Windows 通知设置的卡片层级一致。 -->
    <Style Selector="Border.notificationCard">
      <Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style Selector="Border.notificationGlyph">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="{DynamicResource AppSubtleBackground}"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="Border.notificationGlyph TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Ellipse.unreadDot">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Height" Value="6"/>
      <Setter Property="Fill" Value="{DynamicResource AppAccent}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.notificationEmptyCard">
      <Setter Property="Padding" Value="16"/>
      <Setter Property="MinHeight" Value="132"/>
    </Style>
    <Style Selector="TextBlock.notificationCompleted"><Setter Property="Foreground" Value="{DynamicResource AppSuccessForeground}"/></Style>
    <Style Selector="TextBlock.notificationFailed"><Setter Property="Foreground" Value="{DynamicResource AppCriticalForeground}"/></Style>
    <Style Selector="TextBlock.notificationApproval"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}"/></Style>
    <Style Selector="Button.notificationFilter.selected">
      <Setter Property="Background" Value="{DynamicResource AppAccentSubtle}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
    </Style>
  </UserControl.Styles>
  <Border Classes="overlayPanel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <!-- 关闭由停靠区的页签 × 负责：页内不再放第二个关闭按钮。 -->
      <Grid Margin="16,12,12,8">
        <TextBlock Classes="sectionTitle" Text="通知" VerticalAlignment="Center"/>
      </Grid>
      <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="16,0,16,0" AutomationProperties.Name="通知过滤">
          <Button Classes="subtle notificationFilter" Classes.selected="{Binding IsAllFilter}" Content="全部"
                  MinHeight="28" Padding="10,2" Command="{Binding SetFilterCommand}" CommandParameter="all"/>
          <Button Classes="subtle notificationFilter" Classes.selected="{Binding IsUnreadFilter}" Content="未读"
                  MinHeight="28" Padding="10,2" Command="{Binding SetFilterCommand}" CommandParameter="unread"/>
          <Button Classes="subtle notificationFilter" Classes.selected="{Binding IsActionableFilter}" Content="失败与待处理"
                  MinHeight="28" Padding="10,2" Command="{Binding SetFilterCommand}" CommandParameter="actionable"/>
        </StackPanel>
        <Border x:Name="ChannelPrompt" IsVisible="False" Margin="12,0,12,0" Padding="10"
                Classes="card" Background="{DynamicResource AppAccentSubtle}" AutomationProperties.Name="通知页提醒">
          <TextBlock x:Name="ChannelPromptText" Classes="caption" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>
      <Grid Grid.Row="2" MinHeight="80">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16,0,16,8" Spacing="8">
            <!-- 概览卡：一行交代未读 / 待处理 / 总数，没有通知时不占位。 -->
            <Border Classes="card" Padding="12,10" IsVisible="{Binding HasItems}">
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" AutomationProperties.Name="通知概览">
                <StackPanel Spacing="1">
                  <TextBlock Classes="bodyStrong" FontSize="18" Text="{Binding UnreadCount}"/>
                  <TextBlock Classes="caption" Text="未读"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Classes="bodyStrong" FontSize="18" Text="{Binding PendingActionCount}"/>
                  <TextBlock Classes="caption" Text="待处理"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="1">
                  <TextBlock Classes="bodyStrong" FontSize="18" Text="{Binding TotalCount}"/>
                  <TextBlock Classes="caption" Text="全部"/>
                </StackPanel>
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding FilteredItems}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NotificationItemViewModel">
                  <Border Classes="card notificationCard" AutomationProperties.Name="{Binding Title}"
                          AttachedToVisualTree="Card_Attached">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <Border Classes="notificationGlyph">
                        <TextBlock Classes="bodyStrong" Classes.notificationCompleted="{Binding IsCompleted}"
                                   Classes.notificationFailed="{Binding IsFailed}" Classes.notificationApproval="{Binding IsApproval}"
                                   Text="{Binding Glyph}"/>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Classes="unreadDot" IsVisible="{Binding !IsRead}"/>
                            <TextBlock Classes="bodyStrong" Text="{Binding Title}" TextWrapping="Wrap"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Classes="caption" Text="{Binding TimeText}" VerticalAlignment="Center"/>
                            <Button Classes="iconButton toolButton" Width="22" Height="22" Click="Dismiss_Click"
                                    ToolTip.Tip="移除这条通知" AutomationProperties.Name="移除这条通知">
                              <PathIcon Data="{DynamicResource Icon.Dismiss}" Width="9" Height="9"/>
                            </Button>
                          </StackPanel>
                        </Grid>
                        <TextBlock Classes="caption" Text="{Binding Message}" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBlock Classes="caption mono" Text="{Binding SessionId}" TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center"/>
                          <Border Grid.Column="1" Classes="badge attention" IsVisible="{Binding RequiresAction}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="需操作"/>
                          </Border>
                        </Grid>
                        <Button Classes="subtle" Content="{Binding RouteLabel}" Click="Activate_Click"
                                HorizontalAlignment="Left" MinHeight="30"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 空状态也放在卡片里，保持“通知区 = 卡片区”的层级。 -->
            <Border Classes="card notificationEmptyCard" IsVisible="{Binding !HasVisibleItems}"
                    AutomationProperties.Name="通知空状态">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <TextBlock Classes="bodyStrong" Text="{Binding FilteredEmptyText}" HorizontalAlignment="Center"/>
                <TextBlock Classes="caption" Text="完成、失败与待审批会逐条出现在这里。" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Border Grid.Row="3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
        <StackPanel Spacing="8">
          <TextBlock Classes="caption" Text="{Binding DroppedNoticeText}" IsVisible="{Binding HasDroppedNotices}" TextWrapping="Wrap"/>
          <TextBlock Classes="caption" Text="提示位置可在设置中分别开关。关闭页签保留通知记录。" TextWrapping="Wrap"/>
          <Button Classes="subtle" Content="清除已结束通知" Command="{Binding ClearCompletedCommand}" HorizontalAlignment="Right" MinHeight="32"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
