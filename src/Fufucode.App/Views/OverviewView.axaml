<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fufucode.App.ViewModels" x:Class="Fufucode.App.Views.OverviewView" x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="8">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="2" Margin="2,4,2,8">
      <Button Grid.Column="0" Classes="subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              Command="{Binding Sidebar.NewSessionCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{DynamicResource Icon.Add}" Width="14" Height="14"/><TextBlock Text="新建会话" FontSize="12"/></StackPanel>
      </Button>
      <Button Grid.Column="1" Classes="subtle iconButton" Width="32" Height="32"
              AutomationProperties.Name="选择后端新建会话" ToolTip.Tip="选择后端后新建会话">
        <PathIcon Data="{DynamicResource Icon.ChevronDown}" Width="12" Height="12"/>
        <Button.Flyout>
          <MenuFlyout Opening="NewSessionFlyout_Opening"/>
        </Button.Flyout>
      </Button>
    </Grid>
    <StackPanel x:Name="ManagementToolbar" Grid.Row="1" Spacing="4"/>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="ManagementBody" Spacing="3"/>
    </ScrollViewer>
  </Grid>
</UserControl>
