<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fufucode.App.ViewModels" x:Class="Fufucode.App.Views.OverviewView" x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="8">
    <Grid Grid.Row="0" Margin="0,0,0,8">
      <!-- 选择后端选择：只切换“新建时用哪个后端”，创建入口在页头 +。 -->
      <Button x:Name="NewSessionBar" Classes="backendSwitchBar" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch" Click="NewSessionBar_Click"
              AutomationProperties.Name="选择后端">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Text="选择后端" FontSize="12" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding Sidebar.DefaultBackendLabel}" FontSize="12"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource AppTextSecondary}"/>
        </Grid>
      </Button>
    </Grid>
    <StackPanel x:Name="ManagementToolbar" Grid.Row="1" Spacing="4"/>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="ManagementBody" Spacing="3"/>
    </ScrollViewer>
  </Grid>
</UserControl>
