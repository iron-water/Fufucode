<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fufucode.App.ViewModels"
             xmlns:models="using:Fufucode.App.Integration"
             xmlns:se="using:Fufucode.App.Features.SettingsExperience"
             xmlns:anim="using:Fufucode.App.Infrastructure"
             xmlns:views="using:Fufucode.App.Views"
             xmlns:backend="using:Fufucode.Core.Backend"
             x:Class="Fufucode.App.Views.SettingsPage"
             x:DataType="{x:Type vm:SettingsPageViewModel}"
             Background="{DynamicResource AppMicaPageBackground}">

  <UserControl.Styles>
    <!-- 行内响应式重排钩子：窄窗口下行内控件换行。 -->
    <Style Selector="Grid.settingsControlRow">
      <Setter Property="RowSpacing" Value="8"/>
    </Style>
    <!-- 设置页里所有 ItemsControl 的行都应是 settingsGroupList 节奏（8px），
         否则默认 StackPanel 无间距、卡片贴死——市场组、提供商、模块、相关设置全中招。 -->
    <Style Selector="ItemsControl">
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate><StackPanel Classes="settingsGroupList"/></ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <!-- 页头：Win11 设置布局——返回箭头 + 大标题居左，右侧搜索摘要；
         搜索框移到左侧导航顶部（Win11 设置主页的查找位置），与导航同层。 -->
    <Grid Grid.Row="0" Margin="16,10,16,10">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
        <Button x:Name="SettingsBackButton" Grid.Column="0" Classes="iconButton toolButton"
                Command="{Binding BackOrReturnCommand}" ToolTip.Tip="{Binding BackToolTip}" AutomationProperties.Name="返回">
          <PathIcon Data="{DynamicResource Icon.ArrowLeft}" Width="16" Height="16"/>
        </Button>
        <TextBlock Grid.Column="1" Classes="settingsPageTitle" Text="设置" Margin="4,0,0,0"/>
        <TextBlock Grid.Column="3" Classes="meta" Text="{Binding SearchSummary}" VerticalAlignment="Center" MaxWidth="200"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SearchSummary}"/>
      </Grid>
    </Grid>

    <Grid x:Name="SettingsBody" Grid.Row="1" ColumnDefinitions="340,*" RowDefinitions="*" ColumnSpacing="8" Margin="12,0,12,0">
      <!-- 一级导航：与 Win11 设置一致的浮起侧栏，顶部搜索框、下方分类列表。 -->
      <Border Grid.Column="0" Classes="settingsNavHost" Margin="0,0,0,24">
        <Grid RowDefinitions="Auto,*">
          <TextBox x:Name="SettingsSearchBox" Grid.Row="0" Text="{Binding SearchText}" PlaceholderText="查找设置"
                   MinHeight="36" CornerRadius="{DynamicResource ControlCornerRadius}" Margin="4,4,4,10"
                   AutomationProperties.Name="搜索设置">
            <TextBox.InnerLeftContent>
              <PathIcon Data="{DynamicResource Icon.Search}" Width="14" Height="14" Margin="10,0,4,0"
                        Foreground="{DynamicResource AppTextSecondary}"/>
            </TextBox.InnerLeftContent>
          </TextBox>
          <ListBox x:Name="SettingsCategoryList" Grid.Row="1" Classes="settingsNav"
               ItemsSource="{Binding FilteredCategories}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SettingsCategoryViewModel">
            <!-- Win11 侧栏项：Grid 直接做根、撑满 ListBoxItem（MinHeight 36）；
                 navFill 整行背景层，selected 染深、pointerover 染浅，BrushTransition
                 渐变。accent 叠加不占列。外包 StackPanel 会让内容塌成 20px。 -->
            <Grid>
              <Border Classes="navFill"/>
              <Border Classes="navAccent"
                      VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="12,0,8,0">
                <views:SemanticIcon Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center"
                          IconName="{Binding Icon}" CategoryColor="{Binding IconColor}"/>
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                           FontSize="14" Foreground="{DynamicResource AppTextPrimary}"/>
              </Grid>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
        </Grid>
      </Border>
      <ListBox x:Name="CompactSettingsCategories" Grid.Column="0" Grid.Row="0" Classes="settingsNav compactBar" IsVisible="False"
               ItemsSource="{Binding FilteredCategories}" Margin="0,0,0,12">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SettingsCategoryViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <views:SemanticIcon Width="15" Height="15" VerticalAlignment="Center" IconName="{Binding Icon}"/>
              <TextBlock Classes="body" Text="{Binding Title}" VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border x:Name="SettingsContentHost" Grid.Column="1" Classes="settingsContentHost"
              Margin="0,0,0,24">
      <Grid x:Name="SettingsContentArea" RowDefinitions="Auto,*">
        <!-- 页面标题＝面包屑：Windows 设置把"系统 > 屏幕"直接当标题 -->
        <!-- 面包屑一行：父级与当前页同字号同字重，只靠颜色区分层级。 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,4,0,4"
                    VerticalAlignment="Bottom">
          <Button Classes="crumbLink" Content="{Binding CategoryTitle}" IsVisible="{Binding IsSubPage}"
                  Command="{Binding BackToCategoryCommand}" AutomationProperties.Name="返回分类首页"
                  VerticalAlignment="Bottom" Margin="0"/>
          <TextBlock Classes="breadcrumb" Text="›" IsVisible="{Binding IsSubPage}"
                     VerticalAlignment="Bottom" Margin="0"/>
          <TextBlock x:Name="SettingsPageTitle" Classes="settingsPageTitle" Text="{Binding PageTitle}"
                     AutomationProperties.Name="设置路径" VerticalAlignment="Bottom"/>
        </StackPanel>

        <ScrollViewer x:Name="SettingsScroller" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="880" Margin="4,0,8,32" Spacing="0" HorizontalAlignment="Stretch">
            <StackPanel IsVisible="{Binding !HasSearchResults}" Spacing="8" Margin="12,20">
              <TextBlock Classes="subtitle" Text="没有匹配的设置"/>
              <TextBlock Classes="caption" Text="试试“主题”“代理”或“通知”。"/>
            </StackPanel>

            <Border Classes="errorCard info" IsVisible="{Binding HasUnsavedChanges}" Margin="0,0,0,12">
              <StackPanel Spacing="4">
                <TextBlock Classes="bodyStrong" Text="有未保存的草稿"/>
                <TextBlock Classes="caption" Text="{Binding UnsavedChangesText}" TextWrapping="Wrap"/>
                <TextBlock Classes="caption" Text="保存各项设置，或返回时选择继续编辑、丢弃草稿。" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Classes="errorCard" IsVisible="{Binding HasAppearanceError}" Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{DynamicResource Icon.ErrorCircle}" Width="15" Height="15" VerticalAlignment="Top"/>
                <TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding AppearanceError}"/>
              </StackPanel>
            </Border>
            <Border Classes="errorCard" IsVisible="{Binding HasSettingsLoadError}" Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{DynamicResource Icon.Warning}" Width="15" Height="15" VerticalAlignment="Top"/>
                <TextBlock Classes="body" TextWrapping="Wrap"
                           Text="{Binding SettingsLoadError, StringFormat='settings.json 上次加载失败（{0}），已用默认值继续'}"/>
              </StackPanel>
            </Border>

            <!-- ═══ 外观 / 功能 / 配置文件：由分区控件渲染（分组卡 + 行式条目） ═══ -->
            <views:WorkbenchSectionsView x:Name="WorkbenchSections"
                                         IsVisible="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).ShowWorkbenchSection}"
                                         DataContext="{Binding Customization}"
                                         Page="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).ActivePageId}"
                                         SearchActive="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).IsSearching}"/>

            <!-- ═══ 模型与思考 ═══ -->
                        <!-- ═══ 插件市场（Plugin Marketplace） ═══ -->
            <StackPanel IsVisible="{Binding ShowMarketplace}" Spacing="10">
              <TextBlock Classes="settingsGroupHeader first" Text="插件市场"/>
              <Border Classes="settingsPanel">
                <StackPanel Spacing="6">
                  <TextBlock Classes="subtitle" Text="按需扩展 Agent 能力与后端内核"/>
                  <TextBlock Classes="caption" Text="C# Native 为核心内置；四大后端作为插件默认启用；高级控制功能（浏览器控制 / 电脑操控）默认不安装，按需一键启用。" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <!-- 能力门禁真实状态：未安装时如实显示安装入口，不渲染假开关。 -->
              <Border Classes="settingsPanel">
                <StackPanel Spacing="6">
                  <TextBlock Classes="bodyStrong" Text="能力解锁状态"/>
                  <TextBlock Classes="caption" Text="{Binding BrowserUseStatusText}" TextWrapping="Wrap"
                             AutomationProperties.AutomationId="marketplace-browser-use-status"/>
                  <TextBlock Classes="caption" Text="{Binding ComputerUseStatusText}" TextWrapping="Wrap"
                             AutomationProperties.AutomationId="marketplace-computer-use-status"/>
                  <TextBlock Classes="caption" Text="{Binding ReverseLabStatusText}" TextWrapping="Wrap"
                             AutomationProperties.AutomationId="marketplace-reverse-lab-status"/>
                </StackPanel>
              </Border>

              <ItemsControl ItemsSource="{Binding MarketplaceGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MarketplaceGroupViewModel">
                    <Button Classes="settingsRow clickable"
                            Command="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).OpenMarketplaceGroupCommand}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <PathIcon Grid.Column="0" Data="{DynamicResource Icon.PuzzlePiece}" Width="18" Height="18"
                                  VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                          <TextBlock Classes="settingsRowTitle" Text="{Binding Title}"/>
                          <TextBlock Classes="settingsRowDesc" Text="{Binding Summary}"/>
                        </StackPanel>
                        <PathIcon Grid.Column="2" Data="{DynamicResource Icon.ChevronRight}" Width="12" Height="12"
                                  VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}"/>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- ═══ 插件市场 → 分类（第二层） ═══ -->
            <StackPanel IsVisible="{Binding ShowMarketplaceGroup}" Spacing="0">
              <!-- 默认 Agent 内核：新建聊天直接使用这里的值，不再弹出选择窗。 -->
              <Border Classes="settingsPanel" IsVisible="{Binding ShowBackendCard}" Margin="0,0,0,8">
                <StackPanel Spacing="8">
                  <TextBlock Classes="bodyStrong" Text="默认 Agent 内核"/>
                  <TextBlock Classes="caption" Text="{Binding BackendStatusText}" TextWrapping="Wrap"/>
                  <ComboBox HorizontalAlignment="Stretch" MinWidth="220"
                            ItemsSource="{Binding BackendEngineChoices}"
                            SelectedIndex="{Binding SelectedBackendIndex}"
                            ToolTip.Tip="新建聊天使用的默认核心。已有会话保持创建时的后端。"/>
                  <TextBlock Classes="meta" TextWrapping="Wrap"
                             Text="新建聊天直接使用此内核；六类后端都会列出，插件未安装或运行时缺失时新建会回退到 FUMO 并提示原因。"/>
                </StackPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding MarketplaceGroupPlugins}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PluginItemViewModel">
                    <Border Classes="settingsPanel">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Classes="bodyStrong" Text="{Binding Name}"/>
                            <Border Classes="badge" Background="{DynamicResource AppSubtleBackground}" Padding="6,1" CornerRadius="4">
                              <TextBlock Classes="caption" Text="{Binding CategoryName}"/>
                            </Border>
                            <Border Classes="badge" Background="{DynamicResource AppSubtleBackground}" Padding="6,1" CornerRadius="4">
                              <TextBlock Classes="caption mono" Text="{Binding Version, StringFormat='v{0}'}"/>
                            </Border>
                            <Border Classes="badge" Background="{DynamicResource AppSubtleBackground}" Padding="6,1" CornerRadius="4">
                              <TextBlock Classes="caption" Text="{Binding StatusBadgeText}"/>
                            </Border>
                          </StackPanel>
                          <TextBlock Classes="caption" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                          <TextBlock Classes="meta" Text="{Binding PermissionsSummary}" Foreground="{DynamicResource AppTextDim}" IsVisible="{Binding HasPermissions}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <ToggleSwitch IsChecked="{Binding IsEnabled}"
                                        Command="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).TogglePluginEnabledCommand}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding IsInstalled}"
                                        IsVisible="{Binding !IsCoreBuiltin}"
                                        ToolTip.Tip="启用或停用插件"/>
                          <Button Classes="subtle" Padding="12,4"
                                  Content="{Binding ActionButtonText}"
                                  Command="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).InstallOrUninstallPluginCommand}"
                                  CommandParameter="{Binding}"
                                  IsEnabled="{Binding !IsCoreBuiltin}"
                                  ToolTip.Tip="安装或卸载插件"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <ContentControl IsVisible="{Binding ShowShortcuts}" Content="{Binding ShortcutsContent}"/>
            <!-- ═══ 储存（一级）→ 已归档（二级，面包屑：储存 › 已归档） ═══ -->
            <StackPanel IsVisible="{Binding ShowStorage}" Spacing="12">
              <StackPanel Spacing="0">
                <TextBlock Classes="settingsGroupHeader first" Text="数据与归档"/>
                <Border Classes="settingsGroup">
                  <Button Classes="settingsRow clickable" Command="{Binding OpenArchivePageCommand}"
                          AutomationProperties.Name="打开已归档">
                    <Grid Classes="settingsControlRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                      <PathIcon Grid.Column="0" Data="{DynamicResource Icon.Archive}" Width="18" Height="18"
                                VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"
                                  HorizontalAlignment="Left">
                        <TextBlock Classes="settingsRowTitle" Text="已归档"/>
                        <TextBlock Classes="settingsRowDesc" TextWrapping="Wrap"
                                   Text="查看并恢复已归档的项目与会话"/>
                      </StackPanel>
                      <PathIcon Grid.Column="2" Data="{DynamicResource Icon.ChevronRight}" Width="12" Height="12"
                                VerticalAlignment="Center"/>
                    </Grid>
                  </Button>
                </Border>
              </StackPanel>
              <ContentControl Content="{Binding StorageContent}"/>
            </StackPanel>
            <ContentControl IsVisible="{Binding ShowArchive}" Content="{Binding ArchiveContent}"/>
            <StackPanel IsVisible="{Binding ShowArchiveEmpty}" Spacing="8" Margin="12,20">
              <TextBlock Classes="subtitle" Text="归档管理尚未就绪"/>
              <TextBlock Classes="caption" Text="连接真实会话后可在此查看和管理已归档的项目与会话。"
                         TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel IsVisible="{Binding ShowModels}" Spacing="0">
              <TextBlock Classes="settingsGroupHeader first" Text="模型"/>
              <Border Classes="settingsGroup">
                <StackPanel>
                  <Border Classes="settingsRow" IsVisible="{Binding ShowModelRow}">
                    <Grid Classes="settingsControlRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                      <PathIcon Grid.Column="0" Data="{DynamicResource Icon.Sparkle}" Width="18" Height="18"
                                VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="settingsRowTitle" Text="模型"/>
                        <TextBlock Classes="settingsRowDesc" Text="{Binding CurrentModelText, StringFormat='当前模型：{0}'}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="iconButton" Command="{Binding RefreshModelsCommand}"
                                IsVisible="{Binding !IsMock}" ToolTip.Tip="刷新可用模型">
                          <PathIcon Data="{DynamicResource Icon.ArrowClockwise}" Width="14" Height="14"/>
                        </Button>
                        <ComboBox Width="260" VerticalAlignment="Center"
                                  IsEnabled="{Binding CanChangeModel}"
                                  ItemsSource="{Binding ModelChoices}"
                                  SelectedItem="{Binding SelectedModel}"
                                  PlaceholderText="选择模型"
                                  ToolTip.Tip="空闲时对当前会话立即生效；回合进行中仅保存给新建会话">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type vm:SettingsPageViewModel+ModelChoice}">
                              <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="settingsRow clickable" IsVisible="{Binding ShowModels}"
                          PointerPressed="OnOpenProvidersPressed"
                          AutomationProperties.Name="打开提供商设置">
                    <Grid Classes="settingsControlRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                      <PathIcon Grid.Column="0" Data="{DynamicResource Icon.Globe}" Width="18" Height="18"
                                VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Classes="settingsRowTitle" Text="提供商"/>
                        <TextBlock Classes="settingsRowDesc" Text="{Binding ProviderSummary}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <PathIcon Grid.Column="2" Data="{DynamicResource Icon.ChevronRight}" Width="12" Height="12"
                                VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <Border Classes="settingsRow last" IsVisible="{Binding ShowThinkingRow}">
                    <Grid Classes="settingsControlRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                      <PathIcon Grid.Column="0" Data="{DynamicResource Icon.Brain}" Width="18" Height="18"
                                VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="settingsRowTitle" Text="思考等级"/>
                        <TextBlock Classes="settingsRowDesc" Text="「默认」跟随 Pi/模型自身行为"/>
                      </StackPanel>
                      <ComboBox Grid.Column="2" Width="140" VerticalAlignment="Center"
                                IsEnabled="{Binding CanChangeModel}"
                                ItemsSource="{Binding ThinkingChoices}"
                                SelectedItem="{Binding SelectedThinking}"
                                ToolTip.Tip="空闲时对当前会话立即生效；回合进行中仅保存给新建会话">
                        <ComboBox.Styles><Style Selector="ComboBoxItem" x:DataType="vm:SettingsPageViewModel+ThinkingChoice"><Setter Property="IsEnabled" Value="{Binding IsSupported}"/></Style></ComboBox.Styles>
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="{x:Type vm:SettingsPageViewModel+ThinkingChoice}">
                            <TextBlock Text="{Binding Label}"/>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <StackPanel Spacing="6" Margin="2,8,0,0">
                <TextBlock Classes="meta" Text="mock 模式没有真实模型；当前无法切换。" IsVisible="{Binding IsMock}" TextWrapping="Wrap"/>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsModelApplying}" Height="3"/>
                <TextBlock Classes="meta" Text="{Binding ModelsStateText}" TextWrapping="Wrap"/>
                <TextBlock Classes="meta" Foreground="{DynamicResource AppCriticalForeground}"
                           IsVisible="{Binding HasModelsError}" TextWrapping="Wrap" Text="{Binding ModelsError}"/>
                <TextBlock Classes="meta" IsVisible="{Binding HasModelsInfo}" TextWrapping="Wrap" Text="{Binding ModelsInfo}"/>
              </StackPanel>
              <TextBlock Classes="settingsGroupHeader" Text="可用模型" IsVisible="{Binding !IsMock}"/>
              <Border Classes="settingsPanel" IsVisible="{Binding !IsMock}">
                <StackPanel Spacing="3">
                  <ItemsControl ItemsSource="{Binding ModelRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="{x:Type x:String}">
                        <TextBlock Classes="meta mono" Text="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="meta" IsVisible="{Binding !HasModelRows}" IsEnabled="{Binding !HasModelsError}"
                             Text="（尚未查询到模型列表）"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- ═══ 模型与思考 → 提供商 → 添加提供商（预设选择） ═══ -->
            <StackPanel IsVisible="{Binding ShowPresetPicker}" Spacing="0">
              <TextBlock Classes="settingsGroupHeader first" Text="添加提供商"/>
              <TextBlock Classes="settingsRowDesc" Margin="2,0,0,10" TextWrapping="Wrap"
                         Text="选择一个预填好的提供商，或自定义任意 OpenAI 兼容端点。"/>
              <Border Classes="settingsGroup">
                <StackPanel Spacing="0">
                  <Border Classes="settingsRow">
                    <TextBox Text="{Binding PresetFilter}" PlaceholderText="搜索提供商…"/>
                  </Border>
                  <ItemsControl ItemsSource="{Binding FilteredPresets}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProviderPreset">
                        <Border Classes="settingsRow clickable" Tag="{Binding}"
                                PointerPressed="OnPresetPressed">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <PathIcon Grid.Column="0" Data="{DynamicResource Icon.Globe}" Width="18" Height="18"
                                      VerticalAlignment="Center" Classes="meta"/>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                              <TextBlock Classes="settingsRowTitle" Text="{Binding Name}"/>
                              <TextBlock Classes="settingsRowDesc" Text="{Binding Description}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <PathIcon Grid.Column="2" Data="{DynamicResource Icon.ChevronRight}" Width="12" Height="12"
                                      VerticalAlignment="Center" Classes="meta"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="settingsRow last" IsVisible="{Binding !HasFilteredPresets}">
                    <TextBlock Classes="settingsRowDesc" Text="没有匹配的提供商"/>
                  </Border>
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,10,0,0">
                <Button Classes="subtle" Content="返回" Padding="12,2" MinHeight="28"
                        Command="{Binding CancelEditProviderCommand}"/>
              </StackPanel>
            </StackPanel>

            <!-- ═══ 模型与思考 → 提供商（第二层） ═══ -->
            <StackPanel IsVisible="{Binding ShowProviderList}" Spacing="0">
              <TextBlock Classes="settingsGroupHeader first" Text="提供商"/>
              <Border Classes="settingsGroup">
                <StackPanel Spacing="0">
                  <Border Classes="settingsRow" IsVisible="{Binding HasEndpointProviders}">
                    <TextBox Text="{Binding ProviderFilter}" PlaceholderText="搜索提供商或 Base URL…"/>
                  </Border>
                  <ItemsControl ItemsSource="{Binding FilteredEndpointProviders}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:EndpointProviderItem">
                        <Border Classes="settingsRow clickable" Tag="{Binding}"
                                PointerPressed="OnEditProviderPressed">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <PathIcon Grid.Column="0" Data="{DynamicResource Icon.Globe}" Width="18" Height="18"
                                      VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                              <TextBlock Classes="settingsRowTitle" Text="{Binding DisplayName}"/>
                              <TextBlock Classes="settingsRowDesc" Text="{Binding BaseUrl}" TextWrapping="Wrap"/>
                              <TextBlock Classes="meta" Text="{Binding SelectedCountText}"/>
                            </StackPanel>
                            <PathIcon Grid.Column="2" Data="{DynamicResource Icon.ChevronRight}" Width="12" Height="12"
                                      VerticalAlignment="Center"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- 空状态：没有提供商时明确说明，而不是一片空白。 -->
                  <Border Classes="settingsRow" IsVisible="{Binding !HasEndpointProviders}">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="settingsRowTitle" Text="还没有配置提供商"/>
                      <TextBlock Classes="settingsRowDesc" TextWrapping="Wrap"
                                 Text="添加一个 OpenAI 兼容端点（如本机 Magpie），即可拉取它的模型列表并选择可用模型。"/>
                    </StackPanel>
                  </Border>

                  <Border Classes="settingsRow" IsVisible="{Binding ShowNoProviderMatch}">
                    <TextBlock Classes="settingsRowDesc" Text="没有匹配的提供商"/>
                  </Border>
                  <Border Classes="settingsRow last">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                      <PathIcon Grid.Column="0" Data="{DynamicResource Icon.Sparkle}" Width="18" Height="18"
                                VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="settingsRowTitle" Text="添加提供商"/>
                        <TextBlock Classes="settingsRowDesc" Text="填写 Base URL 后自动拉取该提供商的模型" TextWrapping="Wrap"/>
                      </StackPanel>
                      <Button Grid.Column="2" Classes="accent" Content="添加提供商" Padding="12,2" MinHeight="28"
                              Command="{Binding BeginAddProviderCommand}"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- ═══ 模型与思考 → 提供商 → 选择模型（第三层） ═══ -->
            <StackPanel IsVisible="{Binding ShowProviderEditor}" Spacing="0">
              <TextBlock Classes="settingsGroupHeader first" Text="提供商设置"/>
              <Border Classes="settingsPanel">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="3">
                      <TextBlock Classes="settingsRowDesc" Text="名称"/>
                      <TextBox Text="{Binding EndpointProviderName}" PlaceholderText="如 magpie"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                      <TextBlock Classes="settingsRowDesc" Text="Base URL"/>
                      <TextBox Text="{Binding EndpointBaseUrl}" PlaceholderText="http://127.0.0.1:3425/v1"
                               IsEnabled="{Binding IsBaseUrlEditable}"/>
                    </StackPanel>
                  </Grid>

                  <StackPanel Spacing="4">
                    <TextBlock Classes="settingsRowDesc" Text="密钥来源"/>
                    <TextBlock Classes="meta" IsVisible="{Binding IsApiKeyRequired}"
                               Text="该提供商需要 API Key。"/>
                    <ComboBox SelectedIndex="{Binding EndpointKeyModeIndex}" MaxWidth="320" HorizontalAlignment="Left">
                      <ComboBoxItem Content="输入 API Key（存入 Windows 凭据管理器）"/>
                      <ComboBoxItem Content="使用已有环境变量"/>
                    </ComboBox>
                    <StackPanel IsVisible="{Binding EndpointKeyModeIsKey}" Spacing="3">
                      <TextBox x:Name="EndpointKeyBox" PasswordChar="●" PlaceholderText="API Key（不会保存到配置文件）"/>
                      <TextBlock Classes="meta" Text="{Binding EndpointKeyTargetText}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding !EndpointKeyModeIsKey}" Spacing="3">
                      <TextBox Text="{Binding EndpointEnvName}" PlaceholderText="环境变量名，如 MAGPIE_API_KEY"/>
                      <TextBlock Classes="meta" Text="{Binding EndpointKeyTargetText}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <TextBlock Classes="settingsGroupHeader" Text="模型"/>
              <Border Classes="settingsPanel">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="subtle" Content="刷新" Padding="8,1" MinHeight="22"
                            Command="{Binding LoadEndpointModelsCommand}"
                            IsEnabled="{Binding !IsLoadingEndpointModels}"
                            ToolTip.Tip="从该提供商的 /models 拉取"/>
                    <Button Classes="subtle" Content="全选" Padding="8,1" MinHeight="22"
                            Command="{Binding SelectAllEndpointModelsCommand}"
                            IsEnabled="{Binding HasAvailableEndpointModels}"/>
                    <Button Classes="subtle" Content="全不选" Padding="8,1" MinHeight="22"
                            Command="{Binding ClearEndpointModelsCommand}"
                            IsEnabled="{Binding HasAvailableEndpointModels}"/>
                    <TextBlock Classes="meta" VerticalAlignment="Center" Text="{Binding EndpointSelectedCountText}"/>
                    <TextBlock Classes="meta" Text="正在获取模型…" VerticalAlignment="Center"
                               IsVisible="{Binding IsLoadingEndpointModels}"/>
                  </StackPanel>
                  <Border BorderThickness="1" BorderBrush="{DynamicResource AppDivider}"
                          CornerRadius="4" MaxHeight="320" IsVisible="{Binding HasAvailableEndpointModels}">
                    <ScrollViewer>
                      <ItemsControl ItemsSource="{Binding AvailableEndpointModels}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:EndpointModelOption">
                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"
                                      ToolTip.Tip="{Binding Id}" Margin="10,1" FontSize="12"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Border>
                  <TextBox Text="{Binding EndpointModelId}" PlaceholderText="无法自动获取时手填，如 provider/model"
                           IsVisible="{Binding !HasAvailableEndpointModels}"/>
                  <TextBlock Classes="meta" Foreground="{DynamicResource AppCriticalForeground}"
                             TextWrapping="Wrap" Text="{Binding EndpointModelsError}"
                             IsVisible="{Binding EndpointModelsError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,10,0,0">
                <Button Classes="accent" Content="保存" Padding="12,2" MinHeight="28" Click="OnSaveEndpointClick"/>
                <Button Classes="subtle" Content="返回" Padding="12,2" MinHeight="28"
                        Command="{Binding CancelEditProviderCommand}"/>
              </StackPanel>
              <TextBlock Classes="meta" Foreground="{DynamicResource AppCriticalForeground}"
                         IsVisible="{Binding HasEndpointError}" TextWrapping="Wrap" Text="{Binding EndpointError}" Margin="2,6,0,0"/>
              <TextBlock Classes="meta" Foreground="{DynamicResource AppSuccessForeground}"
                         IsVisible="{Binding HasEndpointInfo}" TextWrapping="Wrap" Text="{Binding EndpointInfo}" Margin="2,6,0,0"/>
            </StackPanel>

            <!-- ═══ 网络与端点 ═══ -->
            <StackPanel IsVisible="{Binding ShowNetwork}" Spacing="0">
              <Border Classes="errorCard info" IsVisible="{Binding HasRestartNotice}" Margin="0,12,0,0">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{DynamicResource Icon.Info}" Width="15" Height="15" VerticalAlignment="Center"/>
                    <TextBlock Classes="body" Text="{Binding RestartNoticeText}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="accent" Content="立即重启"
                          Command="{Binding RestartNowCommand}" IsEnabled="{Binding !IsMock}"/>
                </Grid>
              </Border>

              <TextBlock Classes="settingsGroupHeader first" Text="连接"/>
              <Border Classes="settingsGroup">
                <StackPanel>
                  <Border Classes="settingsRow" IsVisible="{Binding ShowProxyRow}">
                    <Grid Classes="settingsControlRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                      <PathIcon Grid.Column="0" Data="{DynamicResource Icon.Globe}" Width="18" Height="18"
                                VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="settingsRowTitle" Text="代理"/>
                        <TextBlock Classes="settingsRowDesc"
                                   Text="{Binding ProxySummary, StringFormat='当前：{0}；保存后需重启会话生效'}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBox MinWidth="200" VerticalAlignment="Center" Text="{Binding ProxyInput}" PlaceholderText="http://host:port"/>
                        <Button Classes="subtle" Content="保存" Padding="10,2" MinHeight="28" Command="{Binding SaveProxyCommand}"/>
                        <Button Classes="subtle" Content="清除" Padding="10,2" MinHeight="28" Command="{Binding ClearProxyCommand}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="settingsRow last" IsVisible="{Binding ShowEndpointRow}">
                    <Grid Classes="settingsControlRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                      <PathIcon Grid.Column="0" Data="{DynamicResource Icon.Key}" Width="18" Height="18"
                                VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="settingsRowTitle" Text="自定义端点"/>
                        <TextBlock Classes="settingsRowDesc"
                                   Text="{Binding EndpointSummary, StringFormat='当前：{0}；保存后需重启会话生效'}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="subtle" Content="移除端点" Padding="10,2" MinHeight="28"
                                Command="{Binding RemoveEndpointCommand}" IsVisible="{Binding HasEndpoint}"
                                ToolTip.Tip="移除后 models.json 中的 provider 随下次启动清理；凭据管理器中的密钥不删除（无删除接口），可手动清理"/>
                        <Button Classes="subtle" Content="配置…" Padding="10,2" MinHeight="28" Command="{Binding ToggleEndpointFormCommand}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>

              <StackPanel Spacing="6" Margin="2,8,0,0">
                <TextBlock Classes="meta" Text="{Binding NetworkStateText}" TextWrapping="Wrap"/>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsEndpointSaving}" Height="3"/>
              </StackPanel>

              <TextBlock Classes="settingsGroupHeader" Text="模型配置（models.json）" IsVisible="{Binding ShowModelsConfig}"/>
              <Border Classes="settingsPanel" IsVisible="{Binding ShowModelsConfig}">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="meta" Text="当前生效的配置" VerticalAlignment="Center"/>
                    <Button Classes="subtle" Content="打开所在文件夹" Command="{Binding OpenFolderCommand}"
                            CommandParameter="{Binding AgentDirectoryText}" IsEnabled="{Binding CanOpenFolders}" Padding="8,2" MinHeight="24"/>
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Providers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="{x:Type models:PiProviderInfo}">
                        <StackPanel Spacing="1" Margin="0,2">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="caption bodyStrong" Text="{Binding Name}"/>
                            <TextBlock Classes="meta mono" Text="{Binding BaseUrl}"/>
                            <TextBlock Classes="meta" Text="{Binding Api, StringFormat='api: {0}'}"/>
                          </StackPanel>
                          <TextBlock Classes="meta" Text="{Binding ModelIds, Converter={x:Static anim:StringJoinConverter.Instance}}"/>
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="meta" Text="{Binding KeyText}"/>
                            <Border Classes="badge attention" Padding="6,0" MinHeight="16" IsVisible="{Binding KeyIsCaution}"
                                    ToolTip.Tip="建议改用环境变量引用（$VAR），不要把密钥写进文件">
                              <TextBlock Classes="caption" Text="建议改用环境变量引用"/>
                            </Border>
                          </StackPanel>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="meta" TextWrapping="Wrap" IsVisible="{Binding HasModelsConfigStatus}" Text="{Binding ModelsConfigStatus}"/>
                </StackPanel>
              </Border>

              <!-- 手机远程控制 (WorkBuddy 局域网控制对标) -->
              <TextBlock Classes="settingsGroupHeader" Text="手机远程控制" IsVisible="{Binding ShowRemoteCard}"/>
              <Border Classes="settingsPanel" IsVisible="{Binding ShowRemoteCard}">
                <StackPanel Spacing="10">
                  <Grid Classes="settingsControlRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <PathIcon Grid.Column="0" Data="{DynamicResource Icon.Phone}" Width="18" Height="18"
                              VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="settingsRowTitle" Text="局域网远程控制 (Web PWA)"/>
                      <TextBlock Classes="settingsRowDesc" Text="{Binding RemoteStatusText}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="subtle" Padding="12,4"
                            Content="{Binding RemoteToggleButtonText}"
                            Command="{Binding ToggleRemoteControlCommand}"/>
                  </Grid>

                  <Border Classes="settingsPanel subtle" Margin="0,4,0,0"
                          IsVisible="{Binding IsRemoteRunning}">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="caption bodyStrong" Text="手机访问地址（局域网浏览器打开即可）："/>
                          <SelectableTextBlock Classes="meta mono" Text="{Binding RemotePairingUrl}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Border Background="{DynamicResource AppAccent}" CornerRadius="4" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="4位配对PIN:" Foreground="White"/>
                              <TextBlock Text="{Binding RemotePin}" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                          </Border>
                          <Button Classes="subtle" Content="扫码配对" Command="{Binding ToggleRemoteQrCommand}"/>
                        </StackPanel>
                      </Grid>

                      <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4"
                              Padding="12" Background="White" HorizontalAlignment="Center" IsVisible="{Binding ShowRemoteQr}">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                          <TextBlock Classes="caption" Foreground="Black" Text="用手机相机或浏览器扫码免输地址：" HorizontalAlignment="Center"/>
                          <!-- QR 卡固定白底（扫码可读性），内部文字用固定深色，不走主题 token。 -->
                          <SelectableTextBlock Classes="meta mono" Foreground="Black" Opacity="0.8"
                                               Text="{Binding RemotePairingUrl}" HorizontalAlignment="Center"/>
                          <TextBlock Text="在手机网页输入上面的 4 位 PIN 码即可完成安全配对" Classes="caption"
                                     Foreground="Black" Opacity="0.6" HorizontalAlignment="Center"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- ═══ 通知 ═══ -->
            <StackPanel IsVisible="{Binding ShowNotifications}" Spacing="0">
              <TextBlock Classes="settingsGroupHeader first" Text="提醒方式"/>
              <Border Classes="settingsGroup">
                <StackPanel>
                  <Border Classes="settingsRow">
                    <Grid Classes="settingsControlRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                      <PathIcon Grid.Column="0" Data="{DynamicResource Icon.Info}" Width="18" Height="18"
                                VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="settingsRowTitle" Text="完成与失败提醒"/>
                        <TextBlock Classes="settingsRowDesc" Text="选择何时显示主动提示"/>
                      </StackPanel>
                      <ComboBox Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                                SelectedIndex="{Binding NotificationPreferences.SelectedCompletionPolicyIndex}"
                                IsEnabled="{Binding HasNotificationPreferences}">
                        <ComboBoxItem Content="不提醒"/><ComboBoxItem Content="失焦时"/><ComboBoxItem Content="总是"/>
                      </ComboBox>
                    </Grid>
                  </Border>
                  <Border Classes="settingsRow last">
                    <Grid Classes="settingsControlRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                      <PathIcon Grid.Column="0" Data="{DynamicResource Icon.ShieldCheckmark}" Width="18" Height="18"
                                VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="settingsRowTitle" Text="权限与问题提醒"/>
                        <TextBlock Classes="settingsRowDesc" Text="有待处理审批时显示主动提示"/>
                      </StackPanel>
                      <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                    IsChecked="{Binding NotificationPreferences.NotifyApprovals}"
                                    IsEnabled="{Binding HasNotificationPreferences}"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <StackPanel Spacing="4" Margin="2,8,0,0">
                <TextBlock Classes="meta" Text="策略控制主动提示；会话标记和通知列表仍可查看。系统通知尚未启用。" TextWrapping="Wrap"/>
                <TextBlock Classes="meta" Text="当前无法修改提醒偏好。" IsVisible="{Binding !HasNotificationPreferences}" TextWrapping="Wrap"/>
                <TextBlock Classes="meta" Text="{Binding NotificationPreferences.SaveStatusText}" TextWrapping="Wrap"/>
                <TextBlock Classes="meta" Foreground="{DynamicResource AppCriticalForeground}"
                           Text="{Binding NotificationPreferences.SaveError}"
                           IsVisible="{Binding NotificationPreferences.HasSaveError}" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>

            <!-- ═══ 工作台模块 ═══ -->
            <StackPanel IsVisible="{Binding ShowModules}" Spacing="0">
              <TextBlock Classes="settingsGroupHeader first" Text="内建模块"/>
              <Border Classes="settingsGroup">
                <ItemsControl ItemsSource="{Binding BuiltInModules}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BuiltInModuleViewModel">
                      <Border Classes="settingsRow">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                          <StackPanel Spacing="2">
                            <TextBlock Classes="settingsRowTitle" Text="{Binding Title}"/>
                            <TextBlock Classes="settingsRowDesc" Text="{Binding Status}" TextWrapping="Wrap"/>
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding Title}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>

            <!-- ═══ 关于 ═══ -->
            <StackPanel IsVisible="{Binding ShowAbout}" Spacing="0">
              <!-- 中断或回滚提示横幅 -->
              <Border IsVisible="{Binding HasInterruptedNotice}"
                      Background="{DynamicResource AppSubtleBackground}"
                      BorderBrush="{DynamicResource AppBorderBrush}"
                      BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <PathIcon Grid.Column="0" Data="{DynamicResource Icon.Warning}" Width="16" Height="16"
                            Foreground="{DynamicResource AppWarningForeground}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Classes="caption" Text="{Binding UpdateInterruptedNotice}"
                             TextWrapping="Wrap" VerticalAlignment="Center"/>
                  <Button Grid.Column="2" Classes="subtle" Content="知道了"
                          Command="{Binding DismissInterruptedNoticeCommand}" VerticalAlignment="Center"/>
                </Grid>
              </Border>

              <TextBlock Classes="settingsGroupHeader first" Text="版本与目录"/>
              <Border Classes="settingsGroup">
                <StackPanel>
                  <Border Classes="settingsRow">
                    <StackPanel Spacing="10">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <Image Source="avares://Fufucode.App/Assets/Brand/icon-256.png" Width="44" Height="44"/>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                          <TextBlock Classes="settingsRowTitle" Text="Fufucode"/>
                          <TextBlock Classes="settingsRowDesc"
                                     Text="{Binding AppVersion, StringFormat='版本 {0}'}" ToolTip.Tip="{Binding AppVersionTooltip}"/>
                        </StackPanel>
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding VersionRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="{x:Type vm:KeyValueRow}">
                            <Grid ColumnDefinitions="120,*" Margin="0,1">
                              <TextBlock Classes="meta" Text="{Binding Key}"/>
                              <TextBlock Grid.Column="1" Classes="meta" Text="{Binding Value}" TextWrapping="Wrap"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <Border Classes="settingsRow">
                    <StackPanel Spacing="6" x:Name="AboutPaths">
                      <Grid Classes="settingsPathRow" ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Classes="meta" Text="数据目录" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Classes="caption mono" Text="{Binding DataRootText}" ToolTip.Tip="{Binding DataRootText}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Classes="subtle" Content="打开" Padding="8,2" MinHeight="24"
                                Command="{Binding OpenFolderCommand}" CommandParameter="{Binding DataRootText}"
                                IsEnabled="{Binding CanOpenFolders}"/>
                      </Grid>
                      <Grid Classes="settingsPathRow" ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Classes="meta" Text="代理配置目录" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Classes="caption mono" Text="{Binding AgentDirectoryText}" ToolTip.Tip="{Binding AgentDirectoryText}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Classes="subtle" Content="打开" Padding="8,2" MinHeight="24"
                                Command="{Binding OpenFolderCommand}" CommandParameter="{Binding AgentDirectoryText}"
                                IsEnabled="{Binding CanOpenFolders}"/>
                      </Grid>
                      <Grid Classes="settingsPathRow" ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Classes="meta" Text="日志目录" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Classes="caption mono" Text="{Binding LogsDirectoryText}" ToolTip.Tip="{Binding LogsDirectoryText}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Classes="subtle" Content="打开" Padding="8,2" MinHeight="24"
                                Command="{Binding OpenFolderCommand}" CommandParameter="{Binding LogsDirectoryText}"
                                IsEnabled="{Binding CanOpenFolders}"/>
                      </Grid>
                    </StackPanel>
                  </Border>
                  <Border Classes="settingsRow last">
                    <StackPanel x:Name="AboutActions" Orientation="Horizontal" Spacing="8">
                      <Button Classes="subtle" Command="{Binding CopyDiagnosticsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="{DynamicResource Icon.Copy}" Width="13" Height="13"/>
                          <TextBlock Text="复制诊断摘要" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                      <Button Classes="subtle" Click="OnExportDiagnostics" ToolTip.Tip="导出系统版本和脱敏调用记录，不含凭据或会话正文">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="{DynamicResource Icon.Share}" Width="13" Height="13"/>
                          <TextBlock Text="导出完整诊断包" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                      <TextBlock Classes="meta" Foreground="{DynamicResource AppSuccessForeground}"
                                 VerticalAlignment="Center" IsVisible="{Binding HasCopyStatus}" Text="{Binding CopyStatus}"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <!-- 软件更新 -->
              <TextBlock Classes="settingsGroupHeader" Text="软件更新"/>
              <Border Classes="settingsGroup">
                <StackPanel>
                  <Border Classes="settingsRow">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="settingsRowTitle" Text="构建与更新"/>
                        <TextBlock Classes="settingsRowDesc" Text="{Binding UpdateStatusText}" TextWrapping="Wrap"/>
                        <TextBlock Classes="meta" Text="{Binding UpdateChannelText}"
                                   Foreground="{DynamicResource AppTextDim}"/>
                        <TextBlock Classes="meta" Text="{Binding CurrentBuildText, StringFormat='当前构建：{0}'}"
                                   Foreground="{DynamicResource AppTextDim}"/>
                      </StackPanel>
                      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="accent" Content="{Binding UpdateActionText}"
                                Command="{Binding CheckAndUpgradeCommand}"
                                IsEnabled="{Binding !IsCheckingUpdate}"
                                AutomationProperties.Name="部署或更新"/>
                      </StackPanel>

                      <!-- 发现更新时的更新说明与下载入口 -->
                      <StackPanel Grid.Row="1" Grid.ColumnSpan="2" IsVisible="{Binding HasUpdateAvailable}" Spacing="8" Margin="0,8,0,0">
                        <Border Background="{DynamicResource AppSubtleBackground}" CornerRadius="4" Padding="10">
                          <StackPanel Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="{Binding UpdateManifest.Version, StringFormat='新版本 v{0}'}"/>
                            <TextBlock Classes="caption" Text="{Binding UpdateManifest.ReleaseNotes}" TextWrapping="Wrap"/>
                            <TextBlock Classes="meta" Text="{Binding UpdateManifest.PolicyNotice}" Foreground="{DynamicResource AppTextDim}"/>
                          </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="subtle" Content="下载更新"
                                  Command="{Binding DownloadUpdateCommand}"
                                  IsVisible="{Binding !IsDownloadingUpdate}"
                                  IsEnabled="{Binding !CanApplyUpdate}"/>
                          <Button Classes="subtle" Content="取消下载"
                                  Command="{Binding CancelDownloadCommand}"
                                  IsVisible="{Binding IsDownloadingUpdate}"/>
                          <Button Classes="subtle" Content="立即安装并重启"
                                  Command="{Binding ApplyUpdateCommand}"
                                  IsVisible="{Binding CanApplyUpdate}"/>
                        </StackPanel>
                      </StackPanel>

                      <!-- 下载进度条 -->
                      <StackPanel Grid.Row="2" Grid.ColumnSpan="2" IsVisible="{Binding IsDownloadingUpdate}" Spacing="4" Margin="0,4,0,0">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgressPercent}" Height="6"/>
                        <TextBlock Classes="caption" Text="{Binding UpdateProgressText}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>

            </StackPanel>

            <!-- ═══ 「其他」收纳桶：右侧列小功能入口卡 ═══ -->
            <StackPanel IsVisible="{Binding ShowOtherHub}" Spacing="0">
              <ItemsControl ItemsSource="{Binding OtherHubItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingsCategoryViewModel">
                    <Button Classes="settingsRow clickable"
                            Command="{Binding $parent[ItemsControl].((vm:SettingsPageViewModel)DataContext).SelectCategoryCommand}"
                            CommandParameter="{Binding Id}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <views:SemanticIcon Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center"
                                            IconName="{Binding Icon}" CategoryColor="{Binding IconColor}"/>
                        <TextBlock Grid.Column="1" Classes="settingsRowTitle" Text="{Binding Title}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <PathIcon Grid.Column="2" Data="{DynamicResource Icon.ChevronRight}" Width="12" Height="12"
                                  VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}"/>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- ═══ 目录已登记、内容页尚未接线的分类（终端/文件管理/自动开发/用量）═══ -->
            <StackPanel IsVisible="{Binding ShowCategoryPlaceholder}" Spacing="6" Margin="12,20">
              <TextBlock Classes="subtitle" Text="该设置页尚未接线"/>
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="分类已在设置侧栏三级架构中登记，内容页由主控 M 统一接线。"/>
            </StackPanel>

            <!-- ═══ 在侧栏显示为一级分类：小功能页内的开关 ═══ -->
            <StackPanel IsVisible="{Binding ShowPinSection}" Spacing="0" Margin="0,20,0,0">
              <TextBlock Classes="settingsGroupHeader" Text="侧栏"/>
              <Border Classes="settingsRow">
                <Grid Classes="settingsControlRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                  <PathIcon Grid.Column="0" Data="{DynamicResource Icon.Pin}" Width="18" Height="18"
                            VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="settingsRowTitle" Text="显示为一级侧栏分类"/>
                    <TextBlock Classes="settingsRowDesc" TextWrapping="Wrap"
                               Text="把这个小功能放到设置侧栏的一级分类里；关闭后收纳进「其他」。"/>
                  </StackPanel>
                  <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinHeight="20"
                                IsChecked="{Binding CurrentCategoryIsPinned}"
                                Command="{Binding ToggleCurrentPinCommand}"
                                AutomationProperties.Name="显示为一级侧栏分类"/>
                </Grid>
              </Border>
            </StackPanel>

            <!-- ═══ 相关设置 ═══ -->
            <StackPanel IsVisible="{Binding HasRelatedSettings}" Spacing="0" Margin="0,20,0,0">
              <TextBlock Classes="settingsGroupHeader" Text="相关设置"/>
              <ItemsControl ItemsSource="{Binding RelatedLinks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="se:SettingsRelatedLink">
                    <Button Classes="settingsRow clickable"
                            Command="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).OpenRelatedCommand}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Title}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                          <TextBlock Classes="settingsRowTitle" Text="{Binding Title}"/>
                          <TextBlock Classes="settingsRowDesc" Text="{Binding Reason}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <PathIcon Grid.Column="1" Data="{DynamicResource Icon.ChevronRight}"
                                  Width="12" Height="12" VerticalAlignment="Center"
                                  Foreground="{DynamicResource AppTextSecondary}"/>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
