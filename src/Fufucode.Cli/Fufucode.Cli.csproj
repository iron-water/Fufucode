<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!--
    与 App 同步：自包含 Release 不裁剪（2026-10-25 决定，理由见 Fufucode.App.csproj 注释）。
    不裁剪后 App 与 CLI 各自发布的框架程序集是同一条完整运行时，共用发布目录不再需要
    "固定 root 防覆盖"的特殊约定。
  -->
  <ItemGroup>
    <ProjectReference Include="../Fufucode.Core/Fufucode.Core.csproj" />
  </ItemGroup>
</Project>
