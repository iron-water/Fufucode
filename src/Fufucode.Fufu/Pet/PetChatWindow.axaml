<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pet="clr-namespace:Fufucode.Fufu.Pet"
        x:Class="Fufucode.Fufu.Pet.PetChatWindow"
        Title="和 FUFU 聊天" Width="380" Height="480"
        MinWidth="300" MinHeight="260"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        Background="#CC1E1E24" TransparencyLevelHint="AcrylicBlur">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="10">
    <!-- 端点未配置横幅：真实状态，不伪造 AI 可用 -->
    <Border Name="NoEndpointBanner" Grid.Row="0" Background="#66332222" CornerRadius="6"
            Padding="8" Margin="0,0,0,8" IsVisible="False">
      <StackPanel>
        <TextBlock Text="FUFU 还没有配置模型端点" FontWeight="SemiBold" Foreground="#FFD0D0" />
        <TextBlock TextWrapping="Wrap" Foreground="#FFB0B0" FontSize="11"
                   Text="在数据目录的 settings.json 里写入 endpoint 后即可对话（见说明按钮）。" />
      </StackPanel>
    </Border>

    <!-- 审批条：会话内确认的真实门禁 -->
    <Border Name="ApprovalBar" Grid.Row="0" Background="#553A2A00" CornerRadius="6"
            Padding="8" Margin="0,0,0,8" IsVisible="False">
      <StackPanel Spacing="6">
        <TextBlock Text="FUFU 请求执行工具" FontWeight="SemiBold" Foreground="#FFD9A0" />
        <TextBlock Name="ApprovalText" TextWrapping="Wrap" Foreground="#FFC890" FontSize="11"
                   MaxHeight="80" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Name="ApproveButton" Content="允许" Padding="10,4" />
          <Button Name="DenyButton" Content="拒绝" Padding="10,4" />
        </StackPanel>
      </StackPanel>
    </Border>

    <ScrollViewer Name="MessageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl Name="Messages">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="pet:ChatLine">
            <Border CornerRadius="8" Padding="8" Margin="0,4" MaxWidth="290"
                    HorizontalAlignment="{Binding Alignment}">
              <Border.Background>
                <SolidColorBrush Color="{Binding BubbleColor}" />
              </Border.Background>
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#F0F0F0"
                         FontSize="12.5" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
      <TextBox Name="InputBox" PlaceholderText="对 FUFU 说点什么…（Enter 发送）"
               AcceptsReturn="False" VerticalContentAlignment="Center"
               Padding="8,6" Background="#2C2C34" Foreground="#F0F0F0" />
      <Button Name="SendButton" Grid.Column="1" Content="发送" Margin="8,0,0,0" Padding="12,6" />
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Name="StopButton" Content="停止任务" Padding="10,4" IsEnabled="False" />
    </StackPanel>
  </Grid>
</Window>
