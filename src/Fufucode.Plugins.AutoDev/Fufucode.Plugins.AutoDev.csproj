<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 与 Fufucode.App 同源迁移的 XAML：编译绑定 + Avalonia 库. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Fufucode.Core/Fufucode.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Fufucode.App/Abstractions/Fufucode.App.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- 视图模型基类与主程序集同一份源码：插件不引用 Fufucode.App.exe，宿主类型身份保持一致。 -->
    <Compile Include="../Shared/ViewModelBase.cs" Link="Shared/ViewModelBase.cs" />
    <InternalsVisibleTo Include="Fufucode.App" />
    <InternalsVisibleTo Include="Fufucode.App.Automation.Persistence.Tests" />
    <InternalsVisibleTo Include="Fufucode.App.Automation.V4.Tests" />
    <InternalsVisibleTo Include="Fufucode.App.Ui1.Tests" />
    <InternalsVisibleTo Include="Fufucode.App.Automation.SelfTests" />
  </ItemGroup>
</Project>
