<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!--
    后端插件：Core 不引用本工程。宿主已提供的程序集用 PrivateAssets 避免随插件重复分发；
    Fufucode.Claude（stream-json 适配器）是本插件的专属载荷，必须随插件发布。
  -->
  <ItemGroup>
    <ProjectReference Include="../Fufucode.Core/Fufucode.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Fufucode.App/Abstractions/Fufucode.App.Abstractions.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Fufucode.Claude/Fufucode.Claude.csproj" />
  </ItemGroup>
</Project>
