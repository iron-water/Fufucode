<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Fufucode.Plugins.InteractiveUI</AssemblyName>
    <RootNamespace>Fufucode.Plugins.InteractiveUI</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 扩展组件（chart / table）只在完整特性轨道参与编译；纯净轨不引用、不产出。 -->
  <PropertyGroup Condition="'$(EnableEnhancedPreview)' == 'true'">
    <DefineConstants>$(DefineConstants);ENHANCED_PREVIEW</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableEnhancedPreview)' == 'true'">
    <PackageReference Include="Avalonia.Controls.Charts" Version="12.3.1">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Controls.TreeDataGrid" Version="12.3.2">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 宿主已加载的程序集不复制进插件包。 -->
    <PackageReference Include="Avalonia" Version="12.1.3">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Fufucode.Core/Fufucode.Core.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
</Project>
