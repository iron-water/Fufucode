<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- Pi 后端插件：由插件市场按需安装。默认包不引用本工程，也不随 native 包发布。
       RPC 适配器内联在 Rpc/ 下，与 OMP/Claude/Codex/DSH 一样"一个后端一个插件工程"。 -->
  <ItemGroup>
    <ProjectReference Include="../Fufucode.Core/Fufucode.Core.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>
</Project>
