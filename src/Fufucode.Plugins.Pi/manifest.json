{
  "id": "backend.pi",
  "name": "Pi 后端",
  "version": "1.0.0",
  "entryAssembly": "Fufucode.Pi.dll",
  "packageType": "Fufucode.Plugins.Pi.PiBackendPluginPackage",
  "category": "Backend",
  "description": "Pi RPC 后端插件；FUMO 原生内核为默认后端，本插件按需安装。",
  "runtime": {
    "id": "pi",
    "required": true,
    "preferred": "system-node",
    "package": "Fufucode-Pi-Runtime.zip",
    "installCommand": "fufucode runtime install --from <zip|url> [--sha256 HEX]"
  }
}
