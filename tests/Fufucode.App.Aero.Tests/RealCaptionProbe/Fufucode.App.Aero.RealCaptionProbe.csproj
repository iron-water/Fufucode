<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Fufucode.App.Aero.RealCaptionProbe</AssemblyName>
    <RootNamespace>Fufucode.App.Aero.RealCaptionProbe</RootNamespace>
    <WebView2Version>1.0.4258.31</WebView2Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Fufucode.App/Fufucode.App.csproj" />
  </ItemGroup>
  <!-- 与 Fufucode.App / 主测试工程同一剥离方式：WebView2 传递的 WPF/WinForms 宿主程序集与 net10.0
       WindowsBase 冲突（MSB3277），本探针只用 Avalonia/Skia，按既有实践在 ResolveAssemblyReferences
       前按项标识移除引用，不用 NoWarn 掩盖。 -->
  <Target Name="StripUnusedWebView2ManagedRefs" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="$(NuGetPackageRoot)microsoft.web.webview2\$(WebView2Version)\buildTransitive\..\\lib_manual\net5.0-windows10.0.17763.0\Microsoft.Web.WebView2.Wpf.dll" />
      <Reference Remove="$(NuGetPackageRoot)microsoft.web.webview2\$(WebView2Version)\buildTransitive\..\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll" />
    </ItemGroup>
  </Target>
</Project>
