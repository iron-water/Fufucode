<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Fufucode.App.Automation.SelfTests</AssemblyName>
    <RootNamespace>Fufucode.App.SelfTest</RootNamespace>
    <!-- 独立的自动化自测组件；发布包不引用它。 -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Fufucode.App/Fufucode.App.csproj" />
    <ProjectReference Include="../../src/Fufucode.Plugins.AutoDev/Fufucode.Plugins.AutoDev.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
  </ItemGroup>
</Project>
