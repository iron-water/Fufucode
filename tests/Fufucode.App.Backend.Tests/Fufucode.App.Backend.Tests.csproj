<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Fufucode.App.Backend.Tests</AssemblyName>
    <RootNamespace>Fufucode.App.Backend.Tests</RootNamespace>
    <!-- 与 Fufucode.App 的 WebView2Version 保持一致：仅用于下面的传递引用剥离。 -->
    <WebView2Version>1.0.4258.31</WebView2Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Fufucode.App/Fufucode.App.csproj" />
    <ProjectReference Include="../../src/Fufucode.Plugins.BrowserUse/Fufucode.Plugins.BrowserUse.csproj" />
    <ProjectReference Include="../../src/Fufucode.Plugins.ComputerUse/Fufucode.Plugins.ComputerUse.csproj" />
    <ProjectReference Include="../../src/Fufucode.Plugins.AutoDev/Fufucode.Plugins.AutoDev.csproj" />
    <ProjectReference Include="../../src/Fufucode.Plugins.Subagents/Fufucode.Plugins.Subagents.csproj" />
    <ProjectReference Include="../../src/Fufucode.Plugins.AeroSkin/Fufucode.Plugins.AeroSkin.csproj" />
  </ItemGroup>
  <!-- 真实 seep MCP tools/list 录制清单：驱动 23 工具映射与门禁测试，避免硬编码工具名。 -->
  <ItemGroup>
    <None Include="Fixtures\seep-tools-list.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- 与 App 工程同样的剥离：只移除未使用的 WPF/WinForms 宿主引用，避免 MSB3277 版本冲突。 -->
  <Target Name="StripUnusedWebView2ManagedRefs" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="$(NuGetPackageRoot)microsoft.web.webview2\$(WebView2Version)\buildTransitive\..\\lib_manual\net5.0-windows10.0.17763.0\Microsoft.Web.WebView2.Wpf.dll" />
      <Reference Remove="$(NuGetPackageRoot)microsoft.web.webview2\$(WebView2Version)\buildTransitive\..\\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll" />
    </ItemGroup>
  </Target>
</Project>
