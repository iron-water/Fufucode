<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <Compile Include="../../src/Fufucode.App/Features/Graph/*.cs" Link="Graph/%(Filename)%(Extension)" />
    <Compile Include="../../src/Fufucode.App/Abstractions/Graph/GraphContracts.cs" Link="GraphContracts.cs" />
    <Compile Include="../../src/Fufucode.App/Abstractions/Graph/GraphOrganizationContracts.cs" Link="GraphOrganizationContracts.cs" />
  </ItemGroup>
</Project>
