<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Fufucode.App.Storage.Tests</AssemblyName>
    <RootNamespace>Fufucode.App.Storage.Tests</RootNamespace>
    <!-- 与 Fufucode.App 的 WebView2Version 保持一致：仅用于下面的传递引用剥离。 -->
    <WebView2Version>1.0.4258.31</WebView2Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Fufucode.App/Fufucode.App.csproj" />
  </ItemGroup>
  <!-- 同 tests/Fufucode.App.Library.Tests：Fufucode.App 通过 Microsoft.Web.WebView2 传递 WPF/WinForms
       宿主程序集，与 net10.0 的 WindowsBase 冲突（MSB3277）。存储测试不使用这两个宿主程序集，
       按 App 工程既有 StripUnusedWebView2ManagedRefs 的路径写法真正剥离引用。 -->
  <Target Name="StripUnusedWebView2ManagedRefs" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="$(NuGetPackageRoot)microsoft.web.webview2\$(WebView2Version)\buildTransitive\..\\lib_manual\net5.0-windows10.0.17763.0\Microsoft.Web.WebView2.Wpf.dll" />
      <Reference Remove="$(NuGetPackageRoot)microsoft.web.webview2\$(WebView2Version)\buildTransitive\..\\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll" />
    </ItemGroup>
  </Target>
</Project>
