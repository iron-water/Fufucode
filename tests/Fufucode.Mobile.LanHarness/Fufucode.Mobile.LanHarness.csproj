<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Fufucode.Mobile.LanHarness</AssemblyName>
    <RootNamespace>Fufucode.Mobile.LanHarness</RootNamespace>
    <WebView2Version>1.0.4258.31</WebView2Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Fufucode.App/Fufucode.App.csproj" />
    <ProjectReference Include="../../src/Fufucode.Plugins.RemoteControl/Fufucode.Plugins.RemoteControl.csproj" />
  </ItemGroup>
  <!-- 与 App 工程一致的剥离：移除未使用的 WPF/WinForms WebView2 引用，避免 MSB3277。 -->
  <Target Name="StripUnusedWebView2ManagedRefs" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="$(NuGetPackageRoot)microsoft.web.webview2\$(WebView2Version)\buildTransitive\..\lib_manual\net5.0-windows10.0.17763.0\Microsoft.Web.WebView2.Wpf.dll" />
      <Reference Remove="$(NuGetPackageRoot)microsoft.web.webview2\$(WebView2Version)\buildTransitive\..\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll" />
    </ItemGroup>
  </Target>
</Project>
